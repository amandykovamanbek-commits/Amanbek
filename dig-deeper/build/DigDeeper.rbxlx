  <Item class="ServerScriptService" referent="RBX000622">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="RBX000623">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="RBX000624">
        <Properties>
          <string name="Name">DataService</string>
          <ProtectedString name="Source"><![CDATA[-- Сохранение прогресса игроков (DataStore).
-- В Roblox Studio сохранения работают, только если включено:
-- Game Settings -> Security -> Enable Studio Access to API Services.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")

local DataService = {}

local STORE_NAME = "DigToCore_v1"
local AUTOSAVE_SECONDS = 120

local DEFAULT = {
	Cash = 0,
	Pickaxe = 1,
	Backpack = 1,
	Rebirths = 0,
	BestDepth = 0,
	TotalMined = 0,
	TotalEarned = 0,
	Inv = {},
	Lang = "",
	Potions = { Luck = 0, Speed = 0 },
	Daily = { Streak = 0, Last = 0 },
	Codes = {},
	Layers = {},
	CoreClaims = 0,
	SeenIntro = false,
	AutoMine = false,
	Receipts = {},
}

local store = nil
pcall(function()
	store = DataStoreService:GetDataStore(STORE_NAME)
end)

local profiles = {} -- [player] = data
local canSave = {} -- [player] = true, если загрузка прошла успешно
local warnedOffline = false

DataService.Offline = false -- true, если DataStore недоступен (например, Studio без доступа к API)

local function deepCopy(value)
	if type(value) ~= "table" then
		return value
	end
	local out = {}
	for k, v in pairs(value) do
		out[k] = deepCopy(v)
	end
	return out
end

-- Дополняет сохранённые данные новыми полями из DEFAULT (если игра обновилась)
local function reconcile(saved, template)
	local out = type(saved) == "table" and saved or {}
	for k, v in pairs(template) do
		if out[k] == nil then
			out[k] = deepCopy(v)
		elseif type(v) == "table" and type(out[k]) == "table" and next(v) ~= nil then
			out[k] = reconcile(out[k], v)
		end
	end
	return out
end

local function keyFor(player)
	return "p_" .. tostring(player.UserId)
end

function DataService.load(player)
	local data = nil
	local ok = false
	if store then
		for attempt = 1, 3 do
			local success, result = pcall(function()
				return store:GetAsync(keyFor(player))
			end)
			if success then
				data = result
				ok = true
				break
			end
			if attempt == 1 and not warnedOffline then
				warnedOffline = true
				warn("[Копай глубже] DataStore недоступен: " .. tostring(result)
					.. "\nВ Studio включи: Game Settings -> Security -> Enable Studio Access to API Services")
			end
			if attempt < 3 then
				task.wait(attempt)
			end
		end
	end
	if not ok then
		DataService.Offline = true
	end
	if not player.Parent then
		return nil
	end
	local profile = reconcile(data, DEFAULT)
	profiles[player] = profile
	canSave[player] = ok
	return profile
end

function DataService.get(player)
	return profiles[player]
end

function DataService.save(player)
	local profile = profiles[player]
	if not profile or not canSave[player] or not store then
		return false
	end
	local success, err = pcall(function()
		store:SetAsync(keyFor(player), profile)
	end)
	if not success then
		warn("[Копай глубже] Не удалось сохранить " .. player.Name .. ": " .. tostring(err))
	end
	return success
end

function DataService.release(player)
	DataService.save(player)
	profiles[player] = nil
	canSave[player] = nil
end

function DataService.init()
	-- автосохранение
	task.spawn(function()
		while true do
			task.wait(AUTOSAVE_SECONDS)
			for _, player in ipairs(Players:GetPlayers()) do
				if profiles[player] then
					task.spawn(DataService.save, player)
					task.wait(0.5)
				end
			end
		end
	end)

	-- сохранение при выключении сервера
	game:BindToClose(function()
		local pending = 0
		for _, player in ipairs(Players:GetPlayers()) do
			if profiles[player] then
				pending = pending + 1
				task.spawn(function()
					DataService.save(player)
					pending = pending - 1
				end)
			end
		end
		local started = os.clock()
		while pending > 0 and os.clock() - started < 25 do
			task.wait(0.2)
		end
	end)
end

return DataService
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX000625">
        <Properties>
          <string name="Name">LeaderboardService</string>
          <ProtectedString name="Source"><![CDATA[-- Большие доски лидеров на острове: «Топ глубины» и «Топ перерождений».
-- Работают через OrderedDataStore. В Studio без доступа к API показывают
-- игроков, которые сейчас на сервере.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Locale = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Locale"))
local Data = require(script.Parent.DataService)

local LeaderboardService = {}

local REFRESH_SECONDS = 75
local stores = {}
pcall(function()
	stores.Depth = DataStoreService:GetOrderedDataStore("TopDepth_v1")
	stores.Rebirths = DataStoreService:GetOrderedDataStore("TopRebirths_v1")
end)

local posted = {} -- [userId] = { Depth = n, Rebirths = n }
local names = {} -- [userId] = name
local storeWorks = true

local TITLES = {
	Depth = "🏆 ТОП ГЛУБИНЫ · TOP DEPTH",
	Rebirths = "🔄 ТОП РЕБЁРТОВ · TOP REBIRTHS",
}
local FIELD = { Depth = "BestDepth", Rebirths = "Rebirths" }
local MEDALS = { "🥇", "🥈", "🥉" }

local function nameOf(userId)
	if names[userId] then
		return names[userId]
	end
	local player = Players:GetPlayerByUserId(userId)
	if player then
		names[userId] = player.DisplayName
		return names[userId]
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	names[userId] = ok and name or ("#" .. tostring(userId))
	return names[userId]
end

local function postAll()
	if not storeWorks or not stores.Depth then
		return
	end
	for _, player in ipairs(Players:GetPlayers()) do
		local data = Data.get(player)
		if data then
			local prev = posted[player.UserId] or {}
			for kind, field in pairs(FIELD) do
				local value = data[field] or 0
				if value > 0 and prev[kind] ~= value then
					local ok = pcall(function()
						stores[kind]:SetAsync(tostring(player.UserId), value)
					end)
					if ok then
						prev[kind] = value
					else
						storeWorks = false
					end
				end
			end
			posted[player.UserId] = prev
		end
	end
end

local function fetch(kind)
	if not storeWorks or not stores[kind] then
		return nil
	end
	local ok, pages = pcall(function()
		return stores[kind]:GetSortedAsync(false, 10)
	end)
	if not ok then
		storeWorks = false
		return nil
	end
	local rows = {}
	for _, entry in ipairs(pages:GetCurrentPage()) do
		table.insert(rows, { Name = nameOf(tonumber(entry.key) or 0), Value = entry.value })
	end
	return rows
end

local function fromOnline(kind)
	local rows = {}
	for _, player in ipairs(Players:GetPlayers()) do
		local data = Data.get(player)
		if data then
			table.insert(rows, { Name = player.DisplayName, Value = data[FIELD[kind]] or 0 })
		end
	end
	table.sort(rows, function(a, b)
		return a.Value > b.Value
	end)
	while #rows > 10 do
		table.remove(rows)
	end
	return rows
end

local function label(parent, text, size, pos, color, align, font)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Size = size
	l.Position = pos
	l.Font = font or Enum.Font.GothamBlack
	l.Text = text
	l.TextScaled = true
	l.TextColor3 = color or Color3.new(1, 1, 1)
	l.TextXAlignment = align or Enum.TextXAlignment.Left
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Color = Color3.new(0, 0, 0)
	stroke.Parent = l
	l.Parent = parent
	return l
end

local function render(board, kind, rows)
	local gui = board:FindFirstChild("BoardGui")
	if not gui then
		gui = Instance.new("SurfaceGui")
		gui.Name = "BoardGui"
		gui.Face = Enum.NormalId.Front
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 22
		gui.LightInfluence = 0
		gui.Parent = board
	end
	gui:ClearAllChildren()

	local bg = Instance.new("Frame")
	bg.Size = UDim2.fromScale(1, 1)
	bg.BackgroundColor3 = Color3.fromRGB(30, 30, 44)
	bg.BorderSizePixel = 0
	local grad = Instance.new("UIGradient")
	grad.Rotation = 90
	grad.Color = ColorSequence.new(Color3.fromRGB(52, 54, 80), Color3.fromRGB(22, 22, 34))
	grad.Parent = bg
	bg.Parent = gui

	local header = Instance.new("Frame")
	header.Size = UDim2.fromScale(1, 0.17)
	header.BackgroundColor3 = kind == "Depth" and Color3.fromRGB(255, 160, 40) or Color3.fromRGB(170, 90, 255)
	header.BorderSizePixel = 0
	header.Parent = bg
	label(header, TITLES[kind], UDim2.fromScale(0.94, 0.8), UDim2.fromScale(0.03, 0.1), nil, Enum.TextXAlignment.Center)

	for i = 1, 10 do
		local row = rows[i]
		local y = 0.19 + (i - 1) * 0.08
		local medal = MEDALS[i] or ("#" .. i)
		local name = row and row.Name or "—"
		local value = ""
		if row then
			value = kind == "Depth" and (Locale.full(row.Value) .. " m") or Locale.full(row.Value)
		end
		local color = i == 1 and Color3.fromRGB(255, 214, 64) or (i == 2 and Color3.fromRGB(220, 226, 240) or (i == 3 and Color3.fromRGB(255, 170, 110) or Color3.new(1, 1, 1)))
		label(bg, medal, UDim2.fromScale(0.12, 0.07), UDim2.fromScale(0.03, y), color, Enum.TextXAlignment.Center)
		label(bg, name, UDim2.fromScale(0.52, 0.065), UDim2.fromScale(0.17, y + 0.003), color)
		label(bg, value, UDim2.fromScale(0.27, 0.065), UDim2.fromScale(0.7, y + 0.003), Color3.fromRGB(184, 255, 61), Enum.TextXAlignment.Right)
	end
end

local function boards()
	local list = {}
	local map = workspace:FindFirstChild("Map")
	if not map then
		return list
	end
	for _, item in ipairs(map:GetDescendants()) do
		if item:IsA("StringValue") and item.Name == "Board" and item.Parent:IsA("BasePart") then
			table.insert(list, { Kind = item.Value, Part = item.Parent })
		end
	end
	return list
end

local function refresh()
	postAll()
	local cache = {}
	for _, board in ipairs(boards()) do
		local kind = board.Kind
		if FIELD[kind] then
			if not cache[kind] then
				cache[kind] = fetch(kind) or fromOnline(kind)
			end
			render(board.Part, kind, cache[kind])
		end
	end
end

function LeaderboardService.init()
	task.spawn(function()
		task.wait(5)
		while true do
			local ok, err = pcall(refresh)
			if not ok then
				warn("[Копай глубже] Доски лидеров: " .. tostring(err))
			end
			task.wait(REFRESH_SECONDS)
		end
	end)
end

return LeaderboardService
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="Script" referent="RBX000626">
        <Properties>
          <string name="Name">Main</string>
          <ProtectedString name="Source"><![CDATA[-- Копай глубже / Dig to the Core — запуск сервера.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Remotes = require(script.Parent.Remotes)
local Data = require(script.Parent.DataService)
local Mine = require(script.Parent.MineService)
local Purchases = require(script.Parent.PurchaseService)
local PlayerService = require(script.Parent.PlayerService)
local Leaderboards = require(script.Parent.LeaderboardService)

print(("[Копай глубже] Сервер запускается, версия %s"):format(Config.Version))

Data.init()
Mine.init()
Purchases.init(PlayerService)
PlayerService.init()
Leaderboards.init()

-- Обновление шахты по таймеру, с предупреждением и землетрясением у игроков
task.spawn(function()
	local period = math.max(2, Config.MineResetMinutes) * 60
	while true do
		Mine.NextResetAt = os.time() + period
		task.wait(period - 30)
		Remotes.Fx:FireAllClients("ResetWarn", 30)
		task.wait(30)
		Remotes.Fx:FireAllClients("Resetting")
		task.wait(1.2)
		PlayerService.surfaceAll()
		task.wait(0.3)
		Mine.reset()
		Remotes.Fx:FireAllClients("ResetDone")
	end
end)

print("[Копай глубже] Сервер готов!")
]]></ProtectedString>
          <token name="RunContext">0</token>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX000627">
        <Properties>
          <string name="Name">MineService</string>
          <ProtectedString name="Source"><![CDATA[-- Шахта из блоков 16 x 16 x 1000.
-- Блоки создаются «лениво»: существуют только видимые блоки (открытая поверхность
-- шахты). Когда блок ломают — появляются его соседи. Поэтому шахта огромная,
-- а деталей в игре мало и сервер не тормозит.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Remotes = require(script.Parent.Remotes)

local MineService = {}

local BS = Config.BlockSize
local W = Config.MineWidth
local TOP = Config.SurfaceY
local HALF = W * BS / 2
local ORIGIN = -HALF + BS / 2 -- центр блока с индексом 0

local blocks = {} -- [key] = Part
local mined = {} -- [key] = true
local folder = nil
local deepest = 0

MineService.NextResetAt = 0

local function key(x, d, z)
	return x .. "," .. d .. "," .. z
end

local function inBounds(x, d, z)
	return x >= 0 and x < W and z >= 0 and z < W and d >= 0 and d < Config.MaxDepth
end

function MineService.blockCenter(x, d, z)
	return Vector3.new(ORIGIN + x * BS, TOP - BS / 2 - d * BS, ORIGIN + z * BS)
end

-- Небольшая «шумовая» вариация цвета, чтобы стены не были одноцветными
local function shade(color, x, d, z)
	local n = math.sin(x * 12.9898 + d * 78.233 + z * 37.719) * 43758.5453
	n = n - math.floor(n)
	local f = 0.9 + n * 0.16
	return Color3.new(math.min(1, color.R * f), math.min(1, color.G * f), math.min(1, color.B * f))
end

local SIDE_SURFACES = { "FrontSurface", "BackSurface", "LeftSurface", "RightSurface" }

local function spawnBlock(x, d, z)
	if not inBounds(x, d, z) then
		return nil
	end
	local k = key(x, d, z)
	if mined[k] then
		return nil
	end
	if blocks[k] then
		return blocks[k]
	end
	local layer = Config.LayerForDepth(d)
	local rare = math.random() < Config.BaseRareChance
	local ore = rare and layer.Rare or layer.Common

	local part = Instance.new("Part")
	part.Name = "Block"
	part.Anchored = true
	part.Size = Vector3.new(BS, BS, BS)
	part.Position = MineService.blockCenter(x, d, z)
	part.CastShadow = d < 4
	if rare then
		part.Color = ore.Color
		part.Material = ore.Glow and Enum.Material.Neon or Enum.Material.SmoothPlastic
		part.Reflectance = ore.Glow and 0 or 0.15
		part.TopSurface = Enum.SurfaceType.Smooth
		part.BottomSurface = Enum.SurfaceType.Smooth
	else
		part.Color = shade(layer.Color, x, d, z)
		part.Material = layer.Material
		if layer.Studs then
			part.TopSurface = Enum.SurfaceType.Studs
			part.BottomSurface = Enum.SurfaceType.Inlet
			for _, side in ipairs(SIDE_SURFACES) do
				part[side] = Enum.SurfaceType.Inlet
			end
		else
			part.TopSurface = Enum.SurfaceType.Smooth
			part.BottomSurface = Enum.SurfaceType.Smooth
		end
	end
	part:SetAttribute("X", x)
	part:SetAttribute("D", d)
	part:SetAttribute("Z", z)
	part:SetAttribute("Hp", layer.Hp)
	part:SetAttribute("MaxHp", layer.Hp)
	part:SetAttribute("Ore", ore.Id)
	part:SetAttribute("Rare", rare)
	part.Parent = folder
	blocks[k] = part
	return part
end

local function revealNeighbors(x, d, z)
	spawnBlock(x + 1, d, z)
	spawnBlock(x - 1, d, z)
	spawnBlock(x, d, z + 1)
	spawnBlock(x, d, z - 1)
	spawnBlock(x, d + 1, z)
	spawnBlock(x, d - 1, z)
end

local function generateTop()
	for x = 0, W - 1 do
		for z = 0, W - 1 do
			spawnBlock(x, 0, z)
		end
	end
end

function MineService.folder()
	return folder
end

function MineService.deepest()
	return deepest
end

-- Ломает блок (после проверок на сервере). Возвращает информацию о блоке.
function MineService.breakBlock(part)
	if not part or part.Parent ~= folder then
		return nil
	end
	local x, d, z = part:GetAttribute("X"), part:GetAttribute("D"), part:GetAttribute("Z")
	local k = key(x, d, z)
	if blocks[k] ~= part then
		return nil
	end
	blocks[k] = nil
	mined[k] = true
	local pos, color = part.Position, part.Color
	part:Destroy()
	revealNeighbors(x, d, z)
	if d > deepest then
		deepest = d
	end
	Remotes.Fx:FireAllClients("Break", pos, color)
	return { X = x, D = d, Z = z, Position = pos, Color = color }
end

-- Вырезает пустую ячейку без награды (для лифта)
local function carve(x, d, z)
	if not inBounds(x, d, z) then
		return
	end
	local k = key(x, d, z)
	if mined[k] then
		return
	end
	local part = blocks[k]
	if part then
		blocks[k] = nil
		part:Destroy()
	end
	mined[k] = true
	revealNeighbors(x, d, z)
end

-- Готовит комнату для лифта на глубине d и возвращает CFrame, куда ставить игрока
function MineService.prepareChamber(d)
	d = math.clamp(math.floor(d), 1, Config.MaxDepth - 2)
	local cx, cz = Config.ElevatorColumn.X, Config.ElevatorColumn.Z
	for dx = -1, 1 do
		for dz = -1, 1 do
			carve(cx + dx, d, cz + dz)
		end
	end
	carve(cx, d - 1, cz)
	spawnBlock(cx, d + 1, cz) -- пол
	local floorTop = TOP - (d + 1) * BS
	local pos = MineService.blockCenter(cx, d, cz)
	return CFrame.new(pos.X, floorTop + 3.2, pos.Z)
end

-- Полное обновление шахты (все блоки создаются заново)
function MineService.reset()
	if folder then
		folder:ClearAllChildren()
	end
	blocks = {}
	mined = {}
	deepest = 0
	generateTop()
end

-- Если в файле игры нет карты (например, при запуске через Rojo без карты) —
-- строим простой остров, чтобы игра всё равно работала.
local function ensureFallbackMap()
	if workspace:FindFirstChild("Map") then
		return
	end
	warn("[Копай глубже] Карта Map не найдена — строю простой запасной остров")
	local map = Instance.new("Model")
	map.Name = "Map"
	local function slab(name, size, pos, color)
		local p = Instance.new("Part")
		p.Name = name
		p.Anchored = true
		p.Size = size
		p.Position = pos
		p.Color = color
		p.TopSurface = Enum.SurfaceType.Studs
		p.Parent = map
		return p
	end
	local green = Color3.fromRGB(98, 214, 58)
	local y = TOP - 1
	slab("Ground", Vector3.new(400, 2, 152), Vector3.new(0, y, 124), green)
	slab("Ground", Vector3.new(400, 2, 152), Vector3.new(0, y, -124), green)
	slab("Ground", Vector3.new(152, 2, 96), Vector3.new(-124, y, 0), green)
	slab("Ground", Vector3.new(152, 2, 96), Vector3.new(124, y, 0), green)
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "Spawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(12, 1, 12)
	spawn.Position = Config.SpawnPosition - Vector3.new(0, 3.5, 0)
	spawn.Duration = 0
	spawn.Parent = map
	local pads = Instance.new("Folder")
	pads.Name = "Pads"
	pads.Parent = map
	local pad = Instance.new("Part")
	pad.Name = "Pad"
	pad.Anchored = true
	pad.CanCollide = false
	pad.Shape = Enum.PartType.Cylinder
	pad.Size = Vector3.new(0.4, Config.PadRadius * 2, Config.PadRadius * 2)
	pad.CFrame = CFrame.new(-70, TOP + 0.2, -60) * CFrame.Angles(0, 0, math.rad(90))
	pad.Color = Config.Pads.Sell.Color
	pad.Material = Enum.Material.Neon
	pad.Transparency = 0.3
	local kind = Instance.new("StringValue")
	kind.Name = "PadKind"
	kind.Value = "Sell"
	kind.Parent = pad
	pad.Parent = pads
	map.Parent = workspace
end

function MineService.init()
	ensureFallbackMap()
	local container = workspace:FindFirstChild("Mine")
	if not container then
		container = Instance.new("Folder")
		container.Name = "Mine"
		container.Parent = workspace
	end
	folder = container:FindFirstChild("Blocks")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Blocks"
		folder.Parent = container
	end
	generateTop()
end

return MineService
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX000628">
        <Properties>
          <string name="Name">PlayerService</string>
          <ProtectedString name="Source"><![CDATA[-- Игроки: загрузка, копание, продажа, магазин, перерождение, лифт,
-- ежедневные награды, коды, кирка в руках, таблица лидеров над игроками.
-- Все проверки делаются на сервере — клиент только просит.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local PhysicsService = game:GetService("PhysicsService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Economy = require(Shared:WaitForChild("Economy"))
local Locale = require(Shared:WaitForChild("Locale"))
local Remotes = require(script.Parent.Remotes)
local Data = require(script.Parent.DataService)
local Mine = require(script.Parent.MineService)
local Purchases = require(script.Parent.PurchaseService)

local PlayerService = {}

local sessions = {} -- [player] = сессия
local pads = {} -- { { Kind = "Sell", Part = part } }
local PLAYER_GROUP = "Players"

---------------------------------------------------------------------
-- Вспомогательные
---------------------------------------------------------------------
local function fx(player, kind, ...)
	Remotes.Fx:FireClient(player, kind, ...)
end

local function toast(player, key, ...)
	local s = sessions[player]
	if not s then
		return
	end
	local now = os.clock()
	if s.toasts[key] and now - s.toasts[key] < 1.5 then
		return
	end
	s.toasts[key] = now
	fx(player, "Toast", key, ...)
end

local function passesOf(player)
	return Purchases.passes(player)
end

local function potionActive(data, name)
	return (data.Potions[name] or 0) > os.time()
end

local function markDirty(player)
	local s = sessions[player]
	if s then
		s.dirty = true
	end
end
PlayerService.markDirty = markDirty

local function dailyStatus(data)
	local now = os.time()
	local last = data.Daily.Last or 0
	local cooldown = Config.DailyCooldownHours * 3600
	local canClaim = now - last >= cooldown
	local streak = data.Daily.Streak or 0
	if last > 0 and now - last > Config.DailyStreakHours * 3600 then
		streak = 0
	end
	local nextDay = (streak % #Config.Daily) + 1
	return canClaim, math.max(0, cooldown - (now - last)), nextDay, streak
end

local function buildState(player)
	local data = Data.get(player)
	local passes = passesOf(player)
	local canClaim, nextIn, nextDay, streak = dailyStatus(data)
	local passCopy = {}
	for _, pass in ipairs(Config.GamePasses) do
		passCopy[pass.Key] = passes[pass.Key] == true
	end
	return {
		Cash = data.Cash,
		Pickaxe = data.Pickaxe,
		Backpack = data.Backpack,
		Rebirths = data.Rebirths,
		BestDepth = data.BestDepth,
		TotalMined = data.TotalMined,
		Inv = data.Inv,
		InvCount = Economy.inventoryCount(data.Inv),
		Capacity = Economy.capacity(data.Backpack, passes),
		Lang = data.Lang,
		Passes = passCopy,
		Potions = {
			Luck = math.max(0, (data.Potions.Luck or 0) - os.time()),
			Speed = math.max(0, (data.Potions.Speed or 0) - os.time()),
		},
		Cooldown = Economy.swingCooldown(data.Pickaxe, passes, potionActive(data, "Speed")),
		Mult = Economy.cashMultiplier(data.Rebirths, passes),
		Daily = { CanClaim = canClaim, NextIn = nextIn, Day = nextDay, Streak = streak },
		Layers = data.Layers,
		SeenIntro = data.SeenIntro,
		AutoMine = data.AutoMine and passes.AutoMine == true,
		MineResetIn = math.max(0, Mine.NextResetAt - os.time()),
		Offline = Data.Offline,
	}
end

local function updateLeaderstats(player)
	local data = Data.get(player)
	local stats = player:FindFirstChild("leaderstats")
	if not data or not stats then
		return
	end
	stats.Depth.Value = data.BestDepth
	stats.Cash.Value = "$" .. Locale.short(data.Cash)
	stats.Rebirths.Value = data.Rebirths
end

local function pushState(player)
	local s = sessions[player]
	if not s or not Data.get(player) then
		return
	end
	s.dirty = false
	updateLeaderstats(player)
	Remotes.State:FireClient(player, buildState(player))
end

local function rootPart(player)
	local char = player.Character
	return char and char:FindFirstChild("HumanoidRootPart")
end

local function teleport(player, cf)
	local char = player.Character
	local root = rootPart(player)
	if not char or not root then
		return
	end
	char:PivotTo(cf)
	root.AssemblyLinearVelocity = Vector3.zero
end

local function surfaceCFrame()
	local spawn = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("Spawn", true)
	local base = spawn and spawn.Position + Vector3.new(0, 4, 0) or Config.SpawnPosition
	local offset = Vector3.new(math.random(-4, 4), 0, math.random(-4, 4))
	-- смотрим в сторону шахты
	return CFrame.lookAt(base + offset, Vector3.new(0, base.Y, 0))
end

local function nearPad(player, kind)
	local root = rootPart(player)
	if not root then
		return false
	end
	for _, pad in ipairs(pads) do
		if pad.Kind == kind then
			local delta = root.Position - pad.Part.Position
			local flat = Vector3.new(delta.X, 0, delta.Z).Magnitude
			if flat <= Config.PadRadius + 5 and math.abs(delta.Y) < 12 then
				return true
			end
		end
	end
	return false
end

---------------------------------------------------------------------
-- Кирка в руках (собирается из деталей)
---------------------------------------------------------------------
local function buildPickaxe(index)
	local cfg = Config.Pickaxes[index] or Config.Pickaxes[1]
	local tool = Instance.new("Tool")
	tool.Name = "Pickaxe"
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool.ToolTip = cfg.Name.en
	tool.Grip = CFrame.new(0, -1.25, 0)
	tool:SetAttribute("Tier", index)

	local function piece(name, size, color, material)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.Color = color
		p.Material = material
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Massless = true
		p.CastShadow = false
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		return p
	end

	local headMaterial = cfg.Glow and Enum.Material.Neon or Enum.Material.SmoothPlastic
	local handle = piece("Handle", Vector3.new(0.34, 4.2, 0.34), Color3.fromRGB(122, 78, 42), Enum.Material.Wood)
	handle.Parent = tool

	local head = piece("Head", Vector3.new(0.5, 0.62, 2.6), cfg.Head, headMaterial)
	head.CFrame = handle.CFrame * CFrame.new(0, 1.85, 0)
	head.Parent = tool

	local tipA = piece("TipA", Vector3.new(0.42, 0.42, 1.1), cfg.Head, headMaterial)
	tipA.CFrame = head.CFrame * CFrame.new(0, -0.2, 1.55) * CFrame.Angles(math.rad(-28), 0, 0)
	tipA.Parent = tool

	local tipB = piece("TipB", Vector3.new(0.42, 0.42, 1.1), cfg.Head, headMaterial)
	tipB.CFrame = head.CFrame * CFrame.new(0, -0.2, -1.55) * CFrame.Angles(math.rad(28), 0, 0)
	tipB.Parent = tool

	local band = piece("Band", Vector3.new(0.46, 0.5, 0.46), Color3.fromRGB(60, 40, 24), Enum.Material.SmoothPlastic)
	band.CFrame = handle.CFrame * CFrame.new(0, 1.35, 0)
	band.Parent = tool

	for _, p in ipairs({ head, tipA, tipB, band }) do
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = handle
		weld.Part1 = p
		weld.Parent = p
	end

	-- фонарик на кирке: светит под землёй
	local light = Instance.new("PointLight")
	light.Name = "Lamp"
	light.Range = 22
	light.Brightness = 1.4
	light.Color = cfg.Glow and cfg.Head or Color3.fromRGB(255, 236, 200)
	light.Shadows = false
	light.Parent = head

	if cfg.Glow then
		local sparkle = Instance.new("ParticleEmitter")
		sparkle.Name = "Sparkle"
		sparkle.Color = ColorSequence.new(cfg.Head)
		sparkle.LightEmission = 1
		sparkle.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.25), NumberSequenceKeypoint.new(1, 0) })
		sparkle.Lifetime = NumberRange.new(0.4, 0.8)
		sparkle.Rate = 12
		sparkle.Speed = NumberRange.new(0.5, 1.5)
		sparkle.SpreadAngle = Vector2.new(180, 180)
		sparkle.Parent = head
	end
	return tool
end

local function giveTool(player, equip)
	local data = Data.get(player)
	if not data then
		return
	end
	local function clear(container)
		if not container then
			return
		end
		for _, item in ipairs(container:GetChildren()) do
			if item:IsA("Tool") and item.Name == "Pickaxe" then
				item:Destroy()
			end
		end
	end
	clear(player:FindFirstChild("Backpack"))
	clear(player:FindFirstChild("StarterGear"))
	clear(player.Character)

	local gear = player:FindFirstChild("StarterGear")
	if gear then
		buildPickaxe(data.Pickaxe).Parent = gear
	end
	local backpack = player:FindFirstChild("Backpack")
	if backpack then
		local tool = buildPickaxe(data.Pickaxe)
		tool.Parent = backpack
		if equip then
			local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
			if humanoid then
				humanoid:EquipTool(tool)
			end
		end
	end
end

---------------------------------------------------------------------
-- VIP-табличка над головой
---------------------------------------------------------------------
local function applyVipTag(player)
	if not Purchases.owns(player, "VIP") then
		return
	end
	local char = player.Character
	local head = char and char:FindFirstChild("Head")
	if not head or head:FindFirstChild("VipTag") then
		return
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "VipTag"
	gui.Size = UDim2.fromOffset(140, 36)
	gui.StudsOffset = Vector3.new(0, 2.4, 0)
	gui.MaxDistance = 80
	gui.LightInfluence = 0
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.GothamBlack
	label.Text = "👑 VIP"
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(255, 214, 64)
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2.5
	stroke.Color = Color3.new(0, 0, 0)
	stroke.Parent = label
	label.Parent = gui
	gui.Parent = head
end

---------------------------------------------------------------------
-- Персонаж
---------------------------------------------------------------------
local function setupCharacter(player, char)
	local humanoid = char:WaitForChild("Humanoid", 10)
	if not humanoid then
		return
	end
	humanoid.WalkSpeed = Config.WalkSpeed
	for _, part in ipairs(char:GetDescendants()) do
		if part:IsA("BasePart") then
			part.CollisionGroup = PLAYER_GROUP
		end
	end
	char.DescendantAdded:Connect(function(part)
		if part:IsA("BasePart") then
			part.CollisionGroup = PLAYER_GROUP
		end
	end)
	task.wait(0.2)
	if Data.get(player) then
		giveTool(player, true)
		applyVipTag(player)
	end
end

---------------------------------------------------------------------
-- Продажа
---------------------------------------------------------------------
local function sell(player, viaPad)
	local data = Data.get(player)
	if not data then
		return
	end
	local count = Economy.inventoryCount(data.Inv)
	if count == 0 then
		if not viaPad then
			toast(player, "NothingToSell")
		end
		return
	end
	if not viaPad and not Purchases.owns(player, "SellAnywhere") and not nearPad(player, "Sell") then
		toast(player, "GoToSell")
		return
	end
	local value = math.floor(Economy.inventoryValue(data.Inv) * Economy.cashMultiplier(data.Rebirths, passesOf(player)))
	data.Cash = data.Cash + value
	data.TotalEarned = data.TotalEarned + value
	data.Inv = {}
	fx(player, "Sold", value, count)
	markDirty(player)
end

---------------------------------------------------------------------
-- Копание
---------------------------------------------------------------------
local function onMine(player, block)
	local data = Data.get(player)
	local s = sessions[player]
	if not data or not s then
		return
	end
	local folder = Mine.folder()
	if typeof(block) ~= "Instance" or not block:IsA("BasePart") or block.Parent ~= folder then
		return
	end
	local passes = passesOf(player)
	local now = os.clock()
	local cooldown = Economy.swingCooldown(data.Pickaxe, passes, potionActive(data, "Speed"))
	if now - s.lastSwing < cooldown * 0.8 then
		return
	end
	s.lastSwing = now

	local root = rootPart(player)
	if not root or (root.Position - block.Position).Magnitude > Config.Reach + 8 then
		return
	end

	local depth = block:GetAttribute("D") or 0
	local layer, layerIndex = Config.LayerForDepth(depth)
	local pick = Config.Pickaxes[data.Pickaxe]
	if pick.Power < layer.MinPower then
		toast(player, "NeedPickaxe", Config.PickaxeForPower(layer.MinPower))
		return
	end

	local hp = (block:GetAttribute("Hp") or 1) - pick.Power
	if hp > 0 then
		block:SetAttribute("Hp", hp)
		return
	end

	local oreId = block:GetAttribute("Ore") or layer.Common.Id
	if not block:GetAttribute("Rare") then
		local luck = Economy.luck(passes, potionActive(data, "Luck"))
		if luck > 1 and math.random() < Config.BaseRareChance * (luck - 1) then
			oreId = layer.Rare.Id
		end
	end

	local info = Mine.breakBlock(block)
	if not info then
		return
	end
	data.TotalMined = data.TotalMined + 1

	local count = Economy.inventoryCount(data.Inv)
	if count < Economy.capacity(data.Backpack, passes) then
		data.Inv[oreId] = (data.Inv[oreId] or 0) + 1
		fx(player, "Ore", oreId, info.Position)
	else
		toast(player, "BackpackFull")
	end

	local meters = depth + 1
	if meters > data.BestDepth then
		data.BestDepth = meters
	end

	if not data.Layers[layer.Id] then
		data.Layers[layer.Id] = true
		local reward = layer.Reward * (1 + data.Rebirths)
		data.Cash = data.Cash + reward
		fx(player, "Layer", layerIndex, reward)
	end

	if depth >= Config.MaxDepth - 1 and data.CoreClaims < data.Rebirths + 1 then
		data.CoreClaims = data.Rebirths + 1
		local reward = Config.CoreBottomReward * (1 + data.Rebirths)
		data.Cash = data.Cash + reward
		fx(player, "Core", reward)
	end

	markDirty(player)
end

---------------------------------------------------------------------
-- Действия игрока (кнопки интерфейса)
---------------------------------------------------------------------
local Actions = {}

local function cooldownOk(player, name, seconds)
	local s = sessions[player]
	local now = os.clock()
	if s.actions[name] and now - s.actions[name] < seconds then
		return false
	end
	s.actions[name] = now
	return true
end

local function validIndex(value, list)
	return type(value) == "number" and value == math.floor(value) and value >= 1 and value <= #list
end

function Actions.Ready(player)
	pushState(player)
end

function Actions.Sell(player)
	sell(player, false)
end

function Actions.BuyPickaxe(player, index)
	local data = Data.get(player)
	if not validIndex(index, Config.Pickaxes) or index <= data.Pickaxe then
		return
	end
	local price = Config.Pickaxes[index].Price
	if data.Cash < price then
		toast(player, "NotEnough")
		return
	end
	data.Cash = data.Cash - price
	data.Pickaxe = index
	giveTool(player, true)
	fx(player, "Bought", "Pickaxe", index)
	markDirty(player)
end

function Actions.BuyBackpack(player, index)
	local data = Data.get(player)
	if not validIndex(index, Config.Backpacks) or index <= data.Backpack then
		return
	end
	local price = Config.Backpacks[index].Price
	if data.Cash < price then
		toast(player, "NotEnough")
		return
	end
	data.Cash = data.Cash - price
	data.Backpack = index
	fx(player, "Bought", "Backpack", index)
	markDirty(player)
end

function Actions.Rebirth(player)
	local data = Data.get(player)
	if not cooldownOk(player, "Rebirth", 2) then
		return
	end
	local cost = Economy.rebirthCost(data.Rebirths)
	if data.Cash < cost then
		toast(player, "RebirthNotEnough", Locale.short(cost))
		return
	end
	data.Cash = 0
	data.Pickaxe = 1
	data.Backpack = 1
	data.Inv = {}
	data.Rebirths = data.Rebirths + 1
	giveTool(player, true)
	teleport(player, surfaceCFrame())
	fx(player, "Rebirth", data.Rebirths, Economy.rebirthMultiplier(data.Rebirths))
	markDirty(player)
	task.spawn(Data.save, player)
end

function Actions.Surface(player)
	if not cooldownOk(player, "Surface", 1.5) then
		return
	end
	teleport(player, surfaceCFrame())
end

function Actions.Elevator(player, index)
	local data = Data.get(player)
	if not validIndex(index, Config.Layers) or not cooldownOk(player, "Elevator", 2) then
		return
	end
	local layer = Config.Layers[index]
	if not data.Layers[layer.Id] then
		toast(player, "LayerLocked")
		return
	end
	if Config.Pickaxes[data.Pickaxe].Power < layer.MinPower then
		toast(player, "LayerTooHard", Config.PickaxeForPower(layer.MinPower))
		return
	end
	local cf = Mine.prepareChamber(layer.From + 1)
	teleport(player, cf)
	fx(player, "Teleport", index)
end

local function applyPotion(data, name)
	local current = data.Potions[name] or 0
	data.Potions[name] = math.max(os.time(), current) + Config.PotionSeconds
end

function Actions.ClaimDaily(player)
	local data = Data.get(player)
	if not cooldownOk(player, "Daily", 1) then
		return
	end
	local canClaim, nextIn = dailyStatus(data)
	if not canClaim then
		toast(player, "DailyWait", math.floor(nextIn))
		return
	end
	local now = os.time()
	if data.Daily.Last > 0 and now - data.Daily.Last > Config.DailyStreakHours * 3600 then
		data.Daily.Streak = 0
	end
	data.Daily.Streak = data.Daily.Streak + 1
	data.Daily.Last = now
	local day = ((data.Daily.Streak - 1) % #Config.Daily) + 1
	local reward = Economy.dailyReward(day, data.Rebirths, data.Pickaxe)
	data.Cash = data.Cash + reward.Cash
	if reward.Potion then
		applyPotion(data, reward.Potion)
	end
	fx(player, "Daily", day, reward.Cash, reward.Potion)
	markDirty(player)
end

function Actions.Redeem(player, code)
	local data = Data.get(player)
	if type(code) ~= "string" or #code > 40 or not cooldownOk(player, "Redeem", 1) then
		return
	end
	code = string.upper((code:gsub("%s", "")))
	local entry = Config.Codes[code]
	if not entry then
		toast(player, "CodeBad")
		return
	end
	if data.Codes[code] then
		toast(player, "CodeUsed")
		return
	end
	data.Codes[code] = true
	if entry.Cash then
		data.Cash = data.Cash + entry.Cash
	end
	if entry.Potion then
		applyPotion(data, entry.Potion)
	end
	fx(player, "Code", entry.Cash or 0, entry.Potion)
	markDirty(player)
end

function Actions.SetLang(player, lang)
	local data = Data.get(player)
	if lang ~= "ru" and lang ~= "en" then
		return
	end
	data.Lang = lang
	markDirty(player)
end

function Actions.SetAuto(player, on)
	local data = Data.get(player)
	if type(on) ~= "boolean" then
		return
	end
	data.AutoMine = on and Purchases.owns(player, "AutoMine")
	markDirty(player)
end

function Actions.IntroSeen(player)
	local data = Data.get(player)
	data.SeenIntro = true
end

---------------------------------------------------------------------
-- Покупки за Robux (вызывается из PurchaseService)
---------------------------------------------------------------------
local function deepTeleport(player)
	local data = Data.get(player)
	local power = Config.Pickaxes[data.Pickaxe].Power
	local maxDepth = 0
	for _, layer in ipairs(Config.Layers) do
		if layer.MinPower <= power then
			maxDepth = layer.To - 3
		end
	end
	local target = math.min(data.BestDepth - 1, maxDepth)
	if target < 2 then
		teleport(player, surfaceCFrame())
		return
	end
	teleport(player, Mine.prepareChamber(target))
end

function PlayerService.grantProduct(player, product)
	local data = Data.get(player)
	if not data then
		return false
	end
	if product.Cash then
		data.Cash = data.Cash + Economy.cashPackAmount(product.Cash, data.Rebirths)
	end
	if product.Potion then
		applyPotion(data, product.Potion)
	end
	if product.Key == "DeepTeleport" then
		deepTeleport(player)
	end
	fx(player, "Thanks", product.Key)
	markDirty(player)
	return true
end

function PlayerService.onPassBought(player, key)
	if key == "VIP" then
		applyVipTag(player)
	end
	fx(player, "Thanks", key)
	markDirty(player)
end

---------------------------------------------------------------------
-- Подключение игроков
---------------------------------------------------------------------
local function onPlayerAdded(player)
	sessions[player] = { lastSwing = 0, toasts = {}, actions = {}, dirty = false, padTouch = 0 }

	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	local depth = Instance.new("IntValue")
	depth.Name = "Depth"
	depth.Parent = stats
	local cash = Instance.new("StringValue")
	cash.Name = "Cash"
	cash.Value = "$0"
	cash.Parent = stats
	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Rebirths"
	rebirths.Parent = stats
	stats.Parent = player

	local data = Data.load(player)
	if not data then
		return
	end
	if data.Lang ~= "ru" and data.Lang ~= "en" then
		local locale = string.lower(player.LocaleId or "")
		data.Lang = string.sub(locale, 1, 2) == "ru" and "ru" or "en"
	end
	data.Layers.Dirt = true
	Purchases.load(player)

	player.CharacterAdded:Connect(function(char)
		setupCharacter(player, char)
	end)
	if player.Character then
		task.spawn(setupCharacter, player, player.Character)
	end
	pushState(player)
end

local function onPlayerRemoving(player)
	Data.release(player)
	sessions[player] = nil
end

function PlayerService.surfaceAll()
	for _, player in ipairs(Players:GetPlayers()) do
		local root = rootPart(player)
		if root and root.Position.Y < Config.SurfaceY - 2 then
			teleport(player, surfaceCFrame())
		end
	end
end

local function collectPads()
	pads = {}
	local map = workspace:FindFirstChild("Map")
	if not map then
		return
	end
	for _, item in ipairs(map:GetDescendants()) do
		if item:IsA("StringValue") and item.Name == "PadKind" and item.Parent:IsA("BasePart") then
			table.insert(pads, { Kind = item.Value, Part = item.Parent })
		end
	end
	-- автопродажа: встал в красный круг — руда продана
	for _, pad in ipairs(pads) do
		if pad.Kind == "Sell" then
			pad.Part.CanTouch = true
			pad.Part.Touched:Connect(function(hit)
				local player = Players:GetPlayerFromCharacter(hit.Parent)
				local s = player and sessions[player]
				if not s then
					return
				end
				local now = os.clock()
				if now - s.padTouch < 1.2 then
					return
				end
				s.padTouch = now
				sell(player, true)
			end)
		end
	end
end

function PlayerService.init()
	pcall(function()
		PhysicsService:RegisterCollisionGroup(PLAYER_GROUP)
	end)
	pcall(function()
		PhysicsService:CollisionGroupSetCollidable(PLAYER_GROUP, PLAYER_GROUP, false)
	end)

	collectPads()

	Remotes.Mine.OnServerEvent:Connect(onMine)
	Remotes.Action.OnServerEvent:Connect(function(player, name, ...)
		if type(name) ~= "string" then
			return
		end
		local handler = Actions[name]
		local s = sessions[player]
		if not handler or not s or not Data.get(player) then
			return
		end
		-- ограничение частоты запросов
		local now = os.clock()
		s.windowStart = s.windowStart or now
		s.windowCount = (s.windowCount or 0) + 1
		if now - s.windowStart > 1 then
			s.windowStart = now
			s.windowCount = 1
		end
		if s.windowCount > 25 then
			return
		end
		handler(player, ...)
	end)

	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(onPlayerAdded, player)
	end

	-- отправка изменений клиентам (не чаще ~7 раз в секунду)
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc = acc + dt
		if acc < 0.15 then
			return
		end
		acc = 0
		for player, s in pairs(sessions) do
			if s.dirty then
				pushState(player)
			end
		end
	end)

	-- раз в 10 секунд обновляем таймеры зелий / награды
	task.spawn(function()
		while true do
			task.wait(10)
			for player in pairs(sessions) do
				markDirty(player)
			end
		end
	end)
end

return PlayerService
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX000629">
        <Properties>
          <string name="Name">PurchaseService</string>
          <ProtectedString name="Source"><![CDATA[-- Покупки за Robux: геймпассы (навсегда) и разовые покупки (Developer Products).
-- Id геймпассов и покупок задаются в Config.luau.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Data = require(script.Parent.DataService)

local PurchaseService = {}

local owned = {} -- [player] = { [passKey] = true/false }
local PlayerService = nil -- подключается в init (чтобы не было круговой зависимости)

local function studioFree()
	return RunService:IsStudio() and Config.StudioFreePasses
end

function PurchaseService.passes(player)
	local t = owned[player]
	if not t then
		t = {}
		owned[player] = t
	end
	return t
end

function PurchaseService.owns(player, key)
	return PurchaseService.passes(player)[key] == true
end

local function checkPass(player, pass)
	if studioFree() then
		return true
	end
	if not pass.Id or pass.Id == 0 then
		return false
	end
	local ok, has = pcall(function()
		return MarketplaceService:UserOwnsGamePassAsync(player.UserId, pass.Id)
	end)
	return ok and has == true
end

function PurchaseService.load(player)
	local t = PurchaseService.passes(player)
	for _, pass in ipairs(Config.GamePasses) do
		t[pass.Key] = checkPass(player, pass)
	end
end

local function productById(productId)
	for _, product in ipairs(Config.Products) do
		if product.Id ~= 0 and product.Id == productId then
			return product
		end
	end
	return nil
end

local function processReceipt(info)
	local player = Players:GetPlayerByUserId(info.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local data = Data.get(player)
	if not data or not PlayerService then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	-- защита от двойного начисления
	for _, id in ipairs(data.Receipts) do
		if id == info.PurchaseId then
			return Enum.ProductPurchaseDecision.PurchaseGranted
		end
	end
	local product = productById(info.ProductId)
	if not product then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local ok, granted = pcall(PlayerService.grantProduct, player, product)
	if not ok or not granted then
		warn("[Копай глубже] Не удалось выдать покупку: " .. tostring(granted))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	table.insert(data.Receipts, info.PurchaseId)
	while #data.Receipts > 30 do
		table.remove(data.Receipts, 1)
	end
	Data.save(player)
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function PurchaseService.init(playerService)
	PlayerService = playerService

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if not purchased then
			return
		end
		for _, pass in ipairs(Config.GamePasses) do
			if pass.Id ~= 0 and pass.Id == passId then
				PurchaseService.passes(player)[pass.Key] = true
				PlayerService.onPassBought(player, pass.Key)
			end
		end
	end)

	MarketplaceService.ProcessReceipt = processReceipt

	Players.PlayerRemoving:Connect(function(player)
		owned[player] = nil
	end)
end

return PurchaseService
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX00062A">
        <Properties>
          <string name="Name">Remotes</string>
          <ProtectedString name="Source"><![CDATA[-- Создаёт каналы связи сервер <-> клиент в ReplicatedStorage.Remotes
--   Mine   (клиент -> сервер): удар по блоку
--   Action (клиент -> сервер): покупки, продажа, лифт, награды, коды, язык…
--   State  (сервер -> клиент): полное состояние игрока
--   Fx     (сервер -> клиент): события для эффектов и катсцен

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = {}

local folder = ReplicatedStorage:FindFirstChild("Remotes")
if not folder then
	folder = Instance.new("Folder")
	folder.Name = "Remotes"
end

for _, name in ipairs({ "Mine", "Action", "State", "Fx" }) do
	local remote = folder:FindFirstChild(name)
	if not remote then
		remote = Instance.new("RemoteEvent")
		remote.Name = name
		remote.Parent = folder
	end
	Remotes[name] = remote
end

folder.Parent = ReplicatedStorage

return Remotes
]]></ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="RBX00062B">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">90</float>
      <float name="CharacterWalkSpeed">20</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="RBX00062C">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="RBX00062D">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="RBX00062E">
          <Properties>
            <string name="Name">Ambience</string>
            <ProtectedString name="Source"><![CDATA[-- Атмосфера: красивое дневное небо на поверхности, а под землёй — своё
-- освещение, туман и цвет для каждого слоя + летающая пыль вокруг игрока.

local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Economy = require(Shared:WaitForChild("Economy"))

local Ambience = {}

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local atmosphere, bloom, color, sunrays
local dustEmitter
local currentZone = nil

local SURFACE = {
	Ambient = Color3.fromRGB(105, 105, 118),
	OutdoorAmbient = Color3.fromRGB(150, 152, 165),
	Brightness = 2.6,
	FogColor = Color3.fromRGB(199, 222, 255),
	Density = 0.26,
	Haze = 1.2,
	Tint = Color3.fromRGB(255, 252, 245),
	Saturation = 0.18,
	Bloom = 0.5,
}

local function ensure(className, name)
	local inst = Lighting:FindFirstChild(name)
	if not inst then
		inst = Instance.new(className)
		inst.Name = name
		inst.Parent = Lighting
	end
	return inst
end

local function tween(obj, props, time)
	TweenService:Create(obj, TweenInfo.new(time or 1.2, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), props):Play()
end

local function applySurface(time)
	tween(Lighting, { Ambient = SURFACE.Ambient, OutdoorAmbient = SURFACE.OutdoorAmbient, Brightness = SURFACE.Brightness, ExposureCompensation = 0.1 }, time)
	tween(atmosphere, { Density = SURFACE.Density, Color = SURFACE.FogColor, Haze = SURFACE.Haze, Glare = 0.3 }, time)
	tween(color, { TintColor = SURFACE.Tint, Saturation = SURFACE.Saturation, Contrast = 0.06, Brightness = 0.02 }, time)
	tween(bloom, { Intensity = SURFACE.Bloom, Threshold = 1.2 }, time)
	sunrays.Enabled = true
	if dustEmitter then
		dustEmitter.Enabled = false
	end
end

local function applyLayer(layer, time)
	tween(Lighting, { Ambient = layer.Ambient, OutdoorAmbient = layer.Ambient:Lerp(Color3.new(0, 0, 0), 0.35), Brightness = 0.35, ExposureCompensation = 0.25 }, time)
	tween(atmosphere, { Density = 0.48, Color = layer.Fog, Haze = 2.2, Glare = 0 }, time)
	tween(color, { TintColor = layer.Tint, Saturation = 0.25, Contrast = 0.12, Brightness = 0.03 }, time)
	tween(bloom, { Intensity = 1.1, Threshold = 0.9 }, time)
	sunrays.Enabled = false
	if dustEmitter then
		dustEmitter.Color = ColorSequence.new(layer.Common.Color:Lerp(Color3.new(1, 1, 1), 0.4))
		dustEmitter.Enabled = true
	end
end

-- Пыль летает в объёме вокруг игрока (невидимая коробка следует за ним)
local dustVolume = nil
local function makeDust()
	dustVolume = Instance.new("Part")
	dustVolume.Name = "DustVolume"
	dustVolume.Anchored = true
	dustVolume.CanCollide = false
	dustVolume.CanQuery = false
	dustVolume.CanTouch = false
	dustVolume.Transparency = 1
	dustVolume.Size = Vector3.new(34, 18, 34)
	dustVolume.Parent = workspace
	dustEmitter = Instance.new("ParticleEmitter")
	dustEmitter.Name = "AmbientDust"
	dustEmitter.Enabled = false
	dustEmitter.Rate = 22
	dustEmitter.Lifetime = NumberRange.new(2.5, 4.5)
	dustEmitter.Speed = NumberRange.new(0.3, 1.2)
	dustEmitter.SpreadAngle = Vector2.new(180, 180)
	dustEmitter.LightEmission = 0.6
	dustEmitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.2, 0.18), NumberSequenceKeypoint.new(1, 0) })
	dustEmitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.3, 0.3), NumberSequenceKeypoint.new(1, 1) })
	dustEmitter.Shape = Enum.ParticleEmitterShape.Box
	dustEmitter.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
	dustEmitter.Parent = dustVolume
	RunService.Heartbeat:Connect(function()
		local char = player.Character
		local rootPart = char and char:FindFirstChild("HumanoidRootPart")
		if rootPart then
			dustVolume.Position = rootPart.Position
		end
	end)
end

function Ambience.init()
	Lighting.ClockTime = 14.3
	Lighting.GeographicLatitude = 28
	Lighting.GlobalShadows = true
	Lighting.EnvironmentDiffuseScale = 1
	Lighting.EnvironmentSpecularScale = 0.6
	pcall(function()
		Lighting.ShadowSoftness = 0.25
	end)

	atmosphere = workspace:FindFirstChildOfClass("Atmosphere") or Lighting:FindFirstChildOfClass("Atmosphere")
	if not atmosphere then
		atmosphere = Instance.new("Atmosphere")
		atmosphere.Parent = Lighting
	end
	atmosphere.Offset = 0.25
	atmosphere.Decay = Color3.fromRGB(106, 112, 125)
	bloom = ensure("BloomEffect", "DigBloom")
	bloom.Size = 28
	color = ensure("ColorCorrectionEffect", "DigColor")
	sunrays = ensure("SunRaysEffect", "DigSunRays")
	sunrays.Intensity = 0.06
	sunrays.Spread = 0.6
	if not Lighting:FindFirstChildOfClass("Sky") then
		local sky = Instance.new("Sky")
		sky.Name = "DigSky"
		sky.SunAngularSize = 14
		sky.Parent = Lighting
	end
	applySurface(0)

	makeDust()

	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc = acc + dt
		if acc < 0.25 then
			return
		end
		acc = 0
		local y = camera.CFrame.Position.Y
		local zone
		if y > Config.SurfaceY - 4 then
			zone = 0
		else
			local _, index = Config.LayerForDepth(Economy.depthAtY(y))
			zone = index
		end
		if zone ~= currentZone then
			currentZone = zone
			if zone == 0 then
				applySurface(1)
			else
				applyLayer(Config.Layers[zone], 1.4)
			end
		end
	end)
end

return Ambience
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00062F">
          <Properties>
            <string name="Name">Cutscenes</string>
            <ProtectedString name="Source"><![CDATA[-- Катсцены: интро при первом входе, «Новый слой!», перерождение, ядро планеты,
-- обновление шахты. Камера летает по заранее заданным траекториям,
-- сверху и снизу — «кинорамка», большие надписи с анимацией.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Locale = require(Shared:WaitForChild("Locale"))
local UIKit = require(script.Parent.UIKit)
local State = require(script.Parent.State)
local Sound = require(script.Parent.Sound)
local Effects = require(script.Parent.Effects)

local Cutscenes = {}

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local gui, root
local topBar, bottomBar, skipArea
local active = false
local skipRequested = false
local queue = {}
local running = false
local texts = {}
local saved = nil
local onActiveChanged = nil

local function t(key, ...)
	return State.t(key, ...)
end

local function ease(a)
	return TweenService:GetValue(math.clamp(a, 0, 1), Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
end

local function easeIn(a)
	return TweenService:GetValue(math.clamp(a, 0, 1), Enum.EasingStyle.Quad, Enum.EasingDirection.In)
end

local function character()
	local char = player.Character
	return char, char and char:FindFirstChildOfClass("Humanoid"), char and char:FindFirstChild("HumanoidRootPart")
end

function Cutscenes.isActive()
	return active
end

function Cutscenes.init(callback)
	onActiveChanged = callback
	gui, root = UIKit.screen("CutsceneGui", 40)
	topBar = UIKit.frame({ Name = "TopBar", Color = UIKit.Black, Size = UDim2.new(3, 0, 0, 92), Position = UDim2.new(0.5, 0, 0, -400), AnchorPoint = Vector2.new(0.5, 1), ZIndex = 30, Parent = root })
	bottomBar = UIKit.frame({ Name = "BottomBar", Color = UIKit.Black, Size = UDim2.new(3, 0, 0, 92), Position = UDim2.new(0.5, 0, 1, 400), AnchorPoint = Vector2.new(0.5, 0), ZIndex = 30, Parent = root })
	skipArea = Instance.new("TextButton")
	skipArea.Name = "SkipArea"
	skipArea.Text = ""
	skipArea.BackgroundTransparency = 1
	skipArea.Size = UDim2.fromScale(3, 3)
	skipArea.Position = UDim2.fromScale(0.5, 0.5)
	skipArea.AnchorPoint = Vector2.new(0.5, 0.5)
	skipArea.Visible = false
	skipArea.ZIndex = 5
	skipArea.Parent = root
	skipArea.Activated:Connect(function()
		skipRequested = true
	end)
end

local function letterbox(on, time)
	time = time or 0.45
	if on then
		UIKit.tween(topBar, time, { Position = UDim2.new(0.5, 0, 0, 92) })
		UIKit.tween(bottomBar, time, { Position = UDim2.new(0.5, 0, 1, -92) })
	else
		UIKit.tween(topBar, time, { Position = UDim2.new(0.5, 0, 0, -400) })
		UIKit.tween(bottomBar, time, { Position = UDim2.new(0.5, 0, 1, 400) })
	end
end

local function freeze(on)
	local _, humanoid, rootPart = character()
	if on then
		if humanoid then
			saved = { walk = humanoid.WalkSpeed, jump = humanoid.JumpPower, height = humanoid.JumpHeight }
			humanoid.WalkSpeed = 0
			humanoid.JumpPower = 0
			humanoid.JumpHeight = 0
		end
		if rootPart then
			rootPart.Anchored = true
		end
	else
		if humanoid and saved then
			humanoid.WalkSpeed = saved.walk > 0 and saved.walk or Config.WalkSpeed
			humanoid.JumpPower = saved.jump > 0 and saved.jump or 50
			humanoid.JumpHeight = saved.height > 0 and saved.height or 7.2
		end
		if rootPart then
			rootPart.Anchored = false
		end
	end
end

local function clearTexts()
	for _, label in ipairs(texts) do
		if label.Parent then
			label:Destroy()
		end
	end
	texts = {}
end

local function begin(tapToSkip)
	active = true
	skipRequested = false
	if onActiveChanged then
		onActiveChanged(true)
	end
	camera.CameraType = Enum.CameraType.Scriptable
	freeze(true)
	letterbox(true)
	skipArea.Visible = tapToSkip == true
end

local function finish()
	skipArea.Visible = false
	letterbox(false)
	for _, label in ipairs(texts) do
		if label.Parent then
			UIKit.tween(label, 0.3, { TextTransparency = 1 })
			local stroke = label:FindFirstChildOfClass("UIStroke")
			if stroke then
				UIKit.tween(stroke, 0.3, { Transparency = 1 })
			end
		end
	end
	task.delay(0.35, clearTexts)
	freeze(false)
	camera.CameraType = Enum.CameraType.Custom
	local _, humanoid = character()
	if humanoid then
		camera.CameraSubject = humanoid
	end
	active = false
	if onActiveChanged then
		onActiveChanged(false)
	end
end

-- Двигает камеру: fn(alpha 0..1) -> CFrame
local function runCamera(duration, fn)
	local start = os.clock()
	while true do
		local a = (os.clock() - start) / duration
		if a >= 1 or skipRequested then
			camera.CFrame = fn(math.min(a, 1))
			return
		end
		camera.CFrame = fn(a)
		RunService.RenderStepped:Wait()
	end
end

local function waitFor(seconds)
	local start = os.clock()
	while os.clock() - start < seconds and not skipRequested do
		task.wait()
	end
end

-- Большая надпись с «прыжком»
local function bigText(text, color, yScale, height, gradientPair)
	local label = UIKit.text({
		Text = text,
		Color = gradientPair and UIKit.White or (color or UIKit.White),
		Size = UDim2.new(0.92, 0, 0, height),
		Position = UDim2.fromScale(0.5, yScale),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Stroke = math.max(3, math.floor(height / 16)),
		MaxSize = height,
		ZIndex = 20,
		Parent = root,
	})
	if gradientPair then
		UIKit.gradient(label, gradientPair, 90)
	end
	label.Rotation = -7
	UIKit.tween(label, 0.55, { Rotation = 0 }, Enum.EasingStyle.Back)
	UIKit.pop(label, 0.25, 0.5)
	table.insert(texts, label)
	return label
end

-- Искорки-звёздочки вокруг надписи
local function sparkles(count, color)
	for _ = 1, count do
		local s = UIKit.text({
			Text = "✦",
			Color = color or UIKit.Yellow,
			Size = UDim2.fromOffset(34, 34),
			Position = UDim2.new(0.5 + (math.random() - 0.5) * 0.7, 0, 0.42 + (math.random() - 0.5) * 0.35, 0),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Stroke = 2,
			ZIndex = 19,
			Parent = root,
		})
		UIKit.pop(s, 0, 0.4)
		UIKit.tween(s, 1.4, { Rotation = math.random(-180, 180), Position = s.Position - UDim2.fromOffset(0, 40) })
		task.delay(0.9, function()
			UIKit.tween(s, 0.4, { TextTransparency = 1 })
		end)
		Debris:AddItem(s, 1.5)
	end
end

local function enqueue(fn)
	table.insert(queue, fn)
	if running then
		return
	end
	running = true
	task.spawn(function()
		while #queue > 0 do
			local job = table.remove(queue, 1)
			local ok, err = pcall(job)
			if not ok then
				warn("[Копай глубже] Катсцена: " .. tostring(err))
				if active then
					pcall(finish)
				end
			end
			task.wait(0.15)
		end
		running = false
	end)
end

-- Сколько свободного места над точкой (чтобы камера не влезала в блоки)
local function freeAbove(pos, maxHeight)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local char = player.Character
	params.FilterDescendantsInstances = char and { char } or {}
	local hit = workspace:Raycast(pos, Vector3.new(0, maxHeight, 0), params)
	if hit then
		return math.max(4, hit.Distance - 1.5)
	end
	return maxHeight
end

---------------------------------------------------------------------
-- ИНТРО (первый вход в игру)
---------------------------------------------------------------------
function Cutscenes.intro()
	enqueue(function()
		begin(false)
		local S = Config.SurfaceY
		local center = Vector3.new(0, S, 0)
		local black = UIKit.frame({ Color = UIKit.Black, Size = UDim2.fromScale(3, 3), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 35, Parent = root })
		UIKit.tween(black, 1.2, { BackgroundTransparency = 1 })
		Debris:AddItem(black, 1.3)

		local skip = UIKit.button({ Text = t("Skip"), Colors = UIKit.C.Gray, Size = UDim2.fromOffset(200, 48), Position = UDim2.new(1, -24, 0, 104), AnchorPoint = Vector2.new(1, 0), MaxSize = 20, ZIndex = 40, OnClick = function()
			skipRequested = true
		end, Parent = root })

		-- Кадр 1: облёт острова, название игры
		task.delay(0.5, function()
			if skipRequested then
				return
			end
			bigText(t("IntroTitle1"), UIKit.White, 0.27, 84)
			Sound.play("Reward", 0.5, 0.8)
			task.wait(0.35)
			if skipRequested then
				return
			end
			bigText(t("IntroTitle2"), nil, 0.43, 150, { Color3.fromRGB(255, 227, 107), Color3.fromRGB(255, 138, 30) })
			Sound.play("Reward", 0.5, 1.1)
			task.wait(0.6)
			if skipRequested then
				return
			end
			bigText(t("IntroTag"), UIKit.White, 0.6, 38)
		end)
		runCamera(4.4, function(a)
			local e = ease(a)
			local ang = math.rad(-160 + 70 * e)
			local r = 250 - 55 * e
			local h = 125 - 30 * e
			local pos = center + Vector3.new(math.sin(ang) * r, h, math.cos(ang) * r)
			return CFrame.lookAt(pos, center + Vector3.new(0, -12, 0))
		end)

		-- Кадр 2: ныряем в шахту + слои мелькают
		if not skipRequested then
			for _, label in ipairs(texts) do
				UIKit.tween(label, 0.3, { TextTransparency = 1 })
				local stroke = label:FindFirstChildOfClass("UIStroke")
				if stroke then
					UIKit.tween(stroke, 0.3, { Transparency = 1 })
				end
			end
			task.spawn(function()
				task.wait(0.5)
				for _, layer in ipairs(Config.Layers) do
					if skipRequested then
						return
					end
					Effects.flash(layer.Color, 0.35, 0.55)
					local chip = bigText(layer.Emoji .. " " .. string.upper(State.name(layer.Name)), nil, 0.5, 70, { layer.Color:Lerp(Color3.new(1, 1, 1), 0.55), layer.Color })
					Sound.play("Hit", 0.4, 0.7 + 0.1 * #texts)
					task.wait(0.33)
					UIKit.tween(chip, 0.15, { TextTransparency = 1 })
					local stroke = chip:FindFirstChildOfClass("UIStroke")
					if stroke then
						UIKit.tween(stroke, 0.15, { Transparency = 1 })
					end
				end
			end)
			local from = CFrame.lookAt(center + Vector3.new(-70, 80, -70), center + Vector3.new(0, -30, 0))
			local to = CFrame.lookAt(center + Vector3.new(0, 3, -1), center + Vector3.new(0, -90, 0.6))
			runCamera(3, function(a)
				return from:Lerp(to, easeIn(a))
			end)
		end

		-- Кадр 3: к игроку, цель игры и кнопка «Играть»
		Effects.flash(UIKit.White, 0.5, 0)
		local _, _, rootPart = character()
		local target = rootPart and rootPart.Position or Config.SpawnPosition
		local look = rootPart and rootPart.CFrame.LookVector or Vector3.new(0, 0, 1)
		local endCF = CFrame.lookAt(target - look * 15 + Vector3.new(0, 6.5, 0), target + Vector3.new(0, 1.5, 0))
		if not skipRequested then
			local startCF = CFrame.lookAt(target + Vector3.new(36, 55, -36), target)
			local goal = bigText(t("IntroGoal"), nil, 0.3, 96, { Color3.fromRGB(255, 240, 150), Color3.fromRGB(255, 120, 30) })
			goal.Name = "Goal"
			sparkles(14)
			local played = false
			local play = UIKit.button({ Text = t("Play"), Colors = UIKit.C.Green, Size = UDim2.fromOffset(320, 92), Position = UDim2.fromScale(0.5, 0.7), AnchorPoint = Vector2.new(0.5, 0.5), MaxSize = 50, StrokeThickness = 4, Corner = 22, ZIndex = 40, OnClick = function()
				played = true
			end, Parent = root })
			UIKit.pop(play, 0.3, 0.5)
			task.spawn(function()
				local scale = play:FindFirstChild("PopScale")
				while play.Parent and scale do
					UIKit.tween(scale, 0.5, { Scale = 1.07 }, Enum.EasingStyle.Sine)
					task.wait(0.5)
					UIKit.tween(scale, 0.5, { Scale = 1 }, Enum.EasingStyle.Sine)
					task.wait(0.5)
				end
			end)
			runCamera(2.6, function(a)
				return startCF:Lerp(endCF, ease(a))
			end)
			local started = os.clock()
			while not played and not skipRequested and os.clock() - started < 12 do
				task.wait()
			end
			play:Destroy()
		end
		camera.CFrame = endCF
		skip:Destroy()
		Remotes.Action:FireServer("IntroSeen")
		finish()
	end)
end

---------------------------------------------------------------------
-- НОВЫЙ СЛОЙ
---------------------------------------------------------------------
function Cutscenes.layer(index, reward)
	enqueue(function()
		local layer = Config.Layers[index]
		local _, _, rootPart = character()
		if not layer or not rootPart then
			return
		end
		begin(true)
		Effects.flash(layer.Color, 0.7, 0.15)
		Effects.shake(0.6, 0.4)
		Sound.play("Reward", 0.6, 1)
		local center = rootPart.Position
		local startCF = camera.CFrame
		local height = freeAbove(center, 26)
		bigText(t("NewLayer"), UIKit.Yellow, 0.27, 66)
		task.delay(0.25, function()
			bigText(layer.Emoji .. " " .. string.upper(State.name(layer.Name)), nil, 0.44, 124, { layer.Color:Lerp(Color3.new(1, 1, 1), 0.6), layer.Color })
			sparkles(12, layer.Color:Lerp(Color3.new(1, 1, 1), 0.4))
			Sound.play("Coin", 0.5, 1.3)
		end)
		task.delay(0.6, function()
			if reward and reward > 0 then
				bigText(t("LayerReward", tostring(layer.From), Locale.short(reward)), UIKit.Cash, 0.62, 40)
			else
				bigText(t("LayerDepth", tostring(layer.From)), UIKit.White, 0.62, 40)
			end
		end)
		runCamera(3.4, function(a)
			local e = ease(a)
			local ang = math.rad(200 * e)
			local top = CFrame.lookAt(center + Vector3.new(math.sin(ang) * 0.6, height, math.cos(ang) * 0.6), center)
			if a < 0.3 then
				return startCF:Lerp(top, ease(a / 0.3))
			end
			return top
		end)
		waitFor(0.4)
		finish()
	end)
end

---------------------------------------------------------------------
-- ПЕРЕРОЖДЕНИЕ
---------------------------------------------------------------------
function Cutscenes.rebirth(count, multiplier)
	enqueue(function()
		begin(true)
		Effects.flash(Color3.fromRGB(190, 110, 255), 0.9, 0)
		Sound.play("Reward", 0.6, 0.7)
		task.wait(0.2)
		local _, _, rootPart = character()
		local center = rootPart and rootPart.Position or Config.SpawnPosition
		bigText(t("RebirthCut", tostring(count)), nil, 0.34, 100, { Color3.fromRGB(255, 190, 255), Color3.fromRGB(150, 70, 255) })
		task.delay(0.4, function()
			bigText(t("RebirthCutSub", tostring(multiplier)), UIKit.Cash, 0.55, 54)
			Effects.confetti(80, 2.6)
			Sound.play("Coin", 0.5, 1.2)
		end)
		runCamera(3.6, function(a)
			local e = ease(a)
			local ang = math.rad(-30 + 300 * e)
			local r = 10 + 26 * e
			local h = 4 + 30 * e
			return CFrame.lookAt(center + Vector3.new(math.sin(ang) * r, h, math.cos(ang) * r), center + Vector3.new(0, 2, 0))
		end)
		waitFor(0.3)
		finish()
	end)
end

---------------------------------------------------------------------
-- ЯДРО ПЛАНЕТЫ (дно шахты)
---------------------------------------------------------------------
function Cutscenes.core(reward)
	enqueue(function()
		local _, _, rootPart = character()
		if not rootPart then
			return
		end
		begin(true)
		Effects.flash(Color3.fromRGB(255, 180, 80), 1, 0)
		Effects.shake(1.2, 1.2)
		Sound.play("Reward", 0.7, 0.6)
		local center = rootPart.Position
		local height = freeAbove(center, 180)
		bigText(t("CoreTitle"), nil, 0.32, 92, { Color3.fromRGB(255, 245, 160), Color3.fromRGB(255, 90, 20) })
		task.delay(0.5, function()
			bigText(t("CoreSub", Locale.short(reward or 0)), UIKit.Cash, 0.52, 40)
			Effects.confetti(120, 3.2)
		end)
		runCamera(4.2, function(a)
			local e = easeIn(a)
			local h = 5 + (height - 5) * e
			local ang = math.rad(90 * a)
			return CFrame.lookAt(center + Vector3.new(math.sin(ang) * 0.5, h, math.cos(ang) * 0.5), center)
		end)
		waitFor(0.6)
		finish()
	end)
end

---------------------------------------------------------------------
-- ОБНОВЛЕНИЕ ШАХТЫ
---------------------------------------------------------------------
function Cutscenes.resetWarn()
	Effects.shake(0.35, 1.5)
end

local unfade = nil
function Cutscenes.resetting()
	Effects.shake(1.6, 1.4)
	unfade = Effects.fade(1.1)
end

function Cutscenes.resetDone()
	if unfade then
		unfade(0.8)
		unfade = nil
	end
	Effects.flash(Color3.fromRGB(255, 240, 200), 0.6, 0.4)
end

return Cutscenes
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX000630">
          <Properties>
            <string name="Name">Effects</string>
            <ProtectedString name="Source"><![CDATA[-- Эффекты: осколки блоков, пыль от ударов, «+1 Сапфир», летящие монеты,
-- конфетти, вспышки, тряска камеры.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local UIKit = require(script.Parent.UIKit)
local State = require(script.Parent.State)
local Sound = require(script.Parent.Sound)

local Effects = {}

local camera = workspace.CurrentCamera
local fxFolder = nil
local dustPart, dustAttachment, dustEmitter, sparkEmitter
local gui, root

local shakeUntil = 0
local shakePower = 0

local function newFxFolder()
	fxFolder = Instance.new("Folder")
	fxFolder.Name = "LocalFx"
	fxFolder.Parent = workspace
end

local function makeEmitters()
	dustPart = Instance.new("Part")
	dustPart.Name = "FxAnchor"
	dustPart.Anchored = true
	dustPart.CanCollide = false
	dustPart.CanQuery = false
	dustPart.CanTouch = false
	dustPart.Transparency = 1
	dustPart.Size = Vector3.new(0.2, 0.2, 0.2)
	dustPart.Parent = fxFolder
	dustAttachment = Instance.new("Attachment")
	dustAttachment.Parent = dustPart

	dustEmitter = Instance.new("ParticleEmitter")
	dustEmitter.Name = "Dust"
	dustEmitter.Enabled = false
	dustEmitter.Lifetime = NumberRange.new(0.35, 0.7)
	dustEmitter.Speed = NumberRange.new(6, 14)
	dustEmitter.SpreadAngle = Vector2.new(180, 180)
	dustEmitter.Acceleration = Vector3.new(0, -30, 0)
	dustEmitter.Drag = 3
	dustEmitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.55), NumberSequenceKeypoint.new(1, 0) })
	dustEmitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 0.6) })
	dustEmitter.Rotation = NumberRange.new(0, 360)
	dustEmitter.RotSpeed = NumberRange.new(-200, 200)
	dustEmitter.Parent = dustAttachment

	sparkEmitter = Instance.new("ParticleEmitter")
	sparkEmitter.Name = "Sparks"
	sparkEmitter.Enabled = false
	sparkEmitter.LightEmission = 1
	sparkEmitter.Lifetime = NumberRange.new(0.4, 0.9)
	sparkEmitter.Speed = NumberRange.new(8, 20)
	sparkEmitter.SpreadAngle = Vector2.new(180, 180)
	sparkEmitter.Acceleration = Vector3.new(0, -12, 0)
	sparkEmitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0) })
	sparkEmitter.Parent = dustAttachment
end

function Effects.init()
	newFxFolder()
	makeEmitters()
	gui, root = UIKit.screen("FxGui", 30)

	-- тряска камеры поверх обычной камеры
	RunService:BindToRenderStep("DigShake", Enum.RenderPriority.Camera.Value + 2, function()
		local now = os.clock()
		if now < shakeUntil then
			local left = (shakeUntil - now)
			local p = shakePower * math.min(1, left * 2)
			local offset = Vector3.new((math.random() - 0.5) * p, (math.random() - 0.5) * p, (math.random() - 0.5) * p * 0.5)
			camera.CFrame = camera.CFrame * CFrame.new(offset)
		end
	end)
end

function Effects.shake(power, duration)
	shakePower = math.max(power, os.clock() < shakeUntil and shakePower or 0)
	shakeUntil = math.max(shakeUntil, os.clock() + duration)
end

-- Пыль при ударе по блоку
function Effects.hit(block)
	if not block or not block.Parent then
		return
	end
	local cam = camera.CFrame.Position
	local toCam = (cam - block.Position)
	local pos = block.Position + (toCam.Magnitude > 0 and toCam.Unit * (Config.BlockSize * 0.5) or Vector3.zero)
	dustPart.Position = pos
	dustEmitter.Color = ColorSequence.new(block.Color)
	dustEmitter:Emit(7)
	-- блок чуть «вздрагивает»
	local original = block.Size
	block.Size = original * 0.94
	task.delay(0.06, function()
		if block.Parent then
			block.Size = original
		end
	end)
end

-- Осколки и искры, когда блок разрушен (видят все игроки)
function Effects.breakBlock(pos, color)
	if not pos then
		return
	end
	local cam = camera.CFrame.Position
	if (cam - pos).Magnitude > 220 then
		return
	end
	dustPart.Position = pos
	dustEmitter.Color = ColorSequence.new(color)
	dustEmitter:Emit(14)
	for _ = 1, 6 do
		local chunk = Instance.new("Part")
		chunk.Anchored = true
		chunk.CanCollide = false
		chunk.CanQuery = false
		chunk.CanTouch = false
		chunk.CastShadow = false
		chunk.Material = Enum.Material.SmoothPlastic
		chunk.Color = color
		local s = 0.7 + math.random() * 0.9
		chunk.Size = Vector3.new(s, s, s)
		chunk.CFrame = CFrame.new(pos + Vector3.new((math.random() - 0.5) * 3, (math.random() - 0.5) * 3, (math.random() - 0.5) * 3))
			* CFrame.Angles(math.random() * 6, math.random() * 6, math.random() * 6)
		chunk.Parent = fxFolder
		local dir = Vector3.new(math.random() - 0.5, math.random() * 0.8 + 0.2, math.random() - 0.5).Unit
		local goal = chunk.CFrame + dir * (4 + math.random() * 4) - Vector3.new(0, 2 + math.random() * 3, 0)
		TweenService:Create(chunk, TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			CFrame = goal * CFrame.Angles(math.random() * 4, math.random() * 4, 0),
			Size = Vector3.new(0.05, 0.05, 0.05),
			Transparency = 0.3,
		}):Play()
		Debris:AddItem(chunk, 0.6)
	end
end

-- «+1 Сапфир» над разбитым блоком
function Effects.orePopup(oreId, pos)
	local ore = Config.Ores[oreId]
	if not ore or not pos then
		return
	end
	local rare = false
	for _, layer in ipairs(Config.Layers) do
		if layer.Rare.Id == oreId then
			rare = true
		end
	end
	local holder = Instance.new("Part")
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.CanTouch = false
	holder.Transparency = 1
	holder.Size = Vector3.new(0.2, 0.2, 0.2)
	holder.Position = pos + Vector3.new(0, 2, 0)
	holder.Parent = fxFolder
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(rare and 260 or 200, rare and 64 or 46)
	bb.AlwaysOnTop = true
	bb.LightInfluence = 0
	bb.MaxDistance = 140
	bb.Adornee = holder
	bb.Parent = holder
	local label = UIKit.text({
		Text = "+1 " .. ore.Emoji .. " " .. State.name(ore.Name),
		Color = rare and ore.Color or UIKit.White,
		Stroke = 3,
		Parent = bb,
	})
	if rare then
		sparkEmitter.Color = ColorSequence.new(ore.Color)
		dustPart.Position = pos
		sparkEmitter:Emit(24)
		Sound.play("Coin", 0.55, 1.25)
	end
	local scale = UIKit.new("UIScale", { Scale = 0.4, Parent = label })
	UIKit.tween(scale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
	TweenService:Create(holder, TweenInfo.new(1.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = holder.Position + Vector3.new(0, 4, 0) }):Play()
	task.delay(0.7, function()
		UIKit.tween(label, 0.4, { TextTransparency = 1 })
		local stroke = label:FindFirstChildOfClass("UIStroke")
		if stroke then
			UIKit.tween(stroke, 0.4, { Transparency = 1 })
		end
	end)
	Debris:AddItem(holder, 1.2)
end

-- Плавающий текст на экране (позиция в «дизайн-пикселях» корня)
function Effects.floatText(text, color, position, size)
	local label = UIKit.text({
		Text = text,
		Color = color or UIKit.Cash,
		Size = UDim2.fromOffset(size and size * 8 or 260, size or 44),
		Position = position or UDim2.fromScale(0.5, 0.45),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Stroke = 3,
		ZIndex = 20,
		Parent = root,
	})
	UIKit.pop(label, 0.3)
	UIKit.tween(label, 1.1, { Position = label.Position - UDim2.fromOffset(0, 70) }, Enum.EasingStyle.Quad)
	task.delay(0.75, function()
		UIKit.tween(label, 0.35, { TextTransparency = 1 })
		local stroke = label:FindFirstChildOfClass("UIStroke")
		if stroke then
			UIKit.tween(stroke, 0.35, { Transparency = 1 })
		end
	end)
	Debris:AddItem(label, 1.2)
end

-- Монеты летят из центра экрана к счётчику денег
function Effects.coinBurst(count, target)
	target = target or UDim2.new(0, 120, 1, -40)
	for i = 1, count do
		local coin = UIKit.text({
			Text = "💰",
			Size = UDim2.fromOffset(46, 46),
			Position = UDim2.new(0.5, math.random(-140, 140), 0.5, math.random(-90, 90)),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Stroke = 0,
			ZIndex = 25,
			Parent = root,
		})
		UIKit.pop(coin, 0.2, 0.25)
		task.delay(0.15 + i * 0.04, function()
			local t = UIKit.tween(coin, 0.55, { Position = target, Size = UDim2.fromOffset(26, 26) }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
			t.Completed:Connect(function()
				coin:Destroy()
				Sound.play("Coin", 0.25, 1 + math.random() * 0.4)
			end)
		end)
	end
end

-- Конфетти по всему экрану
function Effects.confetti(amount, duration)
	amount = amount or 70
	duration = duration or 2.4
	local colors = {
		Color3.fromRGB(255, 77, 77), Color3.fromRGB(255, 159, 28), Color3.fromRGB(255, 225, 77),
		Color3.fromRGB(76, 217, 100), Color3.fromRGB(47, 155, 255), Color3.fromRGB(176, 92, 255),
	}
	for _ = 1, amount do
		local piece = UIKit.frame({
			Color = colors[math.random(1, #colors)],
			Size = UDim2.fromOffset(math.random(10, 18), math.random(16, 26)),
			Position = UDim2.new(math.random(), 0, 0, -40 - math.random(0, 200)),
			ZIndex = 40,
			Parent = root,
		})
		piece.Rotation = math.random(0, 360)
		local time = duration * (0.7 + math.random() * 0.6)
		UIKit.tween(piece, time, {
			Position = UDim2.new(piece.Position.X.Scale + (math.random() - 0.5) * 0.2, 0, 1, 60),
			Rotation = piece.Rotation + math.random(-540, 540),
		}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		Debris:AddItem(piece, time + 0.1)
	end
end

-- Вспышка цветом на весь экран
function Effects.flash(color, duration, startTransparency)
	local f = UIKit.frame({
		Name = "Flash",
		Color = color or UIKit.White,
		Transparency = startTransparency or 0.1,
		Size = UDim2.fromScale(3, 3),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 50,
		Parent = root,
	})
	UIKit.tween(f, duration or 0.6, { BackgroundTransparency = 1 })
	Debris:AddItem(f, (duration or 0.6) + 0.1)
end

-- Затемнение (для перехода): возвращает функцию, которая убирает затемнение
function Effects.fade(duration)
	local f = UIKit.frame({
		Name = "Fade",
		Color = UIKit.Black,
		Transparency = 1,
		Size = UDim2.fromScale(3, 3),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 60,
		Parent = root,
	})
	UIKit.tween(f, duration or 0.5, { BackgroundTransparency = 0 })
	return function(outTime)
		local t = UIKit.tween(f, outTime or 0.6, { BackgroundTransparency = 1 })
		t.Completed:Connect(function()
			f:Destroy()
		end)
	end
end

function Effects.root()
	return root
end

return Effects
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX000631">
          <Properties>
            <string name="Name">HUD</string>
            <ProtectedString name="Source"><![CDATA[-- Главный экран (HUD): деньги, рюкзак, сила кирки, глубина, цель,
-- кнопки слева/справа, зелья, всплывающие сообщения, кнопка «Копать» на телефоне.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Economy = require(Shared:WaitForChild("Economy"))
local Locale = require(Shared:WaitForChild("Locale"))
local UIKit = require(script.Parent.UIKit)
local State = require(script.Parent.State)

local HUD = {}

local player = Players.LocalPlayer
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local gui, root
local refs = {}
local handlers = {} -- колбэки кнопок (ставит Main)
local shownCash = 0
local cashValue = nil
local toastHolder = nil

local function t(key, ...)
	return State.t(key, ...)
end

function HUD.on(name, fn)
	handlers[name] = fn
end

local function fire(name, ...)
	if handlers[name] then
		handlers[name](...)
	end
end

local function currencyRow(order, icon, color)
	local row = UIKit.frame({ Name = "Row" .. order, Transparency = 1, Size = UDim2.fromOffset(330, 46), LayoutOrder = order, Parent = refs.currency })
	UIKit.text({ Name = "Icon", Text = icon, Size = UDim2.fromOffset(44, 44), Position = UDim2.fromOffset(0, 1), Stroke = 0, Parent = row })
	local value = UIKit.text({ Name = "Value", Text = "0", Size = UDim2.new(1, -54, 1, 0), Position = UDim2.fromOffset(52, 0), Color = color, XAlign = Enum.TextXAlignment.Left, Stroke = 3.5, MaxSize = 40, Parent = row })
	return row, value
end

local function build()
	if gui then
		gui:Destroy()
	end
	refs = {}
	UIKit.lang = State.lang
	gui, root = UIKit.screen("HudGui", 5)

	-- Внизу слева: рюкзак, сила, деньги (как в топовых симуляторах)
	refs.currency = UIKit.frame({ Name = "Currency", Transparency = 1, Size = UDim2.fromOffset(330, 150), Position = UDim2.new(0, 22, 1, -14), AnchorPoint = Vector2.new(0, 1), Parent = root })
	UIKit.list(refs.currency, Enum.FillDirection.Vertical, 2, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Bottom)
	refs.bagRow, refs.bagValue = currencyRow(1, "🎒", UIKit.BagColor)
	refs.powerRow, refs.powerValue = currencyRow(2, "⛏", UIKit.White)
	refs.cashRow, refs.cashValue = currencyRow(3, "💰", UIKit.Cash)
	refs.full = UIKit.frame({ Name = "Full", Color = UIKit.White, Size = UDim2.fromOffset(112, 30), Position = UDim2.new(0, 190, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), Corner = 12, Stroke = 3, Gradient = UIKit.C.Red, Visible = false, Parent = refs.bagRow })
	UIKit.text({ Text = t("Full"), Size = UDim2.new(1, -8, 1, -6), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), MaxSize = 18, Stroke = 2, Parent = refs.full })

	-- Слева: магазин, ребёрт, рюкзак
	local left = UIKit.frame({ Name = "Left", Transparency = 1, Size = UDim2.fromOffset(100, 340), Position = UDim2.new(0, 22, 0.5, -30), AnchorPoint = Vector2.new(0, 0.5), Parent = root })
	UIKit.list(left, Enum.FillDirection.Vertical, 14)
	refs.shopBtn = UIKit.iconButton({ Name = "Shop", Icon = "🛒", Text = t("Shop"), LayoutOrder = 1, OnClick = function() fire("Shop") end, Parent = left })
	refs.rebirthBtn = UIKit.iconButton({ Name = "Rebirth", Icon = "🔄", Text = t("Rebirth"), LayoutOrder = 2, OnClick = function() fire("Rebirth") end, Parent = left })
	refs.bagBtn = UIKit.iconButton({ Name = "Bag", Icon = "🎒", Text = t("Bag"), LayoutOrder = 3, OnClick = function() fire("Sell") end, Parent = left })

	-- Справа: премиум, награды, лифт, наверх
	local right = UIKit.frame({ Name = "Right", Transparency = 1, Size = UDim2.fromOffset(100, 460), Position = UDim2.new(1, -22, 0.5, 20), AnchorPoint = Vector2.new(1, 0.5), Parent = root })
	UIKit.list(right, Enum.FillDirection.Vertical, 12)
	refs.premiumBtn = UIKit.iconButton({ Name = "Premium", Icon = "💎", Text = t("Premium"), Colors = UIKit.C.Purple, LayoutOrder = 1, OnClick = function() fire("Premium") end, Parent = right })
	refs.rewardsBtn = UIKit.iconButton({ Name = "Rewards", Icon = "🎁", Text = t("Rewards"), LayoutOrder = 2, OnClick = function() fire("Daily") end, Parent = right })
	refs.elevatorBtn = UIKit.iconButton({ Name = "Elevator", Icon = "🛗", Text = t("Elevator"), LayoutOrder = 3, OnClick = function() fire("Elevator") end, Parent = right })
	refs.surfaceBtn = UIKit.iconButton({ Name = "Surface", Icon = "⬆", Text = t("Surface"), LayoutOrder = 4, OnClick = function() Remotes.Action:FireServer("Surface") end, Parent = right })

	-- Сверху по центру: глубина и прогресс слоя
	local depth = UIKit.frame({ Name = "Depth", Transparency = 1, Size = UDim2.fromOffset(560, 80), Position = UDim2.new(0.5, 0, 0, 6), AnchorPoint = Vector2.new(0.5, 0), Parent = root })
	refs.depthLabel = UIKit.text({ Text = "", Size = UDim2.new(1, 0, 0, 40), MaxSize = 32, Stroke = 3.5, Parent = depth })
	refs.depthBar = UIKit.bar({ Size = UDim2.fromOffset(400, 24), Position = UDim2.new(0.5, 0, 0, 46), AnchorPoint = Vector2.new(0.5, 0), Colors = { Color3.fromRGB(230, 230, 240), Color3.fromRGB(150, 150, 170) }, TextMax = 15, Parent = depth })

	-- Сверху справа: цель
	local goal = UIKit.frame({ Name = "Goal", Color = UIKit.Panel, Transparency = 0.12, Size = UDim2.fromOffset(300, 98), Position = UDim2.new(1, -18, 0, 6), AnchorPoint = Vector2.new(1, 0), Corner = 16, Stroke = 3, Parent = root })
	UIKit.text({ Text = t("Goal"), Size = UDim2.new(1, -24, 0, 26), Position = UDim2.fromOffset(12, 8), Color = UIKit.Yellow, XAlign = Enum.TextXAlignment.Left, MaxSize = 22, Parent = goal })
	refs.goalText = UIKit.text({ Text = "", Size = UDim2.new(1, -24, 0, 24), Position = UDim2.fromOffset(12, 36), XAlign = Enum.TextXAlignment.Left, Weight = "bold", MaxSize = 18, Stroke = 2, Parent = goal })
	refs.goalBar = UIKit.bar({ Size = UDim2.new(1, -24, 0, 20), Position = UDim2.fromOffset(12, 68), TextMax = 13, Stroke = 2, Parent = goal })
	refs.goal = goal

	-- Зелья (под целью)
	refs.potions = UIKit.frame({ Name = "Potions", Transparency = 1, Size = UDim2.fromOffset(300, 80), Position = UDim2.new(1, -18, 0, 112), AnchorPoint = Vector2.new(1, 0), Parent = root })
	UIKit.list(refs.potions, Enum.FillDirection.Vertical, 6, Enum.HorizontalAlignment.Right)
	refs.luckChip = UIKit.frame({ Name = "Luck", Color = Color3.fromRGB(31, 92, 58), Transparency = 0.05, Size = UDim2.fromOffset(190, 32), Corner = 12, Stroke = 3, Visible = false, LayoutOrder = 1, Parent = refs.potions })
	refs.luckText = UIKit.text({ Text = "", Size = UDim2.new(1, -12, 1, -6), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), MaxSize = 18, Stroke = 2, Parent = refs.luckChip })
	refs.speedChip = UIKit.frame({ Name = "Speed", Color = Color3.fromRGB(110, 84, 16), Transparency = 0.05, Size = UDim2.fromOffset(190, 32), Corner = 12, Stroke = 3, Visible = false, LayoutOrder = 2, Parent = refs.potions })
	refs.speedText = UIKit.text({ Text = "", Size = UDim2.new(1, -12, 1, -6), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), MaxSize = 18, Stroke = 2, Parent = refs.speedChip })

	-- Внизу справа (над прыжком): авто-копание и язык
	local toggles = UIKit.frame({ Name = "Toggles", Transparency = 1, Size = UDim2.fromOffset(200, 110), Position = UDim2.new(1, -22, 1, -170), AnchorPoint = Vector2.new(1, 1), Parent = root })
	UIKit.list(toggles, Enum.FillDirection.Vertical, 8, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Bottom)
	refs.autoBtn = UIKit.button({ Name = "Auto", Text = t("AutoOff"), Colors = UIKit.C.Gray, Size = UDim2.fromOffset(190, 44), MaxSize = 20, LayoutOrder = 1, OnClick = function()
		local st = State.data
		if st then
			Remotes.Action:FireServer("SetAuto", not st.AutoMine)
		end
	end, Parent = toggles })
	refs.autoBtn.Visible = false
	refs.langBtn = UIKit.button({ Name = "Lang", Text = t("Lang"), Colors = UIKit.C.Dark, Size = UDim2.fromOffset(120, 44), MaxSize = 20, LayoutOrder = 2, OnClick = function()
		Remotes.Action:FireServer("SetLang", State.lang == "ru" and "en" or "ru")
	end, Parent = toggles })

	-- Телефон: большая кнопка «Копать» рядом с прыжком
	refs.digBtn = UIKit.button({ Name = "Dig", Text = "⛏\n" .. t("Dig"), Colors = UIKit.C.Orange, Size = UDim2.fromOffset(118, 118), Position = UDim2.new(1, -200, 1, -30), AnchorPoint = Vector2.new(1, 1), Corner = 59, StrokeThickness = 4, MaxSize = 26, Parent = root })
	refs.digBtn.Visible = UserInputService.TouchEnabled
	refs.digBtn.MouseButton1Down:Connect(function()
		fire("DigHold", true)
	end)
	refs.digBtn.MouseButton1Up:Connect(function()
		fire("DigHold", false)
	end)
	refs.digBtn.MouseLeave:Connect(function()
		fire("DigHold", false)
	end)

	-- Предупреждение об обновлении шахты
	refs.resetBanner = UIKit.frame({ Name = "ResetBanner", Color = UIKit.White, Size = UDim2.fromOffset(520, 46), Position = UDim2.new(0.5, 0, 0, 96), AnchorPoint = Vector2.new(0.5, 0), Corner = 14, Stroke = 3, Gradient = UIKit.C.Red, Visible = false, Parent = root })
	refs.resetText = UIKit.text({ Text = "", Size = UDim2.new(1, -16, 1, -8), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), MaxSize = 24, Parent = refs.resetBanner })

	-- Всплывающие сообщения
	toastHolder = UIKit.frame({ Name = "Toasts", Transparency = 1, Size = UDim2.fromOffset(640, 200), Position = UDim2.new(0.5, 0, 1, -24), AnchorPoint = Vector2.new(0.5, 1), Parent = root })
	UIKit.list(toastHolder, Enum.FillDirection.Vertical, 6, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Bottom)

	shownCash = State.data and State.data.Cash or 0
	if State.data then
		HUD.update(State.data)
	end
end

function HUD.init()
	cashValue = Instance.new("NumberValue")
	cashValue.Changed:Connect(function(v)
		shownCash = v
		if refs.cashValue then
			refs.cashValue.Text = "$" .. Locale.short(v)
		end
	end)
	build()
	RunService.Heartbeat:Connect(function()
		HUD.tick()
	end)
end

function HUD.rebuild()
	build()
end

function HUD.setVisible(on)
	if gui then
		gui.Enabled = on
	end
end

function HUD.cashTarget()
	return UDim2.new(0, 120, 1, -40)
end

-- Цель игрока: что делать дальше
local function goalFor(st)
	if st.InvCount >= st.Capacity then
		return t(st.Passes.SellAnywhere and "GoalSellAnywhere" or "GoalSell"), 1, t("Full")
	end
	local nextPick = Config.Pickaxes[st.Pickaxe + 1]
	if nextPick and st.Cash >= nextPick.Price then
		return t("GoalBuyPick", State.name(nextPick.Name)), 1, "$" .. Locale.short(st.Cash) .. " / $" .. Locale.short(nextPick.Price)
	end
	local power = Config.Pickaxes[st.Pickaxe].Power
	for _, layer in ipairs(Config.Layers) do
		if not st.Layers[layer.Id] and layer.MinPower <= power then
			local frac = layer.From > 0 and st.BestDepth / layer.From or 0
			return t("GoalDigTo", State.name(layer.Name)), frac, Locale.short(st.BestDepth) .. " / " .. Locale.short(layer.From) .. " m"
		end
	end
	if nextPick then
		return t("GoalSavePick", State.name(nextPick.Name)), st.Cash / nextPick.Price, "$" .. Locale.short(st.Cash) .. " / $" .. Locale.short(nextPick.Price)
	end
	local cost = Economy.rebirthCost(st.Rebirths)
	if st.Cash >= cost then
		return t("GoalRebirthReady", tostring(Economy.rebirthMultiplier(st.Rebirths + 1))), 1, "$" .. Locale.short(st.Cash) .. " / $" .. Locale.short(cost)
	end
	return t("GoalRebirth"), st.Cash / cost, "$" .. Locale.short(st.Cash) .. " / $" .. Locale.short(cost)
end

function HUD.update(st)
	if not refs.bagValue then
		return
	end
	refs.bagValue.Text = tostring(st.InvCount) .. " / " .. tostring(st.Capacity)
	local full = st.InvCount >= st.Capacity
	refs.bagValue.TextColor3 = full and UIKit.RedText or UIKit.BagColor
	if full and not refs.full.Visible then
		refs.full.Visible = true
		UIKit.pop(refs.full, 0.5)
	elseif not full then
		refs.full.Visible = false
	end
	refs.powerValue.Text = tostring(Config.Pickaxes[st.Pickaxe].Power)
	if math.abs(st.Cash - shownCash) > 0 then
		UIKit.tween(cashValue, 0.45, { Value = st.Cash })
	end
	refs.rewardsBtn.Dot.Visible = st.Daily and st.Daily.CanClaim or false
	local goalText, goalFrac, goalLabel = goalFor(st)
	refs.goalText.Text = goalText
	UIKit.setBar(refs.goalBar, goalFrac, goalLabel)
	refs.autoBtn.Visible = st.Passes.AutoMine == true
	UIKit.setButton(refs.autoBtn, t(st.AutoMine and "AutoOn" or "AutoOff"), st.AutoMine and UIKit.C.Green or UIKit.C.Gray)
	local rebirthReady = st.Cash >= Economy.rebirthCost(st.Rebirths)
	refs.rebirthBtn.Dot.Visible = rebirthReady
end

-- Каждый кадр: глубина под ногами, таймеры зелий
local lastLayerIndex = nil
function HUD.tick()
	local st = State.data
	if not st or not refs.depthLabel then
		return
	end
	local char = player.Character
	local rootPart = char and char:FindFirstChild("HumanoidRootPart")
	if rootPart then
		local y = rootPart.Position.Y - 3
		if y >= Config.SurfaceY - 1 then
			refs.depthLabel.Text = t("OnSurface")
			UIKit.setBar(refs.depthBar, 0, "🏆 " .. Locale.short(st.BestDepth) .. " m")
			lastLayerIndex = 0
		else
			local depth = Economy.depthAtY(y)
			local layer, index, frac, left = Economy.layerProgress(depth)
			refs.depthLabel.Text = t("DepthFmt", tostring(depth), State.name(layer.Name))
			local nextLayer = Config.Layers[index + 1]
			if nextLayer then
				UIKit.setBar(refs.depthBar, frac, t("NextLayer", State.name(nextLayer.Name), tostring(left)))
			else
				UIKit.setBar(refs.depthBar, frac, t("Bottom"))
			end
			if lastLayerIndex ~= index then
				lastLayerIndex = index
				local fill = refs.depthBar:FindFirstChild("Fill")
				local grad = fill and fill:FindFirstChildOfClass("UIGradient")
				if grad then
					grad.Color = ColorSequence.new(layer.Color:Lerp(Color3.new(1, 1, 1), 0.45), layer.Color)
				end
			end
		end
	end
	local luck = State.potionLeft("Luck")
	refs.luckChip.Visible = luck > 0
	if luck > 0 then
		refs.luckText.Text = t("PotionLuck", Locale.timer(luck))
	end
	local speed = State.potionLeft("Speed")
	refs.speedChip.Visible = speed > 0
	if speed > 0 then
		refs.speedText.Text = t("PotionSpeed", Locale.timer(speed))
	end
end

-- Всплывающее сообщение внизу экрана
function HUD.toast(text, colors)
	if not toastHolder then
		return
	end
	local count = 0
	for _, child in ipairs(toastHolder:GetChildren()) do
		if child:IsA("Frame") then
			count = count + 1
			if count >= 3 then
				child:Destroy()
			end
		end
	end
	local chip = UIKit.frame({ Name = "Toast", Color = UIKit.White, Size = UDim2.fromOffset(560, 46), Corner = 14, Stroke = 3, LayoutOrder = math.floor(os.clock() * 100), Parent = toastHolder })
	UIKit.gradient(chip, colors or { Color3.fromRGB(52, 54, 72), Color3.fromRGB(30, 30, 42) }, 90)
	local label = UIKit.text({ Text = text, Size = UDim2.new(1, -20, 1, -10), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), MaxSize = 24, Parent = chip })
	UIKit.pop(chip, 0.6, 0.3)
	task.delay(2.6, function()
		if chip.Parent then
			UIKit.tween(chip, 0.3, { BackgroundTransparency = 1 })
			UIKit.tween(label, 0.3, { TextTransparency = 1 })
			Debris:AddItem(chip, 0.35)
		end
	end)
end

function HUD.resetBanner(seconds)
	if not refs.resetBanner then
		return
	end
	refs.resetBanner.Visible = true
	UIKit.pop(refs.resetBanner, 0.7)
	task.spawn(function()
		for s = seconds, 1, -1 do
			if not refs.resetText then
				return
			end
			refs.resetText.Text = t("ResetWarn", tostring(s))
			task.wait(1)
		end
		if refs.resetBanner then
			refs.resetBanner.Visible = false
		end
	end)
end

function HUD.bumpBag()
	if refs.bagRow then
		UIKit.pop(refs.bagRow, 0.85, 0.2)
	end
end

return HUD
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="RBX000632">
          <Properties>
            <string name="Name">Main</string>
            <ProtectedString name="Source"><![CDATA[-- Копай глубже / Dig to the Core — запуск клиента: связывает интерфейс,
-- копание, эффекты, катсцены и сообщения сервера.

local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Locale = require(Shared:WaitForChild("Locale"))

local UIKit = require(script.Parent.UIKit)
local State = require(script.Parent.State)
local Sound = require(script.Parent.Sound)
local Effects = require(script.Parent.Effects)
local HUD = require(script.Parent.HUD)
local Windows = require(script.Parent.Windows)
local Mining = require(script.Parent.Mining)
local Cutscenes = require(script.Parent.Cutscenes)
local Ambience = require(script.Parent.Ambience)
local World = require(script.Parent.World)

local player = Players.LocalPlayer
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

-- свой интерфейс вместо стандартного рюкзака (кирка всегда в руках)
task.spawn(function()
	for _ = 1, 10 do
		local ok = pcall(function()
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
		end)
		if ok then
			break
		end
		task.wait(0.5)
	end
end)

local function t(key, ...)
	return State.t(key, ...)
end

Ambience.init()
Effects.init()
HUD.init()

Windows.init(function(open)
	Mining.setBlocked(open or Cutscenes.isActive())
end)

Cutscenes.init(function(active)
	if active then
		Windows.close()
	end
	HUD.setVisible(not active)
	Mining.setBlocked(active or Windows.isOpen())
end)

Mining.init()

World.init(function(kind)
	if Cutscenes.isActive() then
		return
	end
	if kind == "PickShop" then
		Windows.open("Shop", "picks")
	elseif kind == "BagShop" then
		Windows.open("Shop", "bags")
	elseif kind == "Rebirth" then
		Windows.open("Rebirth")
	elseif kind == "Elevator" then
		Windows.open("Elevator")
	elseif kind == "Daily" then
		Windows.open("Daily")
	end
end)

HUD.on("Shop", function()
	Windows.toggle("Shop", "picks")
end)
HUD.on("Rebirth", function()
	Windows.toggle("Rebirth")
end)
HUD.on("Sell", function()
	Windows.toggle("Sell")
end)
HUD.on("Premium", function()
	Windows.toggle("Premium")
end)
HUD.on("Daily", function()
	Windows.toggle("Daily")
end)
HUD.on("Elevator", function()
	Windows.toggle("Elevator")
end)
HUD.on("DigHold", function(on)
	Mining.setDigHeld(on)
end)

-- Состояние от сервера
local firstState = true
State.onChange(function(st, langChanged)
	UIKit.lang = State.lang
	if langChanged then
		HUD.rebuild()
		World.refreshTexts()
		Windows.relocalize()
	end
	HUD.update(st)
	Windows.refresh(st)
end)

Remotes.State.OnClientEvent:Connect(function(st)
	State.set(st)
	if firstState then
		firstState = false
		World.refreshTexts()
		if not st.SeenIntro then
			Cutscenes.intro()
		else
			HUD.toast(t("Welcome"), UIKit.C.Blue)
		end
		if st.Offline then
			task.delay(4, function()
				HUD.toast(t("SavesOff"))
			end)
		end
	end
end)

-- Названия кирок в сообщениях передаются номером — переводим здесь
local INDEX_ARGS = { NeedPickaxe = true, LayerTooHard = true }

local Fx = {}

function Fx.Break(pos, color)
	Effects.breakBlock(pos, color)
end

function Fx.Ore(oreId, pos)
	Effects.orePopup(oreId, pos)
	HUD.bumpBag()
end

function Fx.Toast(key, ...)
	local args = { ... }
	if INDEX_ARGS[key] and args[1] then
		local pick = Config.Pickaxes[args[1]]
		args[1] = pick and State.name(pick.Name) or "?"
	elseif key == "DailyWait" and args[1] then
		args[1] = Locale.duration(State.lang, args[1])
	end
	local colors = nil
	if key == "BackpackFull" or key == "NeedPickaxe" or key == "NotEnough" or key == "CodeBad" or key == "LayerTooHard" then
		colors = UIKit.C.Red
		Sound.play("Error", 0.4, 0.8)
	end
	HUD.toast(t(key, table.unpack(args)), colors)
end

function Fx.Sold(value, count)
	Sound.play("Coin", 0.6, 1)
	Effects.coinBurst(math.clamp(math.floor((count or 5) / 3), 4, 14), HUD.cashTarget())
	Effects.floatText("+$" .. Locale.short(value), UIKit.Cash, UDim2.new(0, 220, 1, -150), 46)
	HUD.toast(t("Sold", Locale.short(value)), UIKit.C.Green)
end

function Fx.Layer(index, reward)
	Cutscenes.layer(index, reward)
end

function Fx.Core(reward)
	Cutscenes.core(reward)
end

function Fx.Rebirth(count, multiplier)
	Windows.close()
	Cutscenes.rebirth(count, multiplier)
end

function Fx.Bought(kind, index)
	local list = kind == "Pickaxe" and Config.Pickaxes or Config.Backpacks
	local item = list[index]
	Sound.play("Reward", 0.6, 1.2)
	Effects.confetti(40, 1.8)
	HUD.toast(t("Bought", item and State.name(item.Name) or "?"), UIKit.C.Gold)
end

function Fx.Daily(day, cash, potion)
	Sound.play("Reward", 0.6, 1)
	if cash and cash > 0 then
		Effects.coinBurst(10, HUD.cashTarget())
		Effects.floatText("+$" .. Locale.short(cash), UIKit.Cash, UDim2.new(0, 220, 1, -150), 46)
	end
	Effects.confetti(50, 2)
	HUD.toast(t("DailyClaimed", tostring(day)), UIKit.C.Green)
end

function Fx.Code(cash)
	Sound.play("Reward", 0.6, 1.1)
	Effects.confetti(50, 2)
	if cash and cash > 0 then
		Effects.coinBurst(8, HUD.cashTarget())
	end
	HUD.toast(t("CodeOk"), UIKit.C.Green)
end

function Fx.Teleport(index)
	local layer = Config.Layers[index]
	Effects.flash(layer and layer.Color or UIKit.White, 0.6, 0.1)
	if layer then
		HUD.toast(t("Teleported", State.name(layer.Name)), UIKit.C.Gold)
	end
end

function Fx.Thanks()
	Sound.play("Reward", 0.7, 1)
	Effects.confetti(110, 2.8)
	HUD.toast(t("Thanks"), UIKit.C.Pink)
end

function Fx.ResetWarn(seconds)
	HUD.resetBanner(seconds or 30)
	Cutscenes.resetWarn()
end

function Fx.Resetting()
	Windows.close()
	Cutscenes.resetting()
end

function Fx.ResetDone()
	Cutscenes.resetDone()
	HUD.toast(t("ResetDone"), UIKit.C.Blue)
end

Remotes.Fx.OnClientEvent:Connect(function(kind, ...)
	local handler = Fx[kind]
	if handler then
		local ok, err = pcall(handler, ...)
		if not ok then
			warn("[Копай глубже] Эффект " .. tostring(kind) .. ": " .. tostring(err))
		end
	end
end)

Sound.startMusic()
Remotes.Action:FireServer("Ready")
]]></ProtectedString>
            <bool name="Disabled">false</bool>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX000633">
          <Properties>
            <string name="Name">Mining</string>
            <ProtectedString name="Source"><![CDATA[-- Копание: зажми левую кнопку мыши / палец на блоке, или кнопку «Копать» на телефоне.
-- Показывает рамку вокруг блока и полоску прочности, проигрывает удар киркой.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local UIKit = require(script.Parent.UIKit)
local State = require(script.Parent.State)
local Sound = require(script.Parent.Sound)
local Effects = require(script.Parent.Effects)
local HUD = require(script.Parent.HUD)

local Mining = {}

local player = Players.LocalPlayer
local mouse = player:GetMouse()
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local holding = false
local digHeld = false
local lastSwing = 0
local lastWeakToast = 0
local blocked = false -- во время катсцен и открытых окон

local selection, hpGui, hpName, hpBar, hpFill, hpHint

local function blocksFolder()
	local mine = workspace:FindFirstChild("Mine")
	return mine and mine:FindFirstChild("Blocks")
end

local function isBlock(part)
	local folder = blocksFolder()
	return part ~= nil and folder ~= nil and part.Parent == folder
end

local function rootPart()
	local char = player.Character
	return char and char:FindFirstChild("HumanoidRootPart")
end

local function ensureTool()
	local char = player.Character
	local humanoid = char and char:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return nil
	end
	local tool = char:FindFirstChild("Pickaxe")
	if tool then
		return tool
	end
	local backpack = player:FindFirstChild("Backpack")
	tool = backpack and backpack:FindFirstChild("Pickaxe")
	if tool then
		humanoid:EquipTool(tool)
	end
	return tool
end

local function canMine(block)
	local st = State.data
	if not st then
		return false, nil
	end
	local layer = Config.LayerForDepth(block:GetAttribute("D") or 0)
	return Config.Pickaxes[st.Pickaxe].Power >= layer.MinPower, layer
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Include
local overlapParams = OverlapParams.new()
overlapParams.FilterType = Enum.RaycastFilterType.Include

-- Ближайший блок для кнопки «Копать» и авто-копания: сначала под ногами
local function nearestBlock(root)
	local folder = blocksFolder()
	if not folder then
		return nil
	end
	rayParams.FilterDescendantsInstances = { folder }
	local hit = workspace:Raycast(root.Position, Vector3.new(0, -9, 0), rayParams)
	if hit and isBlock(hit.Instance) and canMine(hit.Instance) then
		return hit.Instance
	end
	overlapParams.FilterDescendantsInstances = { folder }
	local best, bestScore = nil, math.huge
	for _, part in ipairs(workspace:GetPartBoundsInRadius(root.Position, Config.Reach * 0.55, overlapParams)) do
		if isBlock(part) and canMine(part) then
			local d = (part.Position - root.Position).Magnitude
			if part.Position.Y > root.Position.Y + 1 then
				d = d + 8 -- над головой — в последнюю очередь
			end
			if d < bestScore then
				best, bestScore = part, d
			end
		end
	end
	return best
end

local function swing(block)
	local st = State.data
	if not st then
		return
	end
	local now = os.clock()
	if now - lastSwing < st.Cooldown then
		return
	end
	local ok, layer = canMine(block)
	if not ok then
		if now - lastWeakToast > 2 then
			lastWeakToast = now
			local need = Config.Pickaxes[Config.PickaxeForPower(layer.MinPower)]
			HUD.toast(State.t("NeedPickaxe", State.name(need.Name)), UIKit.C.Red)
			Sound.play("Error", 0.4, 0.7)
		end
		lastSwing = now
		return
	end
	lastSwing = now
	local tool = ensureTool()
	if tool then
		-- стандартная анимация удара инструментом
		local anim = Instance.new("StringValue")
		anim.Name = "toolanim"
		anim.Value = "Slash"
		anim.Parent = tool
		Debris:AddItem(anim, 0.3)
	end
	Remotes.Mine:FireServer(block)
	Effects.hit(block)
	Sound.play("Swing", 0.28, 0.95 + math.random() * 0.15)
	Sound.play("Hit", 0.35, 0.8 + math.random() * 0.3)
end

local function buildIndicator()
	local playerGui = player:WaitForChild("PlayerGui")
	selection = Instance.new("SelectionBox")
	selection.Name = "BlockSelection"
	selection.LineThickness = 0.08
	selection.Color3 = Color3.fromRGB(255, 220, 80)
	selection.SurfaceColor3 = Color3.fromRGB(255, 220, 80)
	selection.SurfaceTransparency = 0.88
	selection.Parent = playerGui

	hpGui = Instance.new("BillboardGui")
	hpGui.Name = "BlockHp"
	hpGui.Size = UDim2.fromOffset(200, 64)
	hpGui.StudsOffset = Vector3.new(0, Config.BlockSize / 2 + 1.6, 0)
	hpGui.AlwaysOnTop = true
	hpGui.LightInfluence = 0
	hpGui.Enabled = false
	hpGui.Parent = playerGui
	local panel = UIKit.frame({ Color = UIKit.Panel, Transparency = 0.1, Size = UDim2.new(1, 0, 0, 44), Corner = 10, Stroke = 2, Parent = hpGui })
	hpName = UIKit.text({ Text = "", Size = UDim2.new(1, -12, 0, 20), Position = UDim2.new(0.5, 0, 0, 3), AnchorPoint = Vector2.new(0.5, 0), MaxSize = 16, Stroke = 2, Parent = panel })
	hpBar, hpFill = UIKit.bar({ Size = UDim2.new(1, -16, 0, 12), Position = UDim2.new(0.5, 0, 0, 26), AnchorPoint = Vector2.new(0.5, 0), Stroke = 2, Corner = 6, Parent = panel })
	hpHint = UIKit.text({ Text = "", Size = UDim2.new(1, 0, 0, 18), Position = UDim2.new(0.5, 0, 0, 46), AnchorPoint = Vector2.new(0.5, 0), Color = UIKit.RedText, MaxSize = 15, Stroke = 2, Parent = hpGui })
end

local function showIndicator(block)
	if not block then
		selection.Adornee = nil
		hpGui.Enabled = false
		hpGui.Adornee = nil
		return
	end
	selection.Adornee = block
	hpGui.Adornee = block
	hpGui.Enabled = true
	local ok, layer = canMine(block)
	local name
	if block:GetAttribute("Rare") then
		local ore = Config.Ores[block:GetAttribute("Ore")]
		name = ore and (ore.Emoji .. " " .. State.name(ore.Name)) or State.name(layer.Name)
	else
		name = State.name(layer.Name)
	end
	hpName.Text = name
	local hp = block:GetAttribute("Hp") or 1
	local maxHp = block:GetAttribute("MaxHp") or 1
	hpFill.Size = UDim2.fromScale(math.clamp(hp / maxHp, 0.04, 1), 1)
	local grad = hpFill:FindFirstChildOfClass("UIGradient")
	if grad then
		local pair = ok and UIKit.C.Green or UIKit.C.Red
		grad.Color = ColorSequence.new(pair[1], pair[2])
	end
	if ok then
		hpHint.Text = ""
		selection.Color3 = Color3.fromRGB(255, 220, 80)
	else
		local need = Config.Pickaxes[Config.PickaxeForPower(layer.MinPower)]
		hpHint.Text = State.t("NeedPick", State.name(need.Name))
		selection.Color3 = Color3.fromRGB(255, 80, 70)
	end
end

function Mining.setBlocked(on)
	blocked = on
	if on then
		holding = false
		digHeld = false
	end
end

function Mining.setDigHeld(on)
	digHeld = on
end

function Mining.init()
	buildIndicator()

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			holding = true
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			holding = false
		end
	end)

	RunService.Heartbeat:Connect(function()
		local root = rootPart()
		if blocked or not root or not State.data then
			showIndicator(nil)
			return
		end
		local reach = Config.Reach
		local target = nil
		local hover = nil
		local mt = mouse.Target
		if isBlock(mt) and (mt.Position - root.Position).Magnitude <= reach then
			hover = mt
			if holding then
				target = mt
			end
		end
		if not target and (digHeld or State.data.AutoMine) then
			target = nearestBlock(root)
		end
		if not UserInputService.MouseEnabled and not target then
			hover = nil
		end
		showIndicator(target or hover)
		if target then
			swing(target)
		end
	end)

	-- если кирку случайно убрали из рук — вернуть
	task.spawn(function()
		while true do
			task.wait(1)
			if not blocked and State.data then
				ensureTool()
			end
		end
	end)
end

return Mining
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX000634">
          <Properties>
            <string name="Name">Sound</string>
            <ProtectedString name="Source"><![CDATA[-- Звуки интерфейса и копания (Id звуков — в Config.Sounds).

local SoundService = game:GetService("SoundService")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local Sound = {}

local templates = {}
local lastPlayed = {}

function Sound.play(name, volume, pitch)
	local id = Config.Sounds[name]
	if not id or id == "" then
		return
	end
	-- не играем один и тот же звук чаще 25 раз в секунду
	local now = os.clock()
	if lastPlayed[name] and now - lastPlayed[name] < 0.04 then
		return
	end
	lastPlayed[name] = now
	local template = templates[name]
	if not template then
		template = Instance.new("Sound")
		template.Name = "Sfx_" .. name
		template.SoundId = id
		templates[name] = template
	end
	local s = template:Clone()
	s.Volume = volume or 0.5
	s.PlaybackSpeed = pitch or 1
	s.Parent = SoundService
	s:Play()
	Debris:AddItem(s, 4)
end

function Sound.startMusic()
	local id = Config.Sounds.Music
	if not id or id == "" then
		return
	end
	local music = Instance.new("Sound")
	music.Name = "Music"
	music.SoundId = id
	music.Looped = true
	music.Volume = 0.25
	music.Parent = SoundService
	music:Play()
end

return Sound
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX000635">
          <Properties>
            <string name="Name">State</string>
            <ProtectedString name="Source"><![CDATA[-- Последнее состояние игрока, присланное сервером, + текущий язык.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Locale = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Locale"))

local State = {
	data = nil,
	lang = "ru",
	receivedAt = 0,
}

local listeners = {}

function State.onChange(fn)
	table.insert(listeners, fn)
end

function State.set(newData)
	local previousLang = State.lang
	State.data = newData
	State.receivedAt = os.clock()
	if newData.Lang == "ru" or newData.Lang == "en" then
		State.lang = newData.Lang
	end
	local langChanged = previousLang ~= State.lang
	for _, fn in ipairs(listeners) do
		local ok, err = pcall(fn, newData, langChanged)
		if not ok then
			warn("[Копай глубже] Ошибка обновления интерфейса: " .. tostring(err))
		end
	end
end

-- Перевод строки
function State.t(key, ...)
	return Locale.get(State.lang, key, ...)
end

-- Имя из таблицы { ru, en }
function State.name(tbl)
	return Locale.name(State.lang, tbl)
end

-- Сколько секунд осталось у зелья с учётом времени с последнего обновления
function State.potionLeft(name)
	local st = State.data
	if not st or not st.Potions then
		return 0
	end
	return math.max(0, (st.Potions[name] or 0) - (os.clock() - State.receivedAt))
end

return State
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX000636">
          <Properties>
            <string name="Name">UIKit</string>
            <ProtectedString name="Source"><![CDATA[-- Набор деталей интерфейса в стиле макета Figma v2:
-- яркие градиенты, толстая чёрная обводка, текст с обводкой, кнопки «пружинят».

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Sound = require(script.Parent.Sound)

local UIKit = {}

UIKit.lang = "ru"

-- Пары цветов (верх, низ) для градиентов
UIKit.C = {
	Green = { Color3.fromRGB(140, 242, 94), Color3.fromRGB(63, 194, 43) },
	Gold = { Color3.fromRGB(255, 227, 107), Color3.fromRGB(255, 178, 30) },
	Gray = { Color3.fromRGB(154, 160, 176), Color3.fromRGB(94, 99, 114) },
	Lock = { Color3.fromRGB(107, 112, 128), Color3.fromRGB(69, 74, 88) },
	Blue = { Color3.fromRGB(111, 200, 255), Color3.fromRGB(47, 134, 255) },
	Red = { Color3.fromRGB(255, 106, 94), Color3.fromRGB(217, 55, 44) },
	Orange = { Color3.fromRGB(255, 194, 75), Color3.fromRGB(255, 138, 30) },
	Purple = { Color3.fromRGB(213, 139, 255), Color3.fromRGB(143, 61, 255) },
	Pink = { Color3.fromRGB(255, 122, 217), Color3.fromRGB(176, 77, 255) },
	Teal = { Color3.fromRGB(125, 240, 255), Color3.fromRGB(34, 181, 230) },
	Dark = { Color3.fromRGB(74, 79, 105), Color3.fromRGB(38, 42, 59) },
	Lime = { Color3.fromRGB(184, 255, 107), Color3.fromRGB(77, 192, 42) },
}
UIKit.Body = Color3.fromRGB(38, 38, 51)
UIKit.Panel = Color3.fromRGB(27, 27, 36)
UIKit.Cash = Color3.fromRGB(184, 255, 61)
UIKit.BagColor = Color3.fromRGB(127, 216, 255)
UIKit.Yellow = Color3.fromRGB(255, 216, 74)
UIKit.Muted = Color3.fromRGB(190, 196, 214)
UIKit.White = Color3.new(1, 1, 1)
UIKit.Black = Color3.new(0, 0, 0)
UIKit.RedText = Color3.fromRGB(255, 92, 80)

-- Русский — Gotham Black (есть кириллица), английский — Fredoka One (как в топовых играх)
function UIKit.font(weight)
	if UIKit.lang == "en" then
		return Enum.Font.FredokaOne
	end
	if weight == "bold" then
		return Enum.Font.GothamBold
	end
	return Enum.Font.GothamBlack
end

function UIKit.new(className, props, children)
	local inst = Instance.new(className)
	local parent = nil
	for k, v in pairs(props or {}) do
		if k == "Parent" then
			parent = v
		else
			inst[k] = v
		end
	end
	for _, child in ipairs(children or {}) do
		child.Parent = inst
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

function UIKit.tween(obj, time, props, style, direction)
	local t = TweenService:Create(obj, TweenInfo.new(time, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out), props)
	t:Play()
	return t
end

function UIKit.corner(parent, radius)
	return UIKit.new("UICorner", { CornerRadius = UDim.new(0, radius or 14), Parent = parent })
end

function UIKit.stroke(parent, thickness, color, transparency)
	return UIKit.new("UIStroke", {
		Thickness = thickness or 3,
		Color = color or UIKit.Black,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		LineJoinMode = Enum.LineJoinMode.Round,
		Parent = parent,
	})
end

function UIKit.gradient(parent, pair, rotation)
	return UIKit.new("UIGradient", {
		Color = ColorSequence.new(pair[1], pair[2]),
		Rotation = rotation or 90,
		Parent = parent,
	})
end

function UIKit.rainbow(parent)
	return UIKit.new("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 77, 77)),
			ColorSequenceKeypoint.new(0.2, Color3.fromRGB(255, 159, 28)),
			ColorSequenceKeypoint.new(0.4, Color3.fromRGB(255, 225, 77)),
			ColorSequenceKeypoint.new(0.6, Color3.fromRGB(76, 217, 100)),
			ColorSequenceKeypoint.new(0.8, Color3.fromRGB(47, 155, 255)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(176, 92, 255)),
		}),
		Rotation = 0,
		Parent = parent,
	})
end

function UIKit.padding(parent, all, top, right, bottom)
	return UIKit.new("UIPadding", {
		PaddingLeft = UDim.new(0, all),
		PaddingTop = UDim.new(0, top or all),
		PaddingRight = UDim.new(0, right or all),
		PaddingBottom = UDim.new(0, bottom or top or all),
		Parent = parent,
	})
end

function UIKit.list(parent, direction, gap, hAlign, vAlign)
	return UIKit.new("UIListLayout", {
		FillDirection = direction or Enum.FillDirection.Vertical,
		Padding = UDim.new(0, gap or 8),
		HorizontalAlignment = hAlign or Enum.HorizontalAlignment.Center,
		VerticalAlignment = vAlign or Enum.VerticalAlignment.Top,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = parent,
	})
end

function UIKit.frame(props)
	local f = UIKit.new("Frame", {
		Name = props.Name or "Frame",
		BackgroundColor3 = props.Color or UIKit.Panel,
		BackgroundTransparency = props.Transparency or 0,
		BorderSizePixel = 0,
		Size = props.Size or UDim2.fromScale(1, 1),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		LayoutOrder = props.LayoutOrder or 0,
		ZIndex = props.ZIndex or 1,
		Visible = props.Visible ~= false,
		ClipsDescendants = props.Clip == true,
	})
	if props.Corner then
		UIKit.corner(f, props.Corner)
	end
	if props.Stroke then
		UIKit.stroke(f, props.Stroke)
	end
	if props.Gradient then
		UIKit.gradient(f, props.Gradient, props.GradientRotation)
	end
	if props.Parent then
		f.Parent = props.Parent
	end
	return f
end

-- Текст с чёрной обводкой (как в макете)
function UIKit.text(props)
	local label = Instance.new("TextLabel")
	label.Name = props.Name or "Text"
	label.BackgroundTransparency = 1
	label.Size = props.Size or UDim2.fromScale(1, 1)
	label.Position = props.Position or UDim2.new()
	label.AnchorPoint = props.AnchorPoint or Vector2.zero
	label.Font = UIKit.font(props.Weight)
	label.Text = props.Text or ""
	label.TextColor3 = props.Color or UIKit.White
	label.TextScaled = props.Scaled ~= false
	label.TextSize = props.TextSize or 24
	label.TextWrapped = props.Wrapped == true
	label.TextXAlignment = props.XAlign or Enum.TextXAlignment.Center
	label.TextYAlignment = props.YAlign or Enum.TextYAlignment.Center
	label.RichText = props.Rich == true
	label.ZIndex = props.ZIndex or 1
	label.LayoutOrder = props.LayoutOrder or 0
	label.TextTransparency = props.TextTransparency or 0
	if props.AutoX then
		label.AutomaticSize = Enum.AutomaticSize.X
	end
	if props.MaxSize then
		UIKit.new("UITextSizeConstraint", { MaxTextSize = props.MaxSize, MinTextSize = props.MinSize or 8, Parent = label })
	end
	local thick = props.Stroke
	if thick == nil then
		thick = 2.5
	end
	if thick > 0 then
		UIKit.new("UIStroke", {
			Name = "TextStroke",
			Thickness = thick,
			Color = UIKit.Black,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
			LineJoinMode = Enum.LineJoinMode.Round,
			Parent = label,
		})
	end
	if props.Parent then
		label.Parent = props.Parent
	end
	return label
end

-- «Пружинящая» анимация при наведении и нажатии
function UIKit.bounce(btn)
	local scale = btn:FindFirstChildOfClass("UIScale") or UIKit.new("UIScale", { Parent = btn })
	local hovering = false
	btn.MouseEnter:Connect(function()
		hovering = true
		UIKit.tween(scale, 0.12, { Scale = 1.06 })
	end)
	btn.MouseLeave:Connect(function()
		hovering = false
		UIKit.tween(scale, 0.12, { Scale = 1 })
	end)
	btn.MouseButton1Down:Connect(function()
		UIKit.tween(scale, 0.07, { Scale = 0.92 })
	end)
	btn.MouseButton1Up:Connect(function()
		local target = (hovering and UserInputService.MouseEnabled) and 1.06 or 1
		UIKit.tween(scale, 0.25, { Scale = target }, Enum.EasingStyle.Back)
	end)
	return scale
end

-- Кнопка с градиентом, обводкой и бликом
function UIKit.button(props)
	local btn = Instance.new("TextButton")
	btn.Name = props.Name or "Button"
	btn.AutoButtonColor = false
	btn.Text = ""
	btn.BackgroundColor3 = UIKit.White
	btn.Size = props.Size or UDim2.fromOffset(170, 52)
	btn.Position = props.Position or UDim2.new()
	btn.AnchorPoint = props.AnchorPoint or Vector2.zero
	btn.LayoutOrder = props.LayoutOrder or 0
	btn.ZIndex = props.ZIndex or 1
	local radius = props.Corner or 14
	UIKit.corner(btn, radius)
	local grad = UIKit.gradient(btn, props.Colors or UIKit.C.Green, 90)
	UIKit.stroke(btn, props.StrokeThickness or 3)
	local gloss = UIKit.frame({
		Name = "Gloss",
		Color = UIKit.White,
		Transparency = 0.8,
		Size = UDim2.new(1, -8, 0.42, 0),
		Position = UDim2.fromOffset(4, 3),
		ZIndex = btn.ZIndex,
		Corner = math.max(2, radius - 4),
		Parent = btn,
	})
	gloss.Active = false
	local label = UIKit.text({
		Name = "Label",
		Text = props.Text or "",
		Size = UDim2.new(1, -14, 1, -10),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Color = props.TextColor,
		MaxSize = props.MaxSize or 30,
		ZIndex = btn.ZIndex + 1,
		Parent = btn,
	})
	UIKit.bounce(btn)
	if props.OnClick then
		btn.Activated:Connect(function()
			Sound.play("Click", 0.45)
			props.OnClick()
		end)
	end
	if props.Parent then
		btn.Parent = props.Parent
	end
	return btn, label, grad
end

function UIKit.setButton(btn, text, colors)
	local label = btn:FindFirstChild("Label")
	if label and text then
		label.Text = text
	end
	local grad = btn:FindFirstChildOfClass("UIGradient")
	if grad and colors then
		grad.Color = ColorSequence.new(colors[1], colors[2])
	end
end

-- Квадратная кнопка HUD с иконкой и подписью
function UIKit.iconButton(props)
	local btn = Instance.new("TextButton")
	btn.Name = props.Name or "IconButton"
	btn.AutoButtonColor = false
	btn.Text = ""
	btn.BackgroundColor3 = UIKit.White
	btn.Size = props.Size or UDim2.fromOffset(100, 104)
	btn.LayoutOrder = props.LayoutOrder or 0
	UIKit.corner(btn, 22)
	UIKit.gradient(btn, props.Colors or UIKit.C.Dark, 90)
	UIKit.stroke(btn, 4)
	UIKit.text({
		Name = "Icon",
		Text = props.Icon or "⭐",
		Size = UDim2.new(1, -16, 0.6, 0),
		Position = UDim2.new(0.5, 0, 0, 6),
		AnchorPoint = Vector2.new(0.5, 0),
		Stroke = 0,
		Parent = btn,
	})
	UIKit.text({
		Name = "Label",
		Text = props.Text or "",
		Size = UDim2.new(1, -8, 0.28, 0),
		Position = UDim2.new(0.5, 0, 1, -6),
		AnchorPoint = Vector2.new(0.5, 1),
		Color = UIKit.Yellow,
		MaxSize = 20,
		Parent = btn,
	})
	local dot = UIKit.frame({
		Name = "Dot",
		Color = UIKit.White,
		Size = UDim2.fromOffset(30, 30),
		Position = UDim2.new(1, 8, 0, -8),
		AnchorPoint = Vector2.new(1, 0),
		Corner = 15,
		Stroke = 3,
		Gradient = UIKit.C.Red,
		Visible = false,
		ZIndex = 3,
		Parent = btn,
	})
	UIKit.text({ Text = "!", Size = UDim2.fromScale(0.8, 0.8), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 4, Parent = dot })
	UIKit.bounce(btn)
	if props.OnClick then
		btn.Activated:Connect(function()
			Sound.play("Click", 0.45)
			props.OnClick()
		end)
	end
	if props.Parent then
		btn.Parent = props.Parent
	end
	return btn
end

-- Цветная плашка-бейдж («ВЫГОДНО», «ЛЕГЕНДА»…)
function UIKit.badge(parent, text, colors, rainbow)
	local b = UIKit.frame({
		Name = "Badge",
		Color = UIKit.White,
		Size = UDim2.new(0.86, 0, 0, 24),
		Position = UDim2.new(0.5, 0, 0, -13),
		AnchorPoint = Vector2.new(0.5, 0),
		Corner = 12,
		Stroke = 3,
		ZIndex = 5,
		Parent = parent,
	})
	if rainbow then
		UIKit.rainbow(b)
	else
		UIKit.gradient(b, colors or UIKit.C.Blue, 90)
	end
	UIKit.text({ Text = text, Size = UDim2.new(1, -10, 1, -4), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), MaxSize = 15, Stroke = 2, ZIndex = 6, Parent = b })
	return b
end

-- Карточка товара: градиент, название, иконка в кольце, характеристика, кнопка
function UIKit.card(props)
	local card = UIKit.frame({
		Name = props.Name or "Card",
		Color = UIKit.White,
		Size = props.Size or UDim2.fromOffset(176, 236),
		LayoutOrder = props.LayoutOrder or 0,
		Corner = 18,
		Stroke = 4,
		Parent = props.Parent,
	})
	local grad = UIKit.gradient(card, { props.Top, props.Bottom }, 90)
	UIKit.text({ Name = "Title", Text = props.Title or "", Size = UDim2.new(1, -14, 0, 28), Position = UDim2.new(0.5, 0, 0, 12), AnchorPoint = Vector2.new(0.5, 0), MaxSize = 22, Parent = card })
	local ring = UIKit.frame({
		Name = "Ring",
		Color = UIKit.White,
		Transparency = 0.7,
		Size = UDim2.fromOffset(78, 78),
		Position = UDim2.new(0.5, 0, 0, 44),
		AnchorPoint = Vector2.new(0.5, 0),
		Corner = 39,
		Parent = card,
	})
	UIKit.stroke(ring, 3, UIKit.White, 0.45)
	UIKit.text({ Name = "Icon", Text = props.Icon or "⛏", Size = UDim2.fromScale(0.72, 0.72), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), Stroke = 0, Parent = ring })
	local pill = UIKit.frame({
		Name = "Pill",
		Color = UIKit.Black,
		Transparency = 0.62,
		Size = UDim2.new(1, -36, 0, 26),
		Position = UDim2.new(0.5, 0, 0, 130),
		AnchorPoint = Vector2.new(0.5, 0),
		Corner = 13,
		Parent = card,
	})
	UIKit.text({ Name = "Stat", Text = props.Stat or "", Size = UDim2.new(1, -12, 1, -6), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), Weight = "bold", MaxSize = 16, Stroke = 2, Parent = pill })
	local button, label = UIKit.button({
		Name = "Buy",
		Text = props.ButtonText or "",
		Colors = props.ButtonColors or UIKit.C.Green,
		Size = UDim2.new(1, -20, 0, 46),
		Position = UDim2.new(0.5, 0, 1, -10),
		AnchorPoint = Vector2.new(0.5, 1),
		MaxSize = 24,
		OnClick = props.OnClick,
		Parent = card,
	})
	if props.Badge then
		UIKit.badge(card, props.Badge, props.BadgeColors, props.BadgeRainbow)
	end
	return card, button, label, grad
end

-- Полупрозрачная полоска прогресса
function UIKit.bar(props)
	local bar = UIKit.frame({
		Name = props.Name or "Bar",
		Color = props.Back or Color3.fromRGB(20, 20, 28),
		Size = props.Size or UDim2.fromOffset(300, 22),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		LayoutOrder = props.LayoutOrder or 0,
		Corner = props.Corner or 11,
		Stroke = props.Stroke or 3,
		Clip = false,
		Parent = props.Parent,
	})
	local fill = UIKit.frame({
		Name = "Fill",
		Color = UIKit.White,
		Size = UDim2.fromScale(0, 1),
		Corner = props.Corner or 11,
		Parent = bar,
	})
	UIKit.gradient(fill, props.Colors or UIKit.C.Green, 90)
	local label = UIKit.text({ Name = "Label", Text = "", Size = UDim2.new(1, -10, 1, -4), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), Weight = "bold", MaxSize = props.TextMax or 15, Stroke = 2, ZIndex = 3, Parent = bar })
	return bar, fill, label
end

function UIKit.setBar(bar, fraction, text)
	local fill = bar:FindFirstChild("Fill")
	if fill then
		fraction = math.clamp(fraction or 0, 0, 1)
		fill.Visible = fraction > 0.001
		UIKit.tween(fill, 0.25, { Size = UDim2.fromScale(math.max(fraction, 0.04), 1) })
	end
	local label = bar:FindFirstChild("Label")
	if label and text then
		label.Text = text
	end
end

function UIKit.pop(obj, from, time)
	local scale = obj:FindFirstChild("PopScale") or UIKit.new("UIScale", { Name = "PopScale", Parent = obj })
	scale.Scale = from or 0.6
	return UIKit.tween(scale, time or 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
end

-- Экран, который масштабируется под любой размер (дизайн рассчитан на 1280x720)
function UIKit.screen(name, displayOrder)
	local player = Players.LocalPlayer
	local gui = UIKit.new("ScreenGui", {
		Name = name,
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = displayOrder or 1,
		IgnoreGuiInset = false,
	})
	pcall(function()
		gui.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets
	end)
	-- центр корня совпадает с центром экрана, поэтому масштаб не сдвигает интерфейс
	local root = UIKit.frame({ Name = "Root", Transparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Parent = gui })
	local scale = UIKit.new("UIScale", { Name = "Fit", Parent = root })
	local function fit()
		local size = gui.AbsoluteSize
		if size.X < 10 or size.Y < 10 then
			return
		end
		local s = math.clamp(math.min(size.X / 1280, size.Y / 720) * 1.08, 0.45, 1.6)
		scale.Scale = s
		root.Size = UDim2.fromScale(1 / s, 1 / s)
	end
	gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(fit)
	gui.Parent = player:WaitForChild("PlayerGui")
	fit()
	task.defer(fit)
	return gui, root, scale
end

return UIKit
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX000637">
          <Properties>
            <string name="Name">Windows</string>
            <ProtectedString name="Source"><![CDATA[-- Окна: Магазин, Продажа, Премиум, Перерождение, Награды+Коды, Лифт.
-- Стиль как в макете Figma v2: цветная шапка с полосками, красный крестик,
-- карточки с градиентом и бейджами.

local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Economy = require(Shared:WaitForChild("Economy"))
local Locale = require(Shared:WaitForChild("Locale"))
local UIKit = require(script.Parent.UIKit)
local State = require(script.Parent.State)
local HUD = require(script.Parent.HUD)

local Windows = {}

local player = Players.LocalPlayer
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local gui, root
local current = nil
local blur = nil
local onOpenChanged = nil

local function t(key, ...)
	return State.t(key, ...)
end

local function money(n)
	return "$" .. Locale.short(n)
end

function Windows.init(callback)
	onOpenChanged = callback
	gui, root = UIKit.screen("WindowsGui", 10)
	blur = Lighting:FindFirstChild("UIBlur")
	if not blur then
		blur = Instance.new("BlurEffect")
		blur.Name = "UIBlur"
		blur.Size = 0
		blur.Parent = Lighting
	end
end

function Windows.isOpen()
	return current ~= nil
end

function Windows.close()
	if not current then
		return
	end
	local closing = current
	current = nil
	UIKit.tween(blur, 0.25, { Size = 0 })
	UIKit.tween(closing.overlay, 0.2, { BackgroundTransparency = 1 })
	local scale = closing.win:FindFirstChild("PopScale")
	if scale then
		UIKit.tween(scale, 0.18, { Scale = 0.75 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
	end
	task.delay(0.19, function()
		closing.overlay:Destroy()
		closing.win:Destroy()
	end)
	if onOpenChanged then
		onOpenChanged(false)
	end
end

-- Основа окна: затемнение, рамка, шапка с полосками, заголовок, крестик
local function makeWindow(title, colors, width, height)
	UIKit.lang = State.lang
	local overlay = Instance.new("TextButton")
	overlay.Name = "Overlay"
	overlay.Text = ""
	overlay.AutoButtonColor = false
	overlay.BackgroundColor3 = UIKit.Black
	overlay.BackgroundTransparency = 1
	overlay.BorderSizePixel = 0
	overlay.Size = UDim2.fromScale(3, 3)
	overlay.Position = UDim2.fromScale(0.5, 0.5)
	overlay.AnchorPoint = Vector2.new(0.5, 0.5)
	overlay.Parent = root
	UIKit.tween(overlay, 0.25, { BackgroundTransparency = 0.5 })
	overlay.Activated:Connect(function()
		Windows.close()
	end)

	local win = UIKit.frame({
		Name = "Window",
		Color = UIKit.Body,
		Size = UDim2.fromOffset(width, height),
		Position = UDim2.new(0.5, 0, 0.5, 16),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Corner = 22,
		Stroke = 5,
		Parent = root,
	})
	win.Active = true

	local head = UIKit.frame({ Name = "Header", Color = UIKit.White, Size = UDim2.new(1, 0, 0, 84), Corner = 22, Clip = true, Parent = win })
	UIKit.gradient(head, colors, 90)
	local square = UIKit.frame({ Name = "Square", Color = UIKit.White, Size = UDim2.new(1, 0, 0, 30), Position = UDim2.new(0, 0, 1, -30), Parent = head })
	UIKit.gradient(square, { colors[1]:Lerp(colors[2], 0.64), colors[2] }, 90)
	for i = 0, math.ceil(width / 70) + 2 do
		local stripe = UIKit.frame({ Name = "Stripe", Color = UIKit.White, Transparency = 0.86, Size = UDim2.fromOffset(28, 240), Position = UDim2.fromOffset(i * 70 - 80, -70), Parent = head })
		stripe.Rotation = 35
	end
	UIKit.frame({ Name = "Gloss", Color = UIKit.White, Transparency = 0.86, Size = UDim2.new(1, 0, 0, 30), Parent = head })
	UIKit.frame({ Name = "Line", Color = UIKit.Black, Size = UDim2.new(1, 0, 0, 5), Position = UDim2.new(0, 0, 1, -5), Parent = head })
	local titleLabel = UIKit.text({ Name = "Title", Text = title, Size = UDim2.new(1, -120, 0, 58), Position = UDim2.fromOffset(24, 11), XAlign = Enum.TextXAlignment.Left, MaxSize = 46, Stroke = 4, Parent = head })
	UIKit.button({ Name = "Close", Text = "✕", Colors = UIKit.C.Red, Size = UDim2.fromOffset(56, 56), Position = UDim2.new(1, -16, 0, 12), AnchorPoint = Vector2.new(1, 0), MaxSize = 32, OnClick = function()
		Windows.close()
	end, Parent = head })

	local body = UIKit.frame({ Name = "Body", Transparency = 1, Size = UDim2.new(1, -40, 1, -104), Position = UDim2.fromOffset(20, 94), Parent = win })

	UIKit.pop(win, 0.7, 0.32)
	UIKit.tween(blur, 0.3, { Size = 14 })
	return { overlay = overlay, win = win, body = body, title = titleLabel }
end

local function sectionTitle(parent, text, order)
	return UIKit.text({ Text = text, Size = UDim2.new(1, 0, 0, 28), Color = UIKit.Yellow, XAlign = Enum.TextXAlignment.Left, MaxSize = 22, LayoutOrder = order, Parent = parent })
end

local function hint(parent, text, order, height)
	return UIKit.text({ Text = text, Size = UDim2.new(1, 0, 0, height or 44), Color = UIKit.Muted, XAlign = Enum.TextXAlignment.Left, Weight = "bold", MaxSize = 18, Stroke = 0, Wrapped = true, LayoutOrder = order, Parent = parent })
end

---------------------------------------------------------------------
-- МАГАЗИН
---------------------------------------------------------------------
local function buildShop(tab)
	tab = tab or "picks"
	local w = makeWindow(t("ShopTitle"), UIKit.C.Orange, 860, 640)
	local cards = {}

	local tabs = UIKit.frame({ Name = "Tabs", Transparency = 1, Size = UDim2.new(1, 0, 0, 50), Parent = w.body })
	UIKit.list(tabs, Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Left)
	local grid = Instance.new("ScrollingFrame")
	grid.Name = "Grid"
	grid.BackgroundTransparency = 1
	grid.BorderSizePixel = 0
	grid.Size = UDim2.new(1, 0, 1, -110)
	grid.Position = UDim2.fromOffset(0, 58)
	grid.ScrollBarThickness = 8
	grid.ScrollBarImageColor3 = UIKit.Yellow
	grid.CanvasSize = UDim2.new()
	grid.AutomaticCanvasSize = Enum.AutomaticSize.Y
	grid.Parent = w.body
	UIKit.new("UIGridLayout", { CellSize = UDim2.fromOffset(182, 240), CellPadding = UDim2.fromOffset(16, 24), SortOrder = Enum.SortOrder.LayoutOrder, Parent = grid })
	UIKit.padding(grid, 6, 18, 6, 10)
	local balance = UIKit.text({ Name = "Balance", Text = "", Size = UDim2.new(0.6, 0, 0, 40), Position = UDim2.new(0, 0, 1, -6), AnchorPoint = Vector2.new(0, 1), Color = UIKit.Cash, XAlign = Enum.TextXAlignment.Left, MaxSize = 32, Stroke = 3, Parent = w.body })

	local function fill(kind)
		for _, child in ipairs(grid:GetChildren()) do
			if child:IsA("Frame") then
				child:Destroy()
			end
		end
		cards = {}
		local list = kind == "picks" and Config.Pickaxes or Config.Backpacks
		for i, item in ipairs(list) do
			local stat
			if kind == "picks" then
				stat = t("Power", tostring(item.Power))
			else
				stat = t("Capacity", tostring(item.Capacity))
			end
			local badge, badgeColors, rainbow = nil, nil, false
			if i == #list then
				badge, rainbow = t("Legend"), true
			end
			local card, button = UIKit.card({
				Name = "Item" .. i,
				Title = State.name(item.Name),
				Icon = item.Icon,
				Stat = stat,
				Top = item.Top,
				Bottom = item.Bottom,
				LayoutOrder = i,
				Badge = badge,
				BadgeColors = badgeColors,
				BadgeRainbow = rainbow,
				OnClick = function()
					local st = State.data
					if not st then
						return
					end
					local owned = kind == "picks" and st.Pickaxe or st.Backpack
					if i > owned then
						Remotes.Action:FireServer(kind == "picks" and "BuyPickaxe" or "BuyBackpack", i)
					end
				end,
				Parent = grid,
			})
			cards[i] = { card = card, button = button, price = item.Price }
		end
		grid.CanvasPosition = Vector2.zero
	end

	local tabButtons = {}
	local function selectTab(kind)
		tab = kind
		w.arg = kind
		for k, b in pairs(tabButtons) do
			UIKit.setButton(b, nil, k == kind and UIKit.C.Orange or UIKit.C.Lock)
		end
		fill(kind)
		if current and current.refresh then
			current.refresh(State.data)
		end
	end
	tabButtons.picks = UIKit.button({ Text = t("TabPicks"), Colors = UIKit.C.Orange, Size = UDim2.fromOffset(200, 48), MaxSize = 22, LayoutOrder = 1, OnClick = function() selectTab("picks") end, Parent = tabs })
	tabButtons.bags = UIKit.button({ Text = t("TabBags"), Colors = UIKit.C.Lock, Size = UDim2.fromOffset(220, 48), MaxSize = 22, LayoutOrder = 2, OnClick = function() selectTab("bags") end, Parent = tabs })

	w.refresh = function(st)
		if not st then
			return
		end
		balance.Text = "💰 " .. money(st.Cash)
		local owned = tab == "picks" and st.Pickaxe or st.Backpack
		local nextBadgeSet = false
		for i, c in pairs(cards) do
			if i < owned then
				UIKit.setButton(c.button, t("Have"), UIKit.C.Gray)
			elseif i == owned then
				UIKit.setButton(c.button, t("Equipped"), UIKit.C.Gold)
			elseif st.Cash >= c.price then
				UIKit.setButton(c.button, money(c.price), UIKit.C.Green)
			else
				UIKit.setButton(c.button, "🔒 " .. money(c.price), UIKit.C.Lock)
			end
			-- бейдж «СЛЕДУЮЩАЯ» на ближайшей покупке
			local existing = c.card:FindFirstChild("NextBadge")
			local shouldHave = (i == owned + 1) and not nextBadgeSet and i ~= #Config.Pickaxes
			if shouldHave then
				nextBadgeSet = true
				if not existing and not c.card:FindFirstChild("Badge") then
					local b = UIKit.badge(c.card, t("Next"), UIKit.C.Blue)
					b.Name = "NextBadge"
				end
			elseif existing then
				existing:Destroy()
			end
		end
	end
	w.arg = tab
	current = w
	selectTab(tab)
	return w
end

---------------------------------------------------------------------
-- ПРОДАЖА
---------------------------------------------------------------------
local function buildSell()
	local w = makeWindow(t("SellTitle"), UIKit.C.Red, 760, 560)
	local top = UIKit.frame({ Name = "Top", Color = UIKit.Panel, Size = UDim2.new(1, 0, 0, 100), Corner = 16, Stroke = 3, Parent = w.body })
	UIKit.text({ Text = t("BagValue"), Size = UDim2.new(0.55, 0, 0, 24), Position = UDim2.fromOffset(18, 12), Color = UIKit.Muted, XAlign = Enum.TextXAlignment.Left, Weight = "bold", MaxSize = 17, Stroke = 0, Parent = top })
	local value = UIKit.text({ Text = "", Size = UDim2.new(0.55, 0, 0, 50), Position = UDim2.fromOffset(18, 38), Color = UIKit.Cash, XAlign = Enum.TextXAlignment.Left, MaxSize = 40, Stroke = 3.5, Parent = top })
	local sellBtn = UIKit.button({ Text = t("SellAll"), Colors = UIKit.C.Green, Size = UDim2.fromOffset(270, 64), Position = UDim2.new(1, -16, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5), MaxSize = 28, OnClick = function()
		local st = State.data
		if st and st.Passes.SellAnywhere then
			Remotes.Action:FireServer("Sell")
		else
			HUD.toast(t("GoToSell"))
			local pass = Config.FindPass("SellAnywhere")
			if pass and pass.Id ~= 0 then
				MarketplaceService:PromptGamePassPurchase(player, pass.Id)
			end
		end
	end, Parent = top })

	local list = Instance.new("ScrollingFrame")
	list.Name = "Ores"
	list.BackgroundTransparency = 1
	list.BorderSizePixel = 0
	list.Size = UDim2.new(1, 0, 1, -190)
	list.Position = UDim2.fromOffset(0, 114)
	list.ScrollBarThickness = 8
	list.CanvasSize = UDim2.new()
	list.AutomaticCanvasSize = Enum.AutomaticSize.Y
	list.Parent = w.body
	UIKit.new("UIGridLayout", { CellSize = UDim2.fromOffset(226, 52), CellPadding = UDim2.fromOffset(10, 10), SortOrder = Enum.SortOrder.LayoutOrder, Parent = list })
	UIKit.padding(list, 4)
	local empty = UIKit.text({ Text = t("Empty"), Size = UDim2.new(1, 0, 0, 50), Position = UDim2.fromOffset(0, 170), Color = UIKit.Muted, MaxSize = 28, Visible = false, Parent = w.body })
	hint(w.body, t("SellHint"), 1, 52).Position = UDim2.new(0, 0, 1, -56)

	local signature = nil
	w.refresh = function(st)
		if not st then
			return
		end
		local total = math.floor(Economy.inventoryValue(st.Inv) * st.Mult)
		value.Text = "💰 $" .. Locale.full(total)
		if st.Passes.SellAnywhere then
			UIKit.setButton(sellBtn, t("SellAll"), UIKit.C.Green)
		else
			UIKit.setButton(sellBtn, t("GoSellCircle"), UIKit.C.Lock)
		end
		local parts = {}
		for id, n in pairs(st.Inv) do
			table.insert(parts, id .. n)
		end
		table.sort(parts)
		local sig = table.concat(parts, ",")
		if sig == signature then
			return
		end
		signature = sig
		for _, child in ipairs(list:GetChildren()) do
			if child:IsA("Frame") then
				child:Destroy()
			end
		end
		local order = 0
		for li, layer in ipairs(Config.Layers) do
			for k, ore in ipairs({ layer.Common, layer.Rare }) do
				local n = st.Inv[ore.Id]
				if n and n > 0 then
					order = order + 1
					local chip = UIKit.frame({ Name = ore.Id, Color = Color3.fromRGB(48, 48, 62), Corner = 14, Stroke = 3, LayoutOrder = li * 10 + k, Parent = list })
					UIKit.text({ Text = ore.Emoji, Size = UDim2.fromOffset(34, 34), Position = UDim2.new(0, 10, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), Stroke = 0, Parent = chip })
					UIKit.text({ Text = State.name(ore.Name) .. " ×" .. n, Size = UDim2.new(1, -120, 0, 28), Position = UDim2.new(0, 50, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), XAlign = Enum.TextXAlignment.Left, Weight = "bold", MaxSize = 18, Stroke = 2, Parent = chip })
					UIKit.text({ Text = money(ore.Value * n * st.Mult), Size = UDim2.new(0, 70, 0, 26), Position = UDim2.new(1, -10, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5), Color = UIKit.Cash, XAlign = Enum.TextXAlignment.Right, MaxSize = 17, Stroke = 2, Parent = chip })
				end
			end
		end
		empty.Visible = order == 0
	end
	current = w
	return w
end

---------------------------------------------------------------------
-- ПРЕМИУМ
---------------------------------------------------------------------
local BADGES = {
	Hit = { "Badge_Hit", UIKit.C.Red, false },
	Best = { "Badge_Best", nil, true },
	Good = { "Badge_Good", UIKit.C.Blue, false },
	Great = { "Badge_Great", UIKit.C.Orange, false },
	Most = { "Badge_Most", nil, true },
}

local function buildPremium()
	local w = makeWindow(t("PremiumTitle"), UIKit.C.Purple, 1060, 680)
	UIKit.list(w.body, Enum.FillDirection.Vertical, 6, Enum.HorizontalAlignment.Left)
	local passButtons = {}

	sectionTitle(w.body, t("PassesHeader"), 1)
	local row1 = UIKit.frame({ Name = "Passes", Transparency = 1, Size = UDim2.new(1, 0, 0, 252), LayoutOrder = 2, Parent = w.body })
	UIKit.list(row1, Enum.FillDirection.Horizontal, 12, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Bottom)
	for i, pass in ipairs(Config.GamePasses) do
		local b = pass.Badge and BADGES[pass.Badge]
		local _, button = UIKit.card({
			Name = pass.Key,
			Title = State.name(pass.Name),
			Icon = pass.Icon,
			Stat = State.name(pass.Desc),
			Top = pass.Top,
			Bottom = pass.Bottom,
			Size = UDim2.fromOffset(134, 232),
			LayoutOrder = i,
			ButtonText = "R$ " .. pass.Price,
			Badge = b and t(b[1]) or nil,
			BadgeColors = b and b[2] or nil,
			BadgeRainbow = b and b[3] or false,
			OnClick = function()
				local st = State.data
				if st and st.Passes[pass.Key] then
					return
				end
				if pass.Id == 0 then
					HUD.toast(t("Soon"))
				else
					MarketplaceService:PromptGamePassPurchase(player, pass.Id)
				end
			end,
			Parent = row1,
		})
		passButtons[pass.Key] = { button = button, pass = pass }
	end

	sectionTitle(w.body, t("ProductsHeader"), 3)
	local row2 = UIKit.frame({ Name = "Products", Transparency = 1, Size = UDim2.new(1, 0, 0, 252), LayoutOrder = 4, Parent = w.body })
	UIKit.list(row2, Enum.FillDirection.Horizontal, 12, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Bottom)
	for i, product in ipairs(Config.Products) do
		local b = product.Badge and BADGES[product.Badge]
		local stat = State.name(product.Desc)
		if product.Cash then
			stat = "+$" .. Locale.short(Economy.cashPackAmount(product.Cash, State.data and State.data.Rebirths or 0))
		end
		UIKit.card({
			Name = product.Key,
			Title = State.name(product.Name),
			Icon = product.Icon,
			Stat = stat,
			Top = product.Top,
			Bottom = product.Bottom,
			Size = UDim2.fromOffset(152, 232),
			LayoutOrder = i,
			ButtonText = "R$ " .. product.Price,
			ButtonColors = UIKit.C.Blue,
			Badge = b and t(b[1]) or nil,
			BadgeColors = b and b[2] or nil,
			BadgeRainbow = b and b[3] or false,
			OnClick = function()
				if product.Id == 0 then
					HUD.toast(t("Soon"))
				else
					MarketplaceService:PromptProductPurchase(player, product.Id)
				end
			end,
			Parent = row2,
		})
	end

	w.refresh = function(st)
		if not st then
			return
		end
		for key, entry in pairs(passButtons) do
			if st.Passes[key] then
				UIKit.setButton(entry.button, t("Owned"), UIKit.C.Gray)
			else
				UIKit.setButton(entry.button, "R$ " .. entry.pass.Price, UIKit.C.Green)
			end
		end
	end
	current = w
	return w
end

---------------------------------------------------------------------
-- ПЕРЕРОЖДЕНИЕ
---------------------------------------------------------------------
local function buildRebirth()
	local w = makeWindow(t("RebirthTitle"), UIKit.C.Pink, 640, 520)
	UIKit.list(w.body, Enum.FillDirection.Vertical, 14, Enum.HorizontalAlignment.Center)
	hint(w.body, t("RebirthInfo"), 1, 56)
	local row = UIKit.frame({ Name = "Mult", Transparency = 1, Size = UDim2.new(1, 0, 0, 70), LayoutOrder = 2, Parent = w.body })
	UIKit.list(row, Enum.FillDirection.Horizontal, 16, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
	local nowChip = UIKit.frame({ Color = UIKit.Panel, Size = UDim2.fromOffset(220, 62), Corner = 16, Stroke = 3, LayoutOrder = 1, Parent = row })
	local nowText = UIKit.text({ Text = "", Size = UDim2.new(1, -16, 1, -12), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), MaxSize = 28, Parent = nowChip })
	UIKit.text({ Text = "➜", Size = UDim2.fromOffset(44, 44), Color = UIKit.Yellow, LayoutOrder = 2, Parent = row })
	local afterChip = UIKit.frame({ Color = UIKit.White, Size = UDim2.fromOffset(220, 62), Corner = 16, Stroke = 3, Gradient = UIKit.C.Purple, LayoutOrder = 3, Parent = row })
	local afterText = UIKit.text({ Text = "", Size = UDim2.new(1, -16, 1, -12), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), MaxSize = 28, Parent = afterChip })
	local count = UIKit.text({ Text = "", Size = UDim2.new(1, 0, 0, 30), Color = UIKit.Yellow, MaxSize = 24, LayoutOrder = 3, Parent = w.body })
	local bar = UIKit.bar({ Size = UDim2.new(1, -40, 0, 32), Colors = UIKit.C.Gold, TextMax = 18, LayoutOrder = 4, Parent = w.body })
	local button = UIKit.button({ Text = "", Colors = UIKit.C.Purple, Size = UDim2.new(1, -40, 0, 66), MaxSize = 30, LayoutOrder = 5, OnClick = function()
		local st = State.data
		if st and st.Cash >= Economy.rebirthCost(st.Rebirths) then
			Windows.close()
			Remotes.Action:FireServer("Rebirth")
		end
	end, Parent = w.body })

	w.refresh = function(st)
		if not st then
			return
		end
		local cost = Economy.rebirthCost(st.Rebirths)
		nowText.Text = t("Now", tostring(Economy.rebirthMultiplier(st.Rebirths)))
		afterText.Text = t("After", tostring(Economy.rebirthMultiplier(st.Rebirths + 1)))
		count.Text = t("RebirthCount", tostring(st.Rebirths))
		UIKit.setBar(bar, st.Cash / cost, money(st.Cash) .. " / " .. money(cost))
		if st.Cash >= cost then
			UIKit.setButton(button, t("RebirthBtn", Locale.short(cost)), UIKit.C.Purple)
		else
			UIKit.setButton(button, t("RebirthNeed", Locale.short(cost)), UIKit.C.Lock)
		end
	end
	current = w
	return w
end

---------------------------------------------------------------------
-- НАГРАДЫ И КОДЫ
---------------------------------------------------------------------
local function buildDaily()
	local w = makeWindow(t("DailyTitle"), UIKit.C.Lime, 860, 580)
	UIKit.list(w.body, Enum.FillDirection.Vertical, 12, Enum.HorizontalAlignment.Center)
	hint(w.body, t("DailySub"), 1, 50)
	local row = UIKit.frame({ Name = "Days", Transparency = 1, Size = UDim2.new(1, 0, 0, 140), LayoutOrder = 2, Parent = w.body })
	UIKit.list(row, Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
	local days = {}
	for i = 1, #Config.Daily do
		local card = UIKit.frame({ Name = "Day" .. i, Color = UIKit.White, Size = UDim2.fromOffset(104, 134), Corner = 16, LayoutOrder = i, Parent = row })
		local grad = UIKit.gradient(card, { Color3.fromRGB(62, 66, 90), Color3.fromRGB(36, 38, 54) }, 90)
		local stroke = UIKit.stroke(card, 3)
		local dayLabel = UIKit.text({ Text = t("Day", tostring(i)), Size = UDim2.new(1, -10, 0, 22), Position = UDim2.new(0.5, 0, 0, 8), AnchorPoint = Vector2.new(0.5, 0), Color = UIKit.Muted, Weight = "bold", MaxSize = 17, Stroke = 2, Parent = card })
		UIKit.text({ Text = Config.Daily[i].Icon, Size = UDim2.fromOffset(52, 52), Position = UDim2.new(0.5, 0, 0, 34), AnchorPoint = Vector2.new(0.5, 0), Stroke = 0, Parent = card })
		local reward = UIKit.text({ Text = "", Size = UDim2.new(1, -10, 0, 26), Position = UDim2.new(0.5, 0, 1, -8), AnchorPoint = Vector2.new(0.5, 1), MaxSize = 18, Stroke = 2, Parent = card })
		days[i] = { card = card, grad = grad, stroke = stroke, day = dayLabel, reward = reward }
	end
	local claim = UIKit.button({ Text = "", Colors = UIKit.C.Green, Size = UDim2.new(1, -60, 0, 62), MaxSize = 28, LayoutOrder = 3, OnClick = function()
		local st = State.data
		if st and st.Daily.CanClaim then
			Remotes.Action:FireServer("ClaimDaily")
		end
	end, Parent = w.body })

	sectionTitle(w.body, t("Codes"), 4)
	local codeRow = UIKit.frame({ Name = "Code", Transparency = 1, Size = UDim2.new(1, 0, 0, 56), LayoutOrder = 5, Parent = w.body })
	local box = Instance.new("TextBox")
	box.Name = "Input"
	box.Size = UDim2.new(1, -150, 1, 0)
	box.BackgroundColor3 = Color3.fromRGB(16, 16, 22)
	box.BorderSizePixel = 0
	box.ClearTextOnFocus = false
	box.Text = ""
	box.PlaceholderText = t("CodePlaceholder")
	box.PlaceholderColor3 = Color3.fromRGB(110, 115, 135)
	box.TextColor3 = UIKit.White
	box.Font = UIKit.font("bold")
	box.TextScaled = true
	box.TextXAlignment = Enum.TextXAlignment.Left
	UIKit.corner(box, 12)
	UIKit.stroke(box, 3)
	UIKit.padding(box, 16, 10)
	UIKit.new("UITextSizeConstraint", { MaxTextSize = 24, Parent = box })
	box.Parent = codeRow
	UIKit.button({ Text = t("Ok"), Colors = UIKit.C.Blue, Size = UDim2.fromOffset(130, 56), Position = UDim2.new(1, 0, 0, 0), AnchorPoint = Vector2.new(1, 0), MaxSize = 26, OnClick = function()
		if #box.Text > 0 then
			Remotes.Action:FireServer("Redeem", box.Text)
			box.Text = ""
		end
	end, Parent = codeRow })

	w.refresh = function(st)
		if not st then
			return
		end
		local daily = st.Daily
		local highlight, claimedUpTo
		if daily.CanClaim then
			highlight = daily.Day
			claimedUpTo = daily.Day - 1
		else
			claimedUpTo = daily.Streak > 0 and ((daily.Streak - 1) % #Config.Daily) + 1 or 0
			highlight = nil
		end
		for i, d in ipairs(days) do
			local reward = Economy.dailyReward(i, st.Rebirths, st.Pickaxe)
			local text = ""
			if reward.Cash > 0 then
				text = "$" .. Locale.short(reward.Cash)
			end
			if reward.Potion then
				text = (text ~= "" and (text .. "+") or "") .. t(reward.Potion)
			end
			d.reward.Text = text
			d.card.BackgroundTransparency = 0
			if i <= claimedUpTo then
				d.day.Text = "✓ " .. t("Day", tostring(i))
				d.grad.Color = ColorSequence.new(Color3.fromRGB(46, 120, 60), Color3.fromRGB(28, 70, 38))
				d.stroke.Color = UIKit.Black
				d.stroke.Thickness = 3
			elseif i == highlight then
				d.day.Text = t("Day", tostring(i))
				d.grad.Color = ColorSequence.new(Color3.fromRGB(255, 214, 90), Color3.fromRGB(230, 140, 20))
				d.stroke.Color = UIKit.White
				d.stroke.Thickness = 4
			else
				d.day.Text = t("Day", tostring(i))
				d.grad.Color = ColorSequence.new(Color3.fromRGB(62, 66, 90), Color3.fromRGB(36, 38, 54))
				d.stroke.Color = UIKit.Black
				d.stroke.Thickness = 3
			end
		end
		if daily.CanClaim then
			UIKit.setButton(claim, t("Claim", tostring(daily.Day)), UIKit.C.Green)
		else
			UIKit.setButton(claim, t("ComeBack", Locale.duration(State.lang, daily.NextIn)), UIKit.C.Lock)
		end
	end
	current = w
	return w
end

---------------------------------------------------------------------
-- ЛИФТ
---------------------------------------------------------------------
local function buildElevator()
	local w = makeWindow(t("ElevatorTitle"), UIKit.C.Gold, 760, 640)
	UIKit.list(w.body, Enum.FillDirection.Vertical, 10, Enum.HorizontalAlignment.Center)
	hint(w.body, t("ElevatorSub"), 1, 30)
	local rows = {}
	for i, layer in ipairs(Config.Layers) do
		local row = UIKit.frame({ Name = layer.Id, Color = UIKit.Panel, Size = UDim2.new(1, 0, 0, 64), Corner = 14, Stroke = 3, LayoutOrder = 1 + i, Parent = w.body })
		local swatch = UIKit.frame({ Color = layer.Color, Size = UDim2.fromOffset(48, 48), Position = UDim2.new(0, 8, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), Corner = 10, Stroke = 3, Parent = row })
		UIKit.text({ Text = layer.Emoji, Size = UDim2.fromScale(0.75, 0.75), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), Stroke = 0, Parent = swatch })
		UIKit.text({ Text = State.name(layer.Name), Size = UDim2.new(1, -310, 0, 28), Position = UDim2.fromOffset(68, 6), XAlign = Enum.TextXAlignment.Left, MaxSize = 22, Parent = row })
		UIKit.text({ Text = t("Range", tostring(layer.From), tostring(layer.To)), Size = UDim2.new(1, -310, 0, 22), Position = UDim2.fromOffset(68, 36), XAlign = Enum.TextXAlignment.Left, Color = UIKit.Muted, Weight = "bold", MaxSize = 16, Stroke = 0, Parent = row })
		local button = UIKit.button({ Text = "", Colors = UIKit.C.Green, Size = UDim2.fromOffset(220, 48), Position = UDim2.new(1, -8, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5), MaxSize = 20, OnClick = function()
			local st = State.data
			if not st then
				return
			end
			if st.Layers[layer.Id] and Config.Pickaxes[st.Pickaxe].Power >= layer.MinPower then
				Windows.close()
				Remotes.Action:FireServer("Elevator", i)
			end
		end, Parent = row })
		rows[i] = { button = button, layer = layer }
	end
	UIKit.button({ Text = t("SurfaceBtn"), Colors = UIKit.C.Blue, Size = UDim2.new(1, -120, 0, 52), MaxSize = 24, LayoutOrder = 20, OnClick = function()
		Windows.close()
		Remotes.Action:FireServer("Surface")
	end, Parent = w.body })

	w.refresh = function(st)
		if not st then
			return
		end
		local power = Config.Pickaxes[st.Pickaxe].Power
		for _, r in ipairs(rows) do
			if not st.Layers[r.layer.Id] then
				UIKit.setButton(r.button, t("Locked"), UIKit.C.Lock)
			elseif power < r.layer.MinPower then
				local need = Config.Pickaxes[Config.PickaxeForPower(r.layer.MinPower)]
				UIKit.setButton(r.button, t("NeedPick", State.name(need.Name)), UIKit.C.Gray)
			else
				UIKit.setButton(r.button, t("Go"), UIKit.C.Green)
			end
		end
	end
	current = w
	return w
end

local builders = {
	Shop = buildShop,
	Sell = buildSell,
	Premium = buildPremium,
	Rebirth = buildRebirth,
	Daily = buildDaily,
	Elevator = buildElevator,
}

function Windows.open(kind, arg)
	local builder = builders[kind]
	if not builder then
		return
	end
	if current then
		local old = current
		current = nil
		old.overlay:Destroy()
		old.win:Destroy()
	end
	local w = builder(arg)
	w.kind = kind
	w.arg = w.arg or arg
	current = w
	if w.refresh then
		w.refresh(State.data)
	end
	if onOpenChanged then
		onOpenChanged(true)
	end
end

function Windows.toggle(kind, arg)
	if current and current.kind == kind and (arg == nil or current.arg == arg) then
		Windows.close()
	else
		Windows.open(kind, arg)
	end
end

function Windows.refresh(st)
	if current and current.refresh then
		current.refresh(st)
	end
end

function Windows.relocalize()
	if current then
		Windows.open(current.kind, current.arg)
	end
end

return Windows
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX000638">
          <Properties>
            <string name="Name">World</string>
            <ProtectedString name="Source"><![CDATA[-- Мир: надписи на табличках (на языке игрока), подписи над кругами
-- «встань в круг», открытие окон при входе в круг, вращающиеся кристаллы и монеты.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local UIKit = require(script.Parent.UIKit)
local State = require(script.Parent.State)

local World = {}

local player = Players.LocalPlayer
local signs = {} -- { part, key, gui }
local pads = {} -- { part, kind, gui, inside }
local spinners = {} -- { part, base, speed, bob }
local container = nil
local onPad = nil

local SIGN_COLORS = {
	Title = Color3.fromRGB(255, 220, 70),
	Sub = Color3.fromRGB(255, 255, 255),
	Mine = Color3.fromRGB(255, 220, 70),
}

local function t(key, ...)
	return State.t(key, ...)
end

local function map()
	return workspace:FindFirstChild("Map")
end

local function buildSign(entry)
	if entry.gui then
		entry.gui:Destroy()
	end
	local part = entry.part
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Sign_" .. entry.key
	gui.Adornee = part
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 24
	gui.LightInfluence = 0
	gui.Brightness = 1.2
	gui.ZOffset = 1
	gui.Parent = container
	UIKit.text({
		Text = t("Sign_" .. entry.key),
		Size = UDim2.fromScale(0.94, 0.86),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Color = SIGN_COLORS[entry.key] or UIKit.White,
		Stroke = 6,
		Parent = gui,
	})
	entry.gui = gui
end

local function buildPadLabel(entry)
	if entry.gui then
		entry.gui:Destroy()
	end
	local cfg = Config.Pads[entry.kind]
	local gui = Instance.new("BillboardGui")
	gui.Name = "Pad_" .. entry.kind
	gui.Adornee = entry.part
	gui.Size = UDim2.fromOffset(260, 120)
	gui.StudsOffsetWorldSpace = Vector3.new(0, 8, 0)
	gui.LightInfluence = 0
	gui.MaxDistance = 140
	gui.Parent = container
	UIKit.text({ Name = "Icon", Text = cfg and cfg.Icon or "⭐", Size = UDim2.fromOffset(56, 56), Position = UDim2.new(0.5, 0, 0, 0), AnchorPoint = Vector2.new(0.5, 0), Stroke = 0, Parent = gui })
	UIKit.text({ Name = "Title", Text = t("Pad_" .. entry.kind), Size = UDim2.new(1, 0, 0, 36), Position = UDim2.new(0.5, 0, 0, 56), AnchorPoint = Vector2.new(0.5, 0), Color = cfg and cfg.Color:Lerp(Color3.new(1, 1, 1), 0.35) or UIKit.White, Stroke = 4, Parent = gui })
	UIKit.text({ Name = "Hint", Text = "⬇ " .. t("StepIn") .. " ⬇", Size = UDim2.new(1, 0, 0, 24), Position = UDim2.new(0.5, 0, 0, 94), AnchorPoint = Vector2.new(0.5, 0), Weight = "bold", Stroke = 3, Parent = gui })
	entry.gui = gui
end

function World.refreshTexts()
	UIKit.lang = State.lang
	for _, entry in ipairs(signs) do
		buildSign(entry)
	end
	for _, entry in ipairs(pads) do
		buildPadLabel(entry)
	end
end

local function scan()
	local m = map()
	if not m then
		return
	end
	for _, item in ipairs(m:GetDescendants()) do
		if item:IsA("StringValue") and item.Parent:IsA("BasePart") then
			if item.Name == "SignKey" then
				table.insert(signs, { part = item.Parent, key = item.Value })
			elseif item.Name == "PadKind" then
				table.insert(pads, { part = item.Parent, kind = item.Value, inside = false })
			elseif item.Name == "Spin" then
				local speed = tonumber(item.Value) or 1
				table.insert(spinners, { part = item.Parent, base = item.Parent.CFrame, speed = speed, phase = math.random() * 6 })
			end
		end
	end
end

function World.init(padCallback)
	onPad = padCallback
	container = Instance.new("Folder")
	container.Name = "WorldLabels"
	container.Parent = player:WaitForChild("PlayerGui")
	if not map() then
		workspace:WaitForChild("Map", 15)
	end
	scan()
	World.refreshTexts()

	-- круги: открыть окно, когда игрок встал в круг
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		local now = os.clock()
		for _, s in ipairs(spinners) do
			if s.part.Parent then
				local angle = now * s.speed + s.phase
				s.part.CFrame = s.base * CFrame.new(0, math.sin(angle * 1.3) * 0.6, 0) * CFrame.Angles(0, angle, 0)
			end
		end
		acc = acc + dt
		if acc < 0.15 then
			return
		end
		acc = 0
		local char = player.Character
		local rootPart = char and char:FindFirstChild("HumanoidRootPart")
		if not rootPart then
			return
		end
		for _, pad in ipairs(pads) do
			local delta = rootPart.Position - pad.part.Position
			local flat = Vector3.new(delta.X, 0, delta.Z).Magnitude
			local inside = flat <= Config.PadRadius and math.abs(delta.Y) < 8
			if inside and not pad.inside and onPad then
				onPad(pad.kind)
			end
			pad.inside = inside
		end
	end)
end

return World
]]></ProtectedString>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="StarterGui" referent="RBX000639">
    <Properties>
      <string name="Name">StarterGui</string>
    </Properties>
  </Item>
</roblox>
