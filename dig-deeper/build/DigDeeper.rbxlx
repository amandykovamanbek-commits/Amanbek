	{ Key = "ChestOfCash", Id = 0, Price = 75, Icon = "🧰", Cash = 1000000, Name = { ru = "Сундук монет", en = "Chest of Cash" }, Desc = { ru = "+$1M", en = "+$1M" }, Top = Color3.fromRGB(140, 242, 94), Bottom = Color3.fromRGB(63, 194, 43), Badge = "Most" },
	{ Key = "DeepTeleport", Id = 0, Price = 5, Icon = "⬇", Name = { ru = "Телепорт вниз", en = "Deep Teleport" }, Desc = { ru = "к рекорду", en = "to your record" }, Top = Color3.fromRGB(111, 200, 255), Bottom = Color3.fromRGB(47, 134, 255) },
	{ Key = "SpeedPotion", Id = 0, Price = 9, Icon = "🧪", Potion = "Speed", Name = { ru = "Зелье скорости", en = "Speed Potion" }, Desc = { ru = "x2 · 15 мин", en = "x2 · 15 min" }, Top = Color3.fromRGB(255, 227, 107), Bottom = Color3.fromRGB(255, 178, 30) },
	{ Key = "LuckPotion", Id = 0, Price = 10, Icon = "🍀", Potion = "Luck", Name = { ru = "Зелье удачи", en = "Luck Potion" }, Desc = { ru = "x3 · 15 мин", en = "x3 · 15 min" }, Top = Color3.fromRGB(124, 240, 160), Bottom = Color3.fromRGB(46, 175, 94) },
}
Config.PotionSeconds = 15 * 60

---------------------------------------------------------------------
-- ЕЖЕДНЕВНЫЕ НАГРАДЫ (7 дней по кругу). Деньги умножаются на
-- (1 + перерождения) x номер кирки — награда растёт вместе с игроком.
---------------------------------------------------------------------
Config.Daily = {
	{ Icon = "💰", Cash = 500 },
	{ Icon = "💰", Cash = 1000 },
	{ Icon = "🧪", Potion = "Speed" },
	{ Icon = "💰", Cash = 2500 },
	{ Icon = "🍀", Potion = "Luck" },
	{ Icon = "💰", Cash = 10000 },
	{ Icon = "🧰", Cash = 25000, Potion = "Luck" },
}
Config.DailyCooldownHours = 20 -- через сколько часов можно забрать следующую
Config.DailyStreakHours = 48 -- если не зашёл дольше — серия сбрасывается

---------------------------------------------------------------------
-- КОДЫ (пиши в описании игры и в видео). Регистр не важен.
---------------------------------------------------------------------
Config.Codes = {
	RELEASE = { Cash = 1000 },
	DIGDEEP = { Cash = 2500 },
	LUCKY = { Potion = "Luck" },
}

---------------------------------------------------------------------
-- ЗВУКИ. Можно заменить на любые из Creator Store: "rbxassetid://123456".
-- Music = "" — без музыки. Вставь Id трека, чтобы играла фоновая музыка.
---------------------------------------------------------------------
Config.Sounds = {
	Swing = "rbxasset://sounds/swordslash.wav",
	Hit = "rbxasset://sounds/collide.wav",
	Coin = "rbxasset://sounds/electronicpingshort.wav",
	Click = "rbxasset://sounds/clickfast.wav",
	Reward = "rbxasset://sounds/electronicpingshort.wav",
	Error = "rbxasset://sounds/clickfast.wav",
	Music = "",
}

-- Круги «встань в круг»: цвет и иконка
Config.Pads = {
	Sell = { Color = Color3.fromRGB(255, 84, 70), Icon = "💰" },
	PickShop = { Color = Color3.fromRGB(255, 160, 40), Icon = "⛏" },
	BagShop = { Color = Color3.fromRGB(60, 150, 255), Icon = "🎒" },
	Rebirth = { Color = Color3.fromRGB(180, 90, 255), Icon = "🔄" },
	Elevator = { Color = Color3.fromRGB(255, 200, 40), Icon = "🛗" },
	Daily = { Color = Color3.fromRGB(80, 220, 70), Icon = "🎁" },
}
Config.PadRadius = 9

---------------------------------------------------------------------
-- Служебное (не меняй)
---------------------------------------------------------------------
Config.Ores = {}
for _, layer in ipairs(Config.Layers) do
	Config.Ores[layer.Common.Id] = layer.Common
	Config.Ores[layer.Rare.Id] = layer.Rare
end

function Config.LayerForDepth(depth)
	for i, layer in ipairs(Config.Layers) do
		if depth >= layer.From and depth < layer.To then
			return layer, i
		end
	end
	return Config.Layers[#Config.Layers], #Config.Layers
end

function Config.LayerIndexById(id)
	for i, layer in ipairs(Config.Layers) do
		if layer.Id == id then
			return i
		end
	end
	return nil
end

-- Минимальная кирка, которая берёт слой с нужной силой
function Config.PickaxeForPower(power)
	for i, p in ipairs(Config.Pickaxes) do
		if p.Power >= power then
			return i
		end
	end
	return #Config.Pickaxes
end

function Config.FindPass(key)
	for _, p in ipairs(Config.GamePasses) do
		if p.Key == key then
			return p
		end
	end
	return nil
end

function Config.FindProduct(key)
	for _, p in ipairs(Config.Products) do
		if p.Key == key then
			return p
		end
	end
	return nil
end

return Config
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX000620">
        <Properties>
          <string name="Name">Economy</string>
          <ProtectedString name="Source"><![CDATA[-- Чистая математика экономики. Используется и сервером, и клиентом,
-- поэтому цифры в интерфейсе всегда совпадают с тем, что считает сервер.

local Config = require(script.Parent.Config)

local Economy = {}

function Economy.cashMultiplier(rebirths, passes)
	local m = 1 + Config.Rebirth.BonusPerRebirth * (rebirths or 0)
	if passes and passes.DoubleCash then
		m = m * 2
	end
	if passes and passes.VIP then
		m = m * 1.25
	end
	return m
end

function Economy.rebirthMultiplier(rebirths)
	return 1 + Config.Rebirth.BonusPerRebirth * (rebirths or 0)
end

function Economy.rebirthCost(rebirths)
	return math.floor(Config.Rebirth.BaseCost * Config.Rebirth.Growth ^ (rebirths or 0))
end

function Economy.capacity(backpackIndex, passes)
	local bp = Config.Backpacks[backpackIndex] or Config.Backpacks[1]
	local cap = bp.Capacity
	if passes and passes.MegaBackpack then
		cap = cap * 3
	end
	return cap
end

function Economy.swingCooldown(pickIndex, passes, speedPotion)
	local pick = Config.Pickaxes[pickIndex] or Config.Pickaxes[1]
	local cd = Config.BaseSwing / pick.Speed
	if passes and passes.FastMine then
		cd = cd / 1.5
	end
	if speedPotion then
		cd = cd / 2
	end
	return cd
end

function Economy.luck(passes, luckPotion)
	local l = 1
	if passes and passes.Lucky then
		l = l * 2
	end
	if luckPotion then
		l = l * 3
	end
	return l
end

function Economy.inventoryCount(inv)
	local n = 0
	for _, count in pairs(inv or {}) do
		n = n + count
	end
	return n
end

function Economy.inventoryValue(inv)
	local total = 0
	for id, count in pairs(inv or {}) do
		local ore = Config.Ores[id]
		if ore then
			total = total + ore.Value * count
		end
	end
	return total
end

-- Сколько ударов нужно, чтобы сломать блок слоя
function Economy.hitsToBreak(layer, power)
	if power < layer.MinPower then
		return math.huge
	end
	return math.max(1, math.ceil(layer.Hp / power))
end

-- Награда ежедневного входа: деньги растут вместе с прогрессом игрока
function Economy.dailyReward(day, rebirths, pickIndex)
	local list = Config.Daily
	local entry = list[((day - 1) % #list) + 1]
	local reward = { Icon = entry.Icon, Potion = entry.Potion, Cash = 0 }
	if entry.Cash then
		reward.Cash = math.floor(entry.Cash * (1 + (rebirths or 0)) * math.max(1, pickIndex or 1))
	end
	return reward
end

-- Множитель денег за товар «монеты» в магазине Robux
function Economy.cashPackAmount(baseCash, rebirths)
	return math.floor(baseCash * (1 + (rebirths or 0)))
end

-- Глубина (в метрах) по высоте Y
function Economy.depthAtY(y)
	local depth = math.floor((Config.SurfaceY - y) / Config.BlockSize)
	if depth < 0 then
		return 0
	end
	return depth
end

-- Прогресс внутри текущего слоя: слой, индекс, 0..1, метров до следующего
function Economy.layerProgress(depth)
	local layer, index = Config.LayerForDepth(depth)
	local span = layer.To - layer.From
	local fraction = math.clamp((depth - layer.From) / span, 0, 1)
	return layer, index, fraction, math.max(0, layer.To - depth)
end

return Economy
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX000621">
        <Properties>
          <string name="Name">Locale</string>
          <ProtectedString name="Source"><![CDATA[-- Все тексты игры на двух языках. Чтобы добавить язык — добавь таблицу.
-- Во всех строках используется только %s: числа заранее превращаются в текст.

local Locale = {}

local STRINGS = {
	ru = {
		-- HUD
		Shop = "Магазин", Rebirth = "Ребёрт", Bag = "Рюкзак", Premium = "Премиум", Rewards = "Награды",
		Elevator = "Лифт", Surface = "Наверх", Auto = "Авто", AutoOn = "🤖 АВТО: ВКЛ", AutoOff = "🤖 АВТО: ВЫКЛ",
		Dig = "КОПАТЬ", Lang = "🌐 RU", Full = "ПОЛНЫЙ!",
		DepthFmt = "⛏ %s м · %s", OnSurface = "☀ На поверхности", NextLayer = "до слоя «%s»: %s м", Bottom = "Самое дно!",
		Goal = "🎯 ЦЕЛЬ",
		GoalSell = "Продай руду в красном круге",
		GoalSellAnywhere = "Рюкзак полон — нажми «Рюкзак»",
