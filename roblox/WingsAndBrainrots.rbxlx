---------------------------------------------------------------------
local function makePart(model, shape, size, cf, color, material, transparency)
	local p
	if shape == "W" then
		p = Instance.new("WedgePart")
	else
		p = Instance.new("Part")
		if shape == "B" then
			p.Shape = Enum.PartType.Ball
		elseif shape == "C" then
			p.Shape = Enum.PartType.Cylinder
		else
			p.Shape = Enum.PartType.Block
		end
	end
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.Transparency = transparency or 0
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CastShadow = true
	p.Massless = true
	p.Parent = model
	return p
end

local function weld(a, b)
	local w = Instance.new("WeldConstraint")
	w.Part0 = a
	w.Part1 = b
	w.Parent = b
end

function CreatureFactory.scaleFor(id)
	local def = Config.Creatures[id]
	if def.rarity >= 7 then
		return 2.4
	end
	return 1.25 + (def.rarity - 1) * 0.15
end

-- высота центра тела над точкой, где стоит существо
function CreatureFactory.footOffset(id)
	return SPECS[id].foot * CreatureFactory.scaleFor(id)
end

-- Создаёт модель существа, стоящего на cframe.
function CreatureFactory.build(id, cframe)
	local spec = SPECS[id]
	local def = Config.Creatures[id]
	local rarity = Config.Rarities[def.rarity]
	local s = CreatureFactory.scaleFor(id)

	local model = Instance.new("Model")
	model.Name = def.name
	model:SetAttribute("CreatureId", id)

	local origin = cframe * CFrame.new(0, spec.foot * s, 0)
	local b = spec.body
	-- body = { форма, размер, цвет, материал?, поворот?, прозрачность? }
	local bodyCf = origin
	if b[5] then
		bodyCf = origin * b[5]
	end
	local body = makePart(model, b[1], b[2] * s, bodyCf, b[3], b[4], b[6])
	body.Name = "Body"
	model.PrimaryPart = body

	local function p(shape, size, pos, color, material, rot, transparency)
		local cf = origin * CFrame.new(pos * s)
		if rot then
			cf = cf * rot
		end
		local part = makePart(model, shape, size * s, cf, color, material, transparency)
		weld(body, part)
		return part
	end

	local function eye(x, y, z, size, iris)
		p("B", V(size, size, size * 0.7), V(x, y, z), WHITE)
		p("B", V(size * 0.62, size * 0.62, size * 0.3), V(x, y - size * 0.05, z - size * 0.28), iris or rgb(60, 40, 30), spec.glowEyes and NEON or nil)
		p("B", V(size * 0.34, size * 0.34, size * 0.2), V(x, y - size * 0.05, z - size * 0.38), BLACK)
		p("B", V(size * 0.18, size * 0.18, size * 0.1), V(x + size * 0.12, y + size * 0.14, z - size * 0.45), WHITE, NEON)
	end

	spec.build(p, eye)

	if spec.fire then
		local fire = Instance.new("Fire")
		fire.Size = 3 * s
		fire.Heat = 5
		fire.Color = rgb(255, 120, 30)
		fire.SecondaryColor = rgb(255, 220, 60)
		fire.Parent = body
	end
	if def.rarity >= 4 then
		local l = Instance.new("PointLight")
		l.Color = rarity.color
		l.Range = spec.divine and 30 or 14
		l.Brightness = spec.divine and 3 or 1.5
		l.Parent = body
	end
	if def.rarity >= 3 then
		local sparkles = Instance.new("ParticleEmitter")
		sparkles.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		sparkles.Color = ColorSequence.new(rarity.color)
		sparkles.Rate = spec.divine and 30 or (def.rarity * 2)
		sparkles.Lifetime = NumberRange.new(1, 2)
		sparkles.Speed = NumberRange.new(1, 3)
		sparkles.SpreadAngle = Vector2.new(180, 180)
		sparkles.Size = NumberSequence.new(0.5)
		sparkles.LightEmission = 1
		sparkles.Parent = body
	end

	-- табличка: имя, редкость, доход
	local gui = Instance.new("BillboardGui")
	gui.Name = "Info"
	gui.Size = UDim2.fromOffset(190, 62)
	gui.StudsOffset = Vector3.new(0, spec.foot * s + 2.5, 0)
	gui.MaxDistance = 130
	gui.LightInfluence = 0
	gui.Adornee = body
	local function line(text, color, y, h)
		local l = Instance.new("TextLabel")
		l.BackgroundTransparency = 1
		l.Size = UDim2.new(1, 0, h, 0)
		l.Position = UDim2.new(0, 0, y, 0)
		l.Font = Enum.Font.FredokaOne
		l.TextScaled = true
		l.TextColor3 = color
		l.TextStrokeTransparency = 0
		l.Text = text
		l.Parent = gui
	end
	line(def.name, WHITE, 0, 0.38)
	line(rarity.name, rarity.color, 0.38, 0.3)
	line(Config.formatMoney(def.income) .. "/сек", rgb(120, 255, 120), 0.68, 0.32)
	gui.Parent = body

	return model
end

function CreatureFactory.setAnchored(model, anchored)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = anchored
		end
	end
end

return CreatureFactory
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000008"><Properties><string name="Name">DataService</string><ProtectedString name="Source"><![CDATA[-- DataService: загрузка/сохранение в DataStore и состояние игроков на сервере.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local DataService = {}

local store = nil
local storeOk = pcall(function()
	store = DataStoreService:GetDataStore(Config.DataStoreName)
end)
if not storeOk then
	warn("[DataService] DataStore недоступен. В Studio включи Game Settings -> Security -> Enable Studio Access to API Services")
end

-- profiles[player] = { data = {...}, passes = {}, carrying = nil, plotIndex = n, loaded = bool }
local profiles = {}

local function defaultData()
	return {
		money = Config.StartMoney,
		speedLevel = 0,
		staminaLevel = 0,
		wing = 1,
		creatures = {}, -- список id существ по слотам
		pending = {}, -- накопленные $ у каждого подиума (забрать кнопкой)
		receipts = {}, -- последние обработанные покупки
		discovered = {}, -- какие существа уже были у игрока (для Индекса)
		totalEarned = 0,
	}
end

local function reconcile(data)
	local def = defaultData()
	for k, v in pairs(def) do
		if data[k] == nil then
			data[k] = v
		end
	end
	-- выкинуть неизвестных существ (если удалил их из конфига)
	local clean, cleanPending = {}, {}
	for i, id in ipairs(data.creatures) do
		if Config.Creatures[id] then
			table.insert(clean, id)
			table.insert(cleanPending, tonumber(data.pending[i]) or 0)
		end
	end
	data.creatures = clean
	data.pending = cleanPending
	for _, id in ipairs(clean) do
		data.discovered[id] = true
	end
	return data
end

local function key(player)
	return "player_" .. player.UserId
end

function DataService.load(player)
	local data = nil
	local ok = false
	if store then
		for attempt = 1, 3 do
			ok = pcall(function()
				data = store:GetAsync(key(player))
			end)
			if ok then
				break
			end
			task.wait(attempt)
		end
	end
	if not ok then
		warn("[DataService] Не удалось загрузить данные " .. player.Name .. ", прогресс НЕ будет сохранён")
	end
	local profile = {
		data = reconcile(type(data) == "table" and data or defaultData()),
		passes = {},
		testPasses = {},
		carrying = nil,
		plotIndex = nil,
		canSave = ok,
	}
	profiles[player] = profile
	return profile
end

function DataService.get(player)
	return profiles[player]
end

function DataService.save(player)
	local profile = profiles[player]
	if not profile or not profile.canSave or not store then
		return false
	end
	local ok, err = pcall(function()
		store:SetAsync(key(player), profile.data)
	end)
	if not ok then
		warn("[DataService] Ошибка сохранения " .. player.Name .. ": " .. tostring(err))
	end
	return ok
end

function DataService.release(player)
	DataService.save(player)
	profiles[player] = nil
end

function DataService.all()
	return profiles
end

-- Отправляет клиенту всё нужное через атрибуты игрока.
function DataService.sync(player)
	local profile = profiles[player]
	if not profile then
		return
	end
	local d = profile.data
	player:SetAttribute("Money", d.money)
	player:SetAttribute("SpeedLevel", d.speedLevel)
	player:SetAttribute("StaminaLevel", d.staminaLevel)
	player:SetAttribute("Wing", d.wing)
	player:SetAttribute("Creatures", HttpService:JSONEncode(d.creatures))
	local found = {}
	for id in pairs(d.discovered) do
		table.insert(found, id)
	end
	table.sort(found)
	player:SetAttribute("Discovered", HttpService:JSONEncode(found))
	player:SetAttribute("MaxSlots", DataService.maxSlots(player))
	player:SetAttribute("Income", DataService.income(player))
	local pendingTotal = 0
	for _, v in ipairs(d.pending) do
		pendingTotal = pendingTotal + v
	end
	player:SetAttribute("Pending", math.floor(pendingTotal))
	player:SetAttribute("Carrying", profile.carrying and profile.carrying.id or "")
	for passKey in pairs(Config.GamePasses) do
		player:SetAttribute("Pass_" .. passKey, DataService.hasPass(player, passKey))
	end
	local stats = player:FindFirstChild("leaderstats")
	if stats then
		stats["$"].Value = d.money
		stats["Существа"].Value = #d.creatures
	end
end

function DataService.hasPass(player, passKey)
	local profile = profiles[player]
	if not profile then
		return false
	end
	return profile.passes[passKey] == true or profile.testPasses[passKey] == true
end

function DataService.maxSlots(player)
	local slots = Config.BaseSlots
	if DataService.hasPass(player, "ExtraSlots") then
		slots = slots + Config.ExtraSlotsPass
	end
	return slots
end

function DataService.incomeMultiplier(player)
	local mult = 1
	if DataService.hasPass(player, "DoubleMoney") then
		mult = mult * Config.DoubleMoneyMult
	end
	if DataService.hasPass(player, "VIP") then
		mult = mult * Config.VipMult
	end
	return mult
end

function DataService.baseIncome(player)
	local profile = profiles[player]
	if not profile then
		return 0
	end
	local total = 0
	for _, id in ipairs(profile.data.creatures) do
		total = total + Config.Creatures[id].income
	end
	return total
end

function DataService.slotIncome(player, slot)
	local profile = profiles[player]
	local id = profile and profile.data.creatures[slot]
	if not id then
		return 0
	end
	return Config.Creatures[id].income * DataService.incomeMultiplier(player)
end

function DataService.income(player)
	return math.floor(DataService.baseIncome(player) * DataService.incomeMultiplier(player))
end

function DataService.addMoney(player, amount)
	local profile = profiles[player]
	if not profile then
		return
	end
	profile.data.money = profile.data.money + amount
	if amount > 0 then
		profile.data.totalEarned = profile.data.totalEarned + amount
	end
end

function DataService.init()
	-- автосохранение
	task.spawn(function()
		while true do
			task.wait(Config.AutosaveSeconds)
			for player in pairs(profiles) do
				task.spawn(DataService.save, player)
			end
		end
	end)

	game:BindToClose(function()
		if RunService:IsStudio() then
			-- в Studio сохраняем быстро и не ждём долго
			for player in pairs(profiles) do
				DataService.save(player)
			end
			return
		end
		local pending = 0
		for player in pairs(profiles) do
			pending = pending + 1
			task.spawn(function()
				DataService.save(player)
				pending = pending - 1
			end)
		end
		local start = os.clock()
		while pending > 0 and os.clock() - start < 25 do
			task.wait(0.2)
		end
	end)
end

return DataService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000009"><Properties><string name="Name">MapBuilder</string><ProtectedString name="Source"><![CDATA[-- MapBuilder: строит всю карту из блоков при старте сервера.
-- Яркая стартовая зона с фонтаном, 4 базы с подиумами, торговые палатки,
-- 7 тематических островов, облака, вода и освещение.

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local MapBuilder = {
	plots = {},
	stations = {},
	islands = {},
}

local GY = Config.GroundY
local PLOT_HALF = 32
local rng = Random.new(7)

local PLOT_COLORS = {
	Color3.fromRGB(255, 85, 110),
	Color3.fromRGB(70, 160, 255),
	Color3.fromRGB(80, 220, 120),
	Color3.fromRGB(255, 190, 40),
}

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

---------------------------------------------------------------------
-- помощники
---------------------------------------------------------------------
local function part(props)
	local p = Instance.new(props.Class or "Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for k, v in pairs(props) do
		if k ~= "Parent" and k ~= "Class" then
			p[k] = v
		end
	end
	p.Parent = props.Parent
	return p
end

local function block(parent, size, cf, color, material, extra)
	local props = { Parent = parent, Size = size, CFrame = cf, Color = color, Material = material or Enum.Material.SmoothPlastic }
	if extra then
		for k, v in pairs(extra) do
			props[k] = v
		end
	end
	return part(props)
end

local function ball(parent, size, pos, color, material, extra)
	local props = { Parent = parent, Shape = Enum.PartType.Ball, Size = size, CFrame = CFrame.new(pos), Color = color, Material = material or Enum.Material.SmoothPlastic }
	if extra then
		for k, v in pairs(extra) do
			props[k] = v
		end
	end
	return part(props)
end

-- вертикальный цилиндр: center — центр, height — высота
local function cyl(parent, center, radius, height, color, material, extra)
	local props = {
		Parent = parent,
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(height, radius * 2, radius * 2),
		CFrame = CFrame.new(center) * CFrame.Angles(0, 0, math.rad(90)),
		Color = color,
		Material = material or Enum.Material.SmoothPlastic,
	}
	if extra then
		for k, v in pairs(extra) do
			props[k] = v
		end
	end
	return part(props)
end

local function deco(props)
	props.CanCollide = false
	props.CanQuery = false
	props.CanTouch = false
	return props
end

local function billboard(adornee, text, color, offsetY, sizeX, sizeY, alwaysOnTop, maxDistance)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(sizeX or 220, sizeY or 60)
	gui.StudsOffset = Vector3.new(0, offsetY or 4, 0)
	gui.AlwaysOnTop = alwaysOnTop == true
	gui.MaxDistance = maxDistance or (alwaysOnTop and 6000 or 220)
	gui.LightInfluence = 0
	gui.Adornee = adornee
	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = color or Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0
	label.Text = text
	label.Parent = gui
	gui.Parent = adornee
	return gui
end

local function prompt(parentPart, actionText, objectText, name)
	local pp = Instance.new("ProximityPrompt")
	pp.Name = name or "Prompt"
	pp.ActionText = actionText
	pp.ObjectText = objectText or ""
	pp.HoldDuration = 0
	pp.MaxActivationDistance = 14
	pp.RequiresLineOfSight = false
	pp.KeyboardKeyCode = Enum.KeyCode.E
	pp.Parent = parentPart
	return pp
end

local function light(parentPart, color, range, brightness)
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range or 14
	l.Brightness = brightness or 1.5
	l.Parent = parentPart
	return l
end

---------------------------------------------------------------------
-- растительность и предметы
---------------------------------------------------------------------
local FLOWER_COLORS = { rgb(255, 80, 120), rgb(255, 220, 60), rgb(160, 110, 255), rgb(255, 140, 40), rgb(90, 200, 255), rgb(255, 255, 255) }

local function roundTree(parent, pos, scale, leafColor)
	scale = scale or 1
	leafColor = leafColor or rgb(80, 200, 80)
	block(parent, Vector3.new(1.8, 9, 1.8) * scale, CFrame.new(pos + Vector3.new(0, 4.5 * scale, 0)), rgb(140, 90, 55), Enum.Material.Wood)
	ball(parent, Vector3.new(9, 8, 9) * scale, pos + Vector3.new(0, 10.5 * scale, 0), leafColor, Enum.Material.Grass)
	ball(parent, Vector3.new(6, 6, 6) * scale, pos + Vector3.new(2.5, 12.5, 1) * scale, leafColor:Lerp(Color3.new(1, 1, 1), 0.15), Enum.Material.Grass)
	ball(parent, Vector3.new(5, 5, 5) * scale, pos + Vector3.new(-2.2, 12, -1.5) * scale, leafColor:Lerp(Color3.new(0, 0, 0), 0.1), Enum.Material.Grass)
	-- яблочки
	for i = 1, 3 do
		local a = i * 2.1
		ball(parent, Vector3.new(0.9, 0.9, 0.9) * scale, pos + Vector3.new(math.cos(a) * 4.2, 9.5 + i * 0.6, math.sin(a) * 4.2) * scale, rgb(255, 60, 60), nil, deco({}))
	end
end

local function palm(parent, pos, scale)
	scale = scale or 1
	local top = pos
	for i = 0, 5 do
		local seg = pos + Vector3.new(i * 0.5, i * 2.2 + 1, 0) * scale
		block(parent, Vector3.new(1.6, 2.4, 1.6) * scale, CFrame.new(seg) * CFrame.Angles(0, 0, math.rad(-12)), i % 2 == 0 and rgb(170, 120, 70) or rgb(150, 100, 60), Enum.Material.Wood)
		top = seg
	end
	for i = 1, 6 do
		local a = i / 6 * math.pi * 2
		local dir = Vector3.new(math.cos(a), 0, math.sin(a))
		local leafPos = top + dir * 3.2 * scale + Vector3.new(0, 0.4, 0) * scale
		block(parent, Vector3.new(1.6, 0.3, 6.5) * scale, CFrame.lookAt(leafPos, leafPos + dir) * CFrame.Angles(math.rad(-18), 0, 0), rgb(60, 190, 70), Enum.Material.Grass, deco({}))
	end
	for i = 1, 3 do
		ball(parent, Vector3.new(1.1, 1.1, 1.1) * scale, top + Vector3.new(math.cos(i * 2) * 0.8, -1, math.sin(i * 2) * 0.8) * scale, rgb(120, 80, 40), nil, deco({}))
	end
end

local function pine(parent, pos, scale, color, snow)
	scale = scale or 1
	color = color or rgb(40, 140, 80)
	block(parent, Vector3.new(1.4, 4, 1.4) * scale, CFrame.new(pos + Vector3.new(0, 2, 0) * scale), rgb(110, 75, 50), Enum.Material.Wood)
	for i = 0, 3 do
		local size = (7 - i * 1.5) * scale
		local y = (4 + i * 2.6) * scale
		block(parent, Vector3.new(size, 2.4 * scale, size), CFrame.new(pos + Vector3.new(0, y, 0)) * CFrame.Angles(0, math.rad(45 * i), 0), color, Enum.Material.Grass)
		if snow then
			block(parent, Vector3.new(size * 0.8, 0.5 * scale, size * 0.8), CFrame.new(pos + Vector3.new(0, y + 1.3 * scale, 0)) * CFrame.Angles(0, math.rad(45 * i), 0), rgb(250, 252, 255), Enum.Material.Snow, deco({}))
		end
	end
end

local function lollipopTree(parent, pos, scale, color)
	scale = scale or 1
	cyl(parent, pos + Vector3.new(0, 5 * scale, 0), 0.6 * scale, 10 * scale, rgb(255, 255, 255))
	local center = pos + Vector3.new(0, 11 * scale, 0)
	part({ Parent = parent, Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.4, 8, 8) * scale, CFrame = CFrame.new(center), Color = color })
	part(deco({ Parent = parent, Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.6, 5.5, 5.5) * scale, CFrame = CFrame.new(center), Color = rgb(255, 255, 255) }))
	part(deco({ Parent = parent, Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.8, 3, 3) * scale, CFrame = CFrame.new(center), Color = color }))
end

local function candyCane(parent, pos, scale)
	scale = scale or 1
	for i = 0, 5 do
		block(parent, Vector3.new(1.2, 1.2, 1.2) * scale, CFrame.new(pos + Vector3.new(0, 0.6 + i * 1.2, 0) * scale), i % 2 == 0 and rgb(255, 60, 80) or rgb(255, 255, 255))
	end
	block(parent, Vector3.new(1.2, 1.2, 1.2) * scale, CFrame.new(pos + Vector3.new(1.2, 7.8, 0) * scale), rgb(255, 255, 255))
	block(parent, Vector3.new(1.2, 1.2, 1.2) * scale, CFrame.new(pos + Vector3.new(2.4, 7.2, 0) * scale), rgb(255, 60, 80))
end

local function flower(parent, pos, color)
	block(parent, Vector3.new(0.25, 1.4, 0.25), CFrame.new(pos + Vector3.new(0, 0.7, 0)), rgb(60, 160, 60), nil, deco({}))
	for i = 1, 4 do
		local a = i / 4 * math.pi * 2
		ball(parent, Vector3.new(0.7, 0.4, 0.7), pos + Vector3.new(math.cos(a) * 0.4, 1.5, math.sin(a) * 0.4), color, nil, deco({}))
	end
	ball(parent, Vector3.new(0.5, 0.5, 0.5), pos + Vector3.new(0, 1.6, 0), rgb(255, 230, 80), nil, deco({}))
end

local function bush(parent, pos, color, scale)
	scale = scale or 1
	ball(parent, Vector3.new(4, 3, 4) * scale, pos + Vector3.new(0, 1, 0) * scale, color, Enum.Material.Grass)
	ball(parent, Vector3.new(3, 2.5, 3) * scale, pos + Vector3.new(1.6, 1.2, 0.6) * scale, color:Lerp(Color3.new(1, 1, 1), 0.12), Enum.Material.Grass)
	for i = 1, 3 do
		ball(parent, Vector3.new(0.6, 0.6, 0.6) * scale, pos + Vector3.new(math.cos(i * 2) * 1.8, 2, math.sin(i * 2) * 1.8) * scale, FLOWER_COLORS[(i % #FLOWER_COLORS) + 1], nil, deco({}))
	end
end

local function rock(parent, pos, color, scale)
	scale = scale or 1
	block(parent, Vector3.new(4, 3, 3.4) * scale, CFrame.new(pos + Vector3.new(0, 1.2, 0) * scale) * CFrame.Angles(math.rad(10), math.rad(rng:NextInteger(0, 90)), math.rad(8)), color, Enum.Material.Slate)
	block(parent, Vector3.new(2.4, 2, 2.2) * scale, CFrame.new(pos + Vector3.new(1.8, 0.8, 1) * scale) * CFrame.Angles(0, math.rad(30), math.rad(-12)), color:Lerp(Color3.new(1, 1, 1), 0.1), Enum.Material.Slate)
end

local function mushroom(parent, pos, capColor, glow, scale)
	scale = scale or 1
	cyl(parent, pos + Vector3.new(0, 1.2, 0) * scale, 0.5 * scale, 2.4 * scale, rgb(250, 240, 220), nil, deco({}))
	local cap = ball(parent, Vector3.new(3, 1.6, 3) * scale, pos + Vector3.new(0, 2.6, 0) * scale, capColor, glow and Enum.Material.Neon or nil, deco({}))
	for i = 1, 3 do
		ball(parent, Vector3.new(0.5, 0.3, 0.5) * scale, pos + Vector3.new(math.cos(i * 2.1) * 0.9, 3.25, math.sin(i * 2.1) * 0.9) * scale, rgb(255, 255, 255), nil, deco({}))
	end
	if glow then
		light(cap, capColor, 10, 1)
	end
end

local function crystal(parent, pos, color, scale)
	scale = scale or 1
	local main = block(parent, Vector3.new(2, 8, 2) * scale, CFrame.new(pos + Vector3.new(0, 3.5, 0) * scale) * CFrame.Angles(math.rad(8), math.rad(45), math.rad(6)), color, Enum.Material.Neon, { Transparency = 0.15 })
	block(parent, Vector3.new(1.4, 5, 1.4) * scale, CFrame.new(pos + Vector3.new(1.4, 2.2, 0.6) * scale) * CFrame.Angles(math.rad(-10), math.rad(20), math.rad(-25)), color, Enum.Material.Neon, { Transparency = 0.15 })
	block(parent, Vector3.new(1.2, 4, 1.2) * scale, CFrame.new(pos + Vector3.new(-1.2, 1.8, -0.5) * scale) * CFrame.Angles(math.rad(12), math.rad(60), math.rad(22)), color, Enum.Material.Neon, { Transparency = 0.15 })
	light(main, color, 16, 1.5)
end

local function lamp(parent, pos, color)
	block(parent, Vector3.new(0.6, 8, 0.6), CFrame.new(pos + Vector3.new(0, 4, 0)), rgb(60, 60, 70), Enum.Material.Metal)
	local bulb = ball(parent, Vector3.new(1.8, 1.8, 1.8), pos + Vector3.new(0, 8.6, 0), color, Enum.Material.Neon)
	light(bulb, color, 18, 1.2)
end

local function cloud(parent, pos, scale)
	for i = 1, 5 do
		local off = Vector3.new(rng:NextNumber(-8, 8), rng:NextNumber(-1.5, 1.5), rng:NextNumber(-4, 4)) * scale
		local s = rng:NextNumber(7, 12) * scale
		ball(parent, Vector3.new(s, s * 0.7, s), pos + off, rgb(255, 255, 255), Enum.Material.SmoothPlastic, deco({ CastShadow = false, Transparency = 0.05 }))
	end
end

---------------------------------------------------------------------
-- освещение и вода
---------------------------------------------------------------------
local function buildLighting()
	Lighting.ClockTime = 13.5
	Lighting.Brightness = 3
	Lighting.Ambient = rgb(120, 120, 135)
	Lighting.OutdoorAmbient = rgb(160, 160, 175)
	Lighting.EnvironmentDiffuseScale = 1
	Lighting.EnvironmentSpecularScale = 1
	Lighting.GlobalShadows = true
	Lighting.FogEnd = 100000

	local atmo = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	atmo.Density = 0.08
	atmo.Offset = 0.1
	atmo.Haze = 0.2
	atmo.Glare = 0.3
	atmo.Color = rgb(210, 235, 255)
	atmo.Decay = rgb(140, 190, 255)
	atmo.Parent = Lighting

	local cc = Instance.new("ColorCorrectionEffect")
	cc.Saturation = 0.3
	cc.Contrast = 0.08
	cc.Brightness = 0.02
	cc.TintColor = rgb(255, 250, 240)
	cc.Parent = Lighting

	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.6
	bloom.Size = 24
	bloom.Threshold = 1.4
	bloom.Parent = Lighting

	local rays = Instance.new("SunRaysEffect")
	rays.Intensity = 0.08
	rays.Spread = 0.7
	rays.Parent = Lighting

	if not Lighting:FindFirstChildOfClass("Sky") then
		local sky = Instance.new("Sky")
		sky.SunAngularSize = 14
		sky.Parent = Lighting
	end
end

local function buildWater(map)
	local tile = 2000
	for ix = -2, 1 do
		for iz = -1, 3 do
			part(deco({
				Parent = map,
				Name = "Water",
				Size = Vector3.new(tile, 4, tile),
				CFrame = CFrame.new(ix * tile + tile / 2, Config.WaterLevel - 2, iz * tile + tile / 2),
				Color = rgb(40, 190, 230),
				Material = Enum.Material.Glass,
				Reflectance = 0.1,
				Transparency = 0.2,
				CastShadow = false,
			}))
			part(deco({
				Parent = map,
				Name = "SeaFloor",
				Size = Vector3.new(tile, 2, tile),
				CFrame = CFrame.new(ix * tile + tile / 2, Config.WaterLevel - 30, iz * tile + tile / 2),
				Color = rgb(20, 90, 160),
				Material = Enum.Material.Sand,
				CastShadow = false,
			}))
		end
	end
end

local function buildClouds(map)
	local folder = Instance.new("Folder")
	folder.Name = "Clouds"
	folder.Parent = map
	for i = 1, 50 do
		local side = i % 2 == 0 and 1 or -1
		local x = side * rng:NextNumber(150, 1400)
		local z = rng:NextNumber(-600, 7000)
		cloud(folder, Vector3.new(x, rng:NextNumber(140, 260), z), rng:NextNumber(1.2, 2.4))
	end
end

---------------------------------------------------------------------
-- стартовая зона
---------------------------------------------------------------------

-- тематические украшения для каждой палатки
local function stationDecor(name, model, cf, color)
	local white = rgb(255, 255, 255)
	local gold = rgb(255, 205, 40)
	local function at(x, y, z)
		return (cf * CFrame.new(x, y, z)).Position
	end
	if name == "Speed" then
		-- молния на крыше
		block(model, Vector3.new(1.2, 5, 1.2), cf * CFrame.new(0.8, 18.5, 0) * CFrame.Angles(0, 0, math.rad(-25)), gold, Enum.Material.Neon, deco({}))
		block(model, Vector3.new(3.2, 1.2, 1.2), cf * CFrame.new(0, 16.4, 0), gold, Enum.Material.Neon, deco({}))
		block(model, Vector3.new(1.2, 5, 1.2), cf * CFrame.new(-0.8, 14.3, 0) * CFrame.Angles(0, 0, math.rad(-25)), gold, Enum.Material.Neon, deco({}))
		-- полосатая беговая дорожка
		for i = 0, 7 do
			block(model, Vector3.new(14, 0.2, 1.5), cf * CFrame.new(0, 1.1, -9 - i * 1.5), i % 2 == 0 and gold or rgb(30, 30, 35), nil, deco({}))
		end
		-- кроссовок на прилавке
		block(model, Vector3.new(1.4, 1, 3), cf * CFrame.new(-5.5, 6, -2), rgb(240, 50, 60))
		block(model, Vector3.new(1.5, 0.4, 3.1), cf * CFrame.new(-5.5, 5.5, -2), white)
	elseif name == "Stamina" then
		-- гантели по бокам
		for _, x in ipairs({ -10.5, 10.5 }) do
			cyl(model, at(x, 2.5, -4), 0.4, 3.2, rgb(80, 80, 90), Enum.Material.Metal)
			for _, dy in ipairs({ -1.4, 1.4 }) do
				cyl(model, at(x, 2.5 + dy, -4), 1.4, 0.6, rgb(40, 180, 90), Enum.Material.Metal)
			end
		end
		-- неоновое сердце
		ball(model, Vector3.new(2.6, 2.6, 1), at(-0.9, 18.2, 0), rgb(255, 60, 90), Enum.Material.Neon, deco({}))
		ball(model, Vector3.new(2.6, 2.6, 1), at(0.9, 18.2, 0), rgb(255, 60, 90), Enum.Material.Neon, deco({}))
		block(model, Vector3.new(2.6, 2.6, 1), cf * CFrame.new(0, 17.0, 0) * CFrame.Angles(0, 0, math.rad(45)), rgb(255, 60, 90), Enum.Material.Neon, deco({}))
		block(model, Vector3.new(18, 0.2, 10), cf * CFrame.new(0, 1.1, -12), rgb(60, 200, 110), nil, deco({}))
	elseif name == "Wings" then
		-- огромные крылья на крыше
		for _, sx in ipairs({ -1, 1 }) do
			for k = 0, 3 do
				block(model, Vector3.new(6 - k, 1.2, 0.4), cf * CFrame.new(sx * (4 + k * 2.2), 17 + k * 1.3, 0) * CFrame.Angles(0, 0, math.rad(sx * (20 + k * 8))), k % 2 == 0 and white or rgb(170, 210, 255), k == 3 and Enum.Material.Neon or nil, deco({}))
			end
		end
		-- голубые колонны с перьями
		for _, x in ipairs({ -10.5, 10.5 }) do
			cyl(model, at(x, 4, -6), 1, 7, rgb(120, 180, 255), Enum.Material.Marble)
			block(model, Vector3.new(0.3, 2.4, 1), cf * CFrame.new(x, 8.5, -6) * CFrame.Angles(0, 0, math.rad(15)), white, Enum.Material.Neon, deco({}))
		end
	elseif name == "Market" then
		-- ящики и горы монет
		for i, off in ipairs({ { -10, -5 }, { 10, -5 }, { -10.5, 3 } }) do
			block(model, Vector3.new(3, 3, 3), cf * CFrame.new(off[1], 2.5, off[2]) * CFrame.Angles(0, math.rad(i * 20), 0), rgb(170, 120, 70), Enum.Material.WoodPlanks)
		end
		for i = 0, 5 do
			cyl(model, at(10 + (i % 2) * 0.4, 1.3 + i * 0.35, 3), 1.6 - i * 0.15, 0.35, gold, Enum.Material.Metal)
		end
		-- большая монета-вывеска
		local coin = part({
			Parent = model,
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.8, 5, 5),
			CFrame = cf * CFrame.new(0, 19, 0) * CFrame.Angles(0, math.rad(90), 0),
			Color = gold,
			Material = Enum.Material.Neon,
			CanCollide = false,
		})
		billboard(coin, "$", rgb(120, 80, 0), 0, 60, 60, false, 200)
	elseif name == "Donate" then
		-- звезда
		for k = 0, 4 do
			block(model, Vector3.new(1.4, 4, 0.8), cf * CFrame.new(0, 19, 0) * CFrame.Angles(0, 0, math.rad(k * 72)) * CFrame.new(0, 1.8, 0), gold, Enum.Material.Neon, deco({}))
		end
		-- подарки
		local gifts = { { -10, -5, rgb(255, 80, 200) }, { 10, -5, rgb(80, 200, 255) }, { 10.5, 3, rgb(255, 205, 40) } }
		for _, g in ipairs(gifts) do
			block(model, Vector3.new(3, 3, 3), cf * CFrame.new(g[1], 2.5, g[2]), g[3])
			block(model, Vector3.new(3.1, 3.1, 0.5), cf * CFrame.new(g[1], 2.5, g[2]), white, nil, deco({}))
			block(model, Vector3.new(0.5, 3.1, 3.1), cf * CFrame.new(g[1], 2.5, g[2]), white, nil, deco({}))
			ball(model, Vector3.new(1.2, 1, 1.2), at(g[1], 4.3, g[2]), white, nil, deco({}))
		end
		local sparkle = Instance.new("Sparkles")
		sparkle.SparkleColor = gold
		sparkle.Parent = model:FindFirstChild("Kiosk")
	end
end

local function buildStation(map, name, title, color, pos, facing)
	local model = Instance.new("Model")
	model.Name = name
	model.Parent = map
	local cf = CFrame.lookAt(pos, pos + facing)
	local white = rgb(255, 255, 255)

	block(model, Vector3.new(20, 1, 16), cf * CFrame.new(0, 0.5, 0), color:Lerp(white, 0.55))
	-- прилавок
	local kiosk = block(model, Vector3.new(14, 4, 3), cf * CFrame.new(0, 3, -2), color)
	kiosk.Name = "Kiosk"
	block(model, Vector3.new(14.6, 0.6, 3.6), cf * CFrame.new(0, 5.3, -2), white)
	-- столбы
	for _, x in ipairs({ -8, 8 }) do
		for _, z in ipairs({ -4, 5 }) do
			block(model, Vector3.new(0.8, 11, 0.8), cf * CFrame.new(x, 6.5, z), white, Enum.Material.Wood)
		end
	end
	-- полосатая крыша
	for i = -4, 4 do
		block(model, Vector3.new(2, 0.6, 12), cf * CFrame.new(i * 2, 12.6, 0.5) * CFrame.Angles(math.rad(-8), 0, 0), i % 2 == 0 and color or white)
	end
	for i = -4, 4 do
		ball(model, Vector3.new(2, 2, 2), (cf * CFrame.new(i * 2, 12.2, -5.6)).Position, i % 2 == 0 and color or white, nil, deco({}))
	end
	-- вывеска
	local sign = block(model, Vector3.new(12, 3, 0.6), cf * CFrame.new(0, 15.2, -5), color, Enum.Material.Neon)
	billboard(sign, title, white, 2.5, 280, 60, false, 260)
	light(sign, color, 24, 2)
	-- украшения на прилавке
	ball(model, Vector3.new(1.6, 1.6, 1.6), (cf * CFrame.new(-4, 6.4, -2)).Position, rgb(255, 230, 80), Enum.Material.Neon, deco({}))
	ball(model, Vector3.new(1.6, 1.6, 1.6), (cf * CFrame.new(4, 6.4, -2)).Position, rgb(120, 230, 255), Enum.Material.Neon, deco({}))

	stationDecor(name, model, cf, color)

	local pp = prompt(kiosk, "Открыть", title, "OpenPrompt")
	MapBuilder.stations[name] = { model = model, kiosk = kiosk, prompt = pp, position = pos }
end

local function buildFountain(map)
	local c = Vector3.new(0, GY, 0)
	cyl(map, c + Vector3.new(0, 1, 0), 12, 2, rgb(240, 240, 250), Enum.Material.Marble)
	cyl(map, c + Vector3.new(0, 1.6, 0), 10.5, 1.4, rgb(70, 210, 255), Enum.Material.Glass, deco({ Transparency = 0.2 }))
	cyl(map, c + Vector3.new(0, 4, 0), 2, 6, rgb(240, 240, 250), Enum.Material.Marble)
	cyl(map, c + Vector3.new(0, 7.2, 0), 5, 0.8, rgb(240, 240, 250), Enum.Material.Marble)
	local top = ball(map, Vector3.new(3, 3, 3), c + Vector3.new(0, 9, 0), rgb(255, 215, 60), Enum.Material.Neon)
	light(top, rgb(255, 230, 120), 30, 2)
	-- струи
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	emitter.Color = ColorSequence.new(rgb(140, 230, 255))
	emitter.Rate = 40
	emitter.Lifetime = NumberRange.new(1.2, 1.8)
	emitter.Speed = NumberRange.new(14, 18)
	emitter.SpreadAngle = Vector2.new(25, 25)
	emitter.Acceleration = Vector3.new(0, -25, 0)
	emitter.Size = NumberSequence.new(0.8)
	emitter.Parent = top
end

local function buildPlot(map, index, center, lookTarget)
	local model = Instance.new("Model")
	model.Name = "Plot" .. index
	model.Parent = map
	local color = PLOT_COLORS[index]
	local dark = color:Lerp(Color3.new(0, 0, 0), 0.25)
	local light2 = color:Lerp(Color3.new(1, 1, 1), 0.55)
	local white = rgb(255, 255, 255)
	-- -Z смотрит в центр карты (там вход)
	local cf = CFrame.lookAt(center, lookTarget)

	-- шахматный пол
	local tiles = 4
	local ts = PLOT_HALF * 2 / tiles
	for ix = 0, tiles - 1 do
		for iz = 0, tiles - 1 do
			local x = -PLOT_HALF + ts / 2 + ix * ts
			local z = -PLOT_HALF + ts / 2 + iz * ts
			block(model, Vector3.new(ts, 1, ts), cf * CFrame.new(x, 0.5, z), (ix + iz) % 2 == 0 and light2 or white)
		end
	end

	-- стены: задняя и боковые, перед открыт
	local wallH = 8
	local function wall(size, offset)
		block(model, size, cf * offset, color)
		block(model, Vector3.new(size.X + 0.4, 0.8, size.Z + 0.4), cf * offset * CFrame.new(0, wallH / 2 + 0.4, 0), white)
		block(model, Vector3.new(size.X + 0.2, 0.5, size.Z + 0.2), cf * offset * CFrame.new(0, -wallH / 2 + 1.8, 0), dark, Enum.Material.Neon, deco({}))
	end
	wall(Vector3.new(PLOT_HALF * 2, wallH, 1.2), CFrame.new(0, wallH / 2 + 1, PLOT_HALF))
	wall(Vector3.new(1.2, wallH, PLOT_HALF * 2), CFrame.new(-PLOT_HALF, wallH / 2 + 1, 0))
	wall(Vector3.new(1.2, wallH, PLOT_HALF * 2), CFrame.new(PLOT_HALF, wallH / 2 + 1, 0))
	-- короткие стенки по бокам входа
	wall(Vector3.new(18, wallH, 1.2), CFrame.new(-PLOT_HALF + 9, wallH / 2 + 1, -PLOT_HALF))
	wall(Vector3.new(18, wallH, 1.2), CFrame.new(PLOT_HALF - 9, wallH / 2 + 1, -PLOT_HALF))

	-- арка входа
	for _, x in ipairs({ -14, 14 }) do
		block(model, Vector3.new(2.4, 16, 2.4), cf * CFrame.new(x, 9, -PLOT_HALF), white)
		local orb = ball(model, Vector3.new(3, 3, 3), (cf * CFrame.new(x, 18.5, -PLOT_HALF)).Position, color, Enum.Material.Neon)
		light(orb, color, 20, 2)
	end
	local arch = block(model, Vector3.new(30, 3, 2.4), cf * CFrame.new(0, 16.5, -PLOT_HALF), color)
	local sign = billboard(arch, "Свободная база", white, 3.5, 320, 56, false, 300)
	-- светящаяся завеса на входе (декор)
	block(model, Vector3.new(26, 14, 0.2), cf * CFrame.new(0, 8, -PLOT_HALF), color, Enum.Material.ForceField, deco({ Transparency = 0.5 }))

	-- флаг-маяк в углу
	local pole = block(model, Vector3.new(0.8, 30, 0.8), cf * CFrame.new(PLOT_HALF - 3, 16, PLOT_HALF - 3), white, Enum.Material.Metal)
	pole.Name = "Beacon"
	block(model, Vector3.new(0.3, 5, 8), cf * CFrame.new(PLOT_HALF - 3, 28.5, PLOT_HALF - 7.2), color, Enum.Material.Fabric, deco({}))

	-- подиумы 3 ряда по 5
	local podiums = {}
	local maxPads = Config.BaseSlots + Config.ExtraSlotsPass
	local i = 0
	for _, z in ipairs({ -6, 7, 20 }) do
		for _, x in ipairs({ -22, -11, 0, 11, 22 }) do
			i = i + 1
			if i <= maxPads then
				local base = cyl(model, (cf * CFrame.new(x, 2, z)).Position, 3, 2, white)
				base.Name = "Podium" .. i
				local rim = cyl(model, (cf * CFrame.new(x, 3.05, z)).Position, 3.3, 0.3, rgb(200, 200, 210), Enum.Material.Neon, deco({}))
				local button = block(model, Vector3.new(3, 0.4, 2.2), cf * CFrame.new(x, 1.2, z - 4.6), rgb(60, 220, 90), Enum.Material.Neon, { CanCollide = false })
				button.Name = "Collect" .. i
				local gui = billboard(button, "", rgb(140, 255, 140), 1.6, 110, 26, false, 70)
				podiums[i] = {
					base = base,
					rim = rim,
					button = button,
					label = gui.Label,
					top = cf * CFrame.new(x, 3.2, z),
				}
			end
		end
	end

	MapBuilder.plots[index] = {
		model = model,
		cframe = cf * CFrame.new(0, 1, 0),
		spawnCFrame = cf * CFrame.new(0, 4, -PLOT_HALF + 6) * CFrame.Angles(0, math.pi, 0),
		podiums = podiums,
		sign = sign,
		color = color,
	}
end

-- Лобби: прямоугольная площадь. Сзади ряд из 4 баз, в середине фонтан
-- и магазины, спереди — арка «ЗОНЫ», откуда начинается линия островов.
local LOBBY_HALF_X = 165
local LOBBY_BACK_Z = -112

local function buildStart(map)
	local y = GY
	local front = Config.LobbyFrontZ
	local depth = front - LOBBY_BACK_Z
	local midZ = (front + LOBBY_BACK_Z) / 2
	local path = rgb(255, 235, 200)

	-- основа: трава, песчаный пляж, скалы
	block(map, Vector3.new(LOBBY_HALF_X * 2, 12, depth), CFrame.new(0, y - 6, midZ), rgb(110, 205, 90), Enum.Material.Grass)
	block(map, Vector3.new(LOBBY_HALF_X * 2 + 24, 12, depth + 24), CFrame.new(0, y - 7.4, midZ), rgb(250, 225, 160), Enum.Material.Sand)
	block(map, Vector3.new(LOBBY_HALF_X * 2 - 20, 14, depth - 20), CFrame.new(0, y - 18, midZ), rgb(150, 125, 100), Enum.Material.Slate)

	-- дорожки
	block(map, Vector3.new(LOBBY_HALF_X * 2 - 20, 0.3, 14), CFrame.new(0, y + 0.15, -20), path, Enum.Material.Pebble)
	block(map, Vector3.new(14, 0.3, 30), CFrame.new(0, y + 0.15, -10), path, Enum.Material.Pebble)
	block(map, Vector3.new(14, 0.3, 40), CFrame.new(0, y + 0.15, front - 20), path, Enum.Material.Pebble)
	cyl(map, Vector3.new(0, y + 0.2, 6), 20, 0.4, path, Enum.Material.Pebble)
	block(map, Vector3.new(LOBBY_HALF_X * 2 - 20, 0.3, 10), CFrame.new(0, y + 0.15, 30), path, Enum.Material.Pebble)

	-- фонтан
	local fountainModel = Instance.new("Folder")
	fountainModel.Name = "Fountain"
	fountainModel.Parent = map
	buildFountain(fountainModel)
	for _, d in ipairs(fountainModel:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CFrame = d.CFrame + Vector3.new(0, 0, 6)
		end
	end

	-- 4 базы в ряд, входом к зонам
	local xs = { -120, -40, 40, 120 }
	for index, x in ipairs(xs) do
		local c = Vector3.new(x, y, -66)
		buildPlot(map, index, c, Vector3.new(x, y, 1000))
	end

	-- магазины в ряд лицом к базам
	local shopZ = 46
	local toward = Vector3.new(0, 0, -1)
	buildStation(map, "Speed", "⚡ Скорость", rgb(255, 190, 30), Vector3.new(-130, y, shopZ), toward)
	buildStation(map, "Stamina", "💪 Стамина", rgb(60, 210, 110), Vector3.new(-66, y, shopZ), toward)
	buildStation(map, "Donate", "⭐ Донат-магазин", rgb(255, 80, 200), Vector3.new(-26, y, shopZ + 6), toward)
	buildStation(map, "Wings", "🕊 Крылья", rgb(90, 160, 255), Vector3.new(66, y, shopZ), toward)
	buildStation(map, "Market", "💰 Рынок", rgb(255, 110, 50), Vector3.new(130, y, shopZ), toward)

	-- арка старта
	local white = rgb(255, 255, 255)
	for _, x in ipairs({ -16, 16 }) do
		cyl(map, Vector3.new(x, y + 11, front - 4), 2, 22, white, Enum.Material.Marble)
		local orb = ball(map, Vector3.new(4, 4, 4), Vector3.new(x, y + 24, front - 4), rgb(80, 220, 255), Enum.Material.Neon)
		light(orb, rgb(80, 220, 255), 30, 2)
	end
	local archTop = block(map, Vector3.new(36, 4, 3), CFrame.new(0, y + 21, front - 4), rgb(80, 160, 255))
	billboard(archTop, "ЗОНЫ ➜  держи ПРОБЕЛ", white, 4, 360, 60, false, 400)
	-- стартовая площадка
	cyl(map, Vector3.new(0, y + 0.3, front - 10), 9, 0.6, rgb(80, 220, 255), Enum.Material.Neon, deco({}))

	-- фонари вдоль дорожек
	for i = -7, 7 do
		if i ~= 0 then
			lamp(map, Vector3.new(i * 22, y, -12), FLOWER_COLORS[(math.abs(i) % #FLOWER_COLORS) + 1])
		end
	end
	for _, z in ipairs({ 58, 74 }) do
		lamp(map, Vector3.new(-11, y, z), rgb(80, 220, 255))
		lamp(map, Vector3.new(11, y, z), rgb(80, 220, 255))
	end
	-- клумбы у фонтана
	for i = 1, 30 do
		local a = rng:NextNumber(0, math.pi * 2)
		local d = rng:NextNumber(14, 19)
		flower(map, Vector3.new(math.cos(a) * d, y, 6 + math.sin(a) * d), FLOWER_COLORS[rng:NextInteger(1, #FLOWER_COLORS)])
	end
	-- пальмы и деревья по бокам и у пляжа
	for z = LOBBY_BACK_Z + 15, front - 10, 28 do
		palm(map, Vector3.new(-LOBBY_HALF_X + 6, y, z), 1.3)
		palm(map, Vector3.new(LOBBY_HALF_X - 6, y, z), 1.3)
	end
	for x = -150, 150, 40 do
		if math.abs(x) > 30 then
			roundTree(map, Vector3.new(x, y, front - 8), 1.1)
			bush(map, Vector3.new(x + 18, y, front - 6), rgb(70, 190, 80), 1)
		end
	end
	for x = -150, 150, 30 do
		bush(map, Vector3.new(x, y, LOBBY_BACK_Z + 8), rgb(70, 190, 80), 1.1)
	end
end

---------------------------------------------------------------------
-- острова
---------------------------------------------------------------------
local THEMES = {
	meadow = { ground = rgb(110, 215, 90), cliff = rgb(165, 130, 95), beach = rgb(250, 225, 150) },
	candy = { ground = rgb(255, 170, 215), cliff = rgb(190, 130, 255), beach = rgb(255, 245, 250) },
	tropical = { ground = rgb(120, 220, 100), cliff = rgb(200, 160, 110), beach = rgb(255, 230, 160) },
	volcano = { ground = rgb(95, 70, 70), cliff = rgb(60, 45, 45), beach = rgb(40, 30, 30) },
	ice = { ground = rgb(235, 248, 255), cliff = rgb(140, 200, 245), beach = rgb(200, 230, 255) },
	crystal = { ground = rgb(130, 90, 210), cliff = rgb(70, 50, 120), beach = rgb(180, 150, 240) },
	golden = { ground = rgb(255, 240, 170), cliff = rgb(245, 245, 250), beach = rgb(255, 220, 110) },
}

local function randomSpotOnIsland(center, radius, minFrac, maxFrac)
	local a = rng:NextNumber(0, math.pi * 2)
	local d = rng:NextNumber(minFrac, maxFrac) * radius
	return center + Vector3.new(math.cos(a) * d, 0, math.sin(a) * d)
end

local function decorateIsland(model, theme, center, r)
	local function ring(count, minF, maxF, fn)
		for i = 1, count do
			fn(randomSpotOnIsland(center, r, minF, maxF), i)
		end
	end
	if theme == "meadow" then
		ring(9, 0.7, 0.9, function(p) roundTree(model, p, rng:NextNumber(1, 1.4)) end)
		ring(8, 0.55, 0.85, function(p) bush(model, p, rgb(80, 200, 80)) end)
		ring(40, 0.15, 0.9, function(p, i) flower(model, p, FLOWER_COLORS[(i % #FLOWER_COLORS) + 1]) end)
		ring(5, 0.6, 0.85, function(p) mushroom(model, p, rgb(255, 70, 70), false) end)
		ring(4, 0.75, 0.9, function(p) rock(model, p, rgb(170, 165, 160)) end)
	elseif theme == "candy" then
		local colors = { rgb(255, 80, 150), rgb(110, 220, 255), rgb(255, 210, 60), rgb(150, 255, 150), rgb(200, 120, 255) }
		ring(10, 0.65, 0.9, function(p, i) lollipopTree(model, p, rng:NextNumber(1, 1.5), colors[(i % #colors) + 1]) end)
		ring(8, 0.5, 0.88, function(p) candyCane(model, p, rng:NextNumber(1, 1.6)) end)
		ring(14, 0.2, 0.9, function(p, i)
			ball(model, Vector3.new(2.4, 2, 2.4), p + Vector3.new(0, 0.8, 0), colors[(i % #colors) + 1], Enum.Material.Glass, { Transparency = 0.1 })
		end)
		ring(6, 0.55, 0.85, function(p) mushroom(model, p, rgb(255, 120, 200), true) end)
	elseif theme == "tropical" then
		ring(12, 0.7, 0.95, function(p) palm(model, p, rng:NextNumber(1.1, 1.5)) end)
		ring(8, 0.55, 0.85, function(p) bush(model, p, rgb(50, 190, 90)) end)
		ring(5, 0.75, 0.95, function(p) rock(model, p, rgb(210, 190, 150)) end)
		-- зонтики
		ring(3, 0.5, 0.7, function(p, i)
			cyl(model, p + Vector3.new(0, 3.5, 0), 0.25, 7, rgb(255, 255, 255))
			cyl(model, p + Vector3.new(0, 7.2, 0), 4, 0.5, i % 2 == 0 and rgb(255, 80, 80) or rgb(60, 170, 255), nil, deco({}))
		end)
		-- ракушки и морские звёзды
		ring(14, 0.2, 0.9, function(p, i)
			ball(model, Vector3.new(1.2, 0.5, 1.2), p + Vector3.new(0, 0.25, 0), i % 2 == 0 and rgb(255, 140, 100) or rgb(255, 200, 220), nil, deco({}))
		end)
	elseif theme == "volcano" then
		-- вулкан у края
		local vp = center + Vector3.new(r * 0.55, 0, r * 0.25)
		cyl(model, vp + Vector3.new(0, 4, 0), 16, 8, rgb(70, 50, 50), Enum.Material.Basalt)
		cyl(model, vp + Vector3.new(0, 11, 0), 11, 8, rgb(80, 55, 55), Enum.Material.Basalt)
		cyl(model, vp + Vector3.new(0, 17, 0), 7, 6, rgb(90, 60, 55), Enum.Material.Basalt)
		local crater = cyl(model, vp + Vector3.new(0, 20.2, 0), 5, 0.6, rgb(255, 100, 20), Enum.Material.Neon)
		light(crater, rgb(255, 120, 40), 40, 3)
		local fire = Instance.new("Fire")
		fire.Size = 14
		fire.Heat = 20
		fire.Parent = crater
		local smoke = Instance.new("Smoke")
		smoke.Size = 10
		smoke.RiseVelocity = 8
		smoke.Opacity = 0.15
		smoke.Parent = crater
		ring(7, 0.25, 0.85, function(p)
			local pool = cyl(model, p + Vector3.new(0, 0.1, 0), rng:NextNumber(2.5, 4.5), 0.4, rgb(255, 110, 20), Enum.Material.Neon, deco({}))
			light(pool, rgb(255, 120, 40), 12, 1)
		end)
		ring(8, 0.6, 0.9, function(p) rock(model, p, rgb(50, 40, 40), rng:NextNumber(1, 1.6)) end)
		ring(5, 0.5, 0.85, function(p) crystal(model, p, rgb(255, 60, 40), 0.9) end)
	elseif theme == "ice" then
		ring(10, 0.65, 0.92, function(p) pine(model, p, rng:NextNumber(1.1, 1.5), rgb(40, 130, 90), true) end)
		ring(8, 0.4, 0.88, function(p) crystal(model, p, rgb(150, 230, 255), rng:NextNumber(0.8, 1.3)) end)
		ring(3, 0.4, 0.7, function(p)
			ball(model, Vector3.new(4, 4, 4), p + Vector3.new(0, 2, 0), rgb(255, 255, 255), Enum.Material.Snow)
			ball(model, Vector3.new(3, 3, 3), p + Vector3.new(0, 5, 0), rgb(255, 255, 255), Enum.Material.Snow)
			ball(model, Vector3.new(2.2, 2.2, 2.2), p + Vector3.new(0, 7.2, 0), rgb(255, 255, 255), Enum.Material.Snow)
			block(model, Vector3.new(0.3, 0.3, 1.2), CFrame.new(p + Vector3.new(0, 7.2, -1.4)), rgb(255, 140, 30), nil, deco({}))
			block(model, Vector3.new(2, 0.4, 2), CFrame.new(p + Vector3.new(0, 8.4, 0)), rgb(30, 30, 40), nil, deco({}))
		end)
		ring(6, 0.3, 0.85, function(p) rock(model, p, rgb(170, 215, 245)) end)
	elseif theme == "crystal" then
		local colors = { rgb(90, 240, 255), rgb(255, 90, 220), rgb(170, 110, 255) }
		ring(14, 0.45, 0.92, function(p, i) crystal(model, p, colors[(i % #colors) + 1], rng:NextNumber(1, 1.9)) end)
		ring(10, 0.3, 0.9, function(p, i) mushroom(model, p, colors[(i % #colors) + 1], true, rng:NextNumber(0.8, 1.4)) end)
		ring(6, 0.6, 0.9, function(p) rock(model, p, rgb(80, 60, 130), 1.4) end)
	elseif theme == "golden" then
		-- кольцо колонн и пьедестал в центре
		for i = 1, 10 do
			local a = i / 10 * math.pi * 2
			local p = center + Vector3.new(math.cos(a), 0, math.sin(a)) * (r * 0.62)
			cyl(model, p + Vector3.new(0, 1, 0), 2.6, 2, rgb(255, 255, 255), Enum.Material.Marble)
			cyl(model, p + Vector3.new(0, 9, 0), 1.8, 14, rgb(250, 250, 255), Enum.Material.Marble)
			cyl(model, p + Vector3.new(0, 16.5, 0), 2.6, 1.4, rgb(255, 210, 60), Enum.Material.Metal)
			local orb = ball(model, Vector3.new(2, 2, 2), p + Vector3.new(0, 18.4, 0), rgb(255, 230, 100), Enum.Material.Neon)
			light(orb, rgb(255, 220, 120), 16, 1.5)
		end
		cyl(model, center + Vector3.new(0, 0.6, 0), 14, 1.2, rgb(255, 255, 255), Enum.Material.Marble)
		cyl(model, center + Vector3.new(0, 1.4, 0), 11, 0.5, rgb(255, 210, 60), Enum.Material.Neon, deco({}))
		ring(8, 0.75, 0.95, function(p) cloud(model, p + Vector3.new(0, 2, 0), 0.5) end)
		ring(20, 0.3, 0.9, function(p) flower(model, p, rgb(255, 225, 90)) end)
	end
end

local nextEdgeZ = Config.LobbyFrontZ

-- светящиеся огоньки-подсказки над водой между зонами
local function buildGuideLights(map, fromZ, toZ, color)
	local folder = Instance.new("Folder")
	folder.Name = "Guide"
	folder.Parent = map
	local step = 45
	local z = fromZ + step / 2
	while z < toZ - 10 do
		local orb = ball(folder, Vector3.new(2.4, 2.4, 2.4), Vector3.new(0, GY + 24 + math.sin(z / 60) * 4, z), color, Enum.Material.Neon, deco({ CastShadow = false }))
		orb.Transparency = 0.15
		z = z + step
	end
end

local function buildIsland(map, index, def)
	local model = Instance.new("Model")
	model.Name = "Island" .. index
	model.Parent = map
	local a = math.rad(index * 47)
	local r = def.radius
	local edge = r + 8
	local center = Vector3.new(0, GY, nextEdgeZ + def.gap + edge)
	def.centerZ = center.Z
	buildGuideLights(map, nextEdgeZ, nextEdgeZ + def.gap, Config.Rarities[def.rarity].color)
	nextEdgeZ = center.Z + edge
	local rarity = Config.Rarities[def.rarity]
	local theme = THEMES[def.theme] or THEMES.meadow

	-- слои: трава, пляж, скалы
	cyl(model, center - Vector3.new(0, 1.5, 0), r, 3, theme.ground, def.theme == "ice" and Enum.Material.Snow or Enum.Material.Grass)
	cyl(model, center - Vector3.new(0, 2.6, 0), r + 8, 3, theme.beach, Enum.Material.Sand)
	cyl(model, center - Vector3.new(0, 10, 0), r - 3, 14, theme.cliff, Enum.Material.Slate)
	cyl(model, center - Vector3.new(0, 20, 0), r * 0.7, 10, theme.cliff:Lerp(Color3.new(0, 0, 0), 0.15), Enum.Material.Slate)
	-- светящийся край цвета редкости
	cyl(model, center - Vector3.new(0, 1.35, 0), r + 0.6, 2.6, rarity.color, Enum.Material.Neon, deco({}))
	-- холмы по краю
	for h = 1, 3 do
		local ha = a + h * 2.2 + 0.6
		local hp = center + Vector3.new(math.cos(ha), 0, math.sin(ha)) * (r * 0.78)
		ball(model, Vector3.new(r * 0.5, 9, r * 0.5), hp, theme.ground:Lerp(Color3.new(0, 0, 0), 0.06), Enum.Material.Grass)
	end

	decorateIsland(model, def.theme, center, r)

	-- летающие камушки вокруг
	for k = 1, 5 do
		local fa = k / 5 * math.pi * 2 + a
		local fp = center + Vector3.new(math.cos(fa) * (r + 22), rng:NextNumber(18, 34), math.sin(fa) * (r + 22))
		cyl(model, fp, rng:NextNumber(4, 7), 3, theme.ground)
		cyl(model, fp - Vector3.new(0, 3, 0), 3.5, 4, theme.cliff, Enum.Material.Slate)
	end

	local signPart = part(deco({
		Parent = model,
		Name = "SignAnchor",
		Size = Vector3.new(1, 1, 1),
		CFrame = CFrame.new(center + Vector3.new(0, 42, 0)),
		Transparency = 1,
	}))
	billboard(signPart, "ЗОНА " .. index .. ": " .. def.name .. "\n" .. rarity.name, rarity.color, 0, 240, 70, true, 9000)

	-- ворота зоны на ближнем к лобби краю
	local gateZ = center.Z - r + 4
	for _, x in ipairs({ -12, 12 }) do
		cyl(model, Vector3.new(x, GY + 8, gateZ), 1.6, 16, rarity.color:Lerp(Color3.new(1, 1, 1), 0.4), Enum.Material.Marble)
		ball(model, Vector3.new(3, 3, 3), Vector3.new(x, GY + 17.5, gateZ), rarity.color, Enum.Material.Neon)
	end
	local gate = block(model, Vector3.new(28, 3, 2), CFrame.new(0, GY + 15.5, gateZ), rarity.color, Enum.Material.Neon)
	billboard(gate, "ЗОНА " .. index, Color3.new(1, 1, 1), 3, 200, 44, false, 300)

	local spawnPoints = {}
	for k = 1, def.spawns do
		local pos
		if def.spawns == 1 then
			pos = center + Vector3.new(0, 1.2, 0)
		else
			local sa = k / def.spawns * math.pi * 2 + a
			pos = center + Vector3.new(math.cos(sa), 0, math.sin(sa)) * (r * 0.32)
			-- маленький постамент под существом
			cyl(model, pos + Vector3.new(0, 0.3, 0), 3.4, 0.6, rarity.color, Enum.Material.Neon, deco({}))
		end
		spawnPoints[k] = CFrame.lookAt(pos, pos - Vector3.new(0, 0, 10))
	end

	MapBuilder.islands[index] = {
		model = model,
		center = center,
		def = def,
		spawnPoints = spawnPoints,
	}
end

function MapBuilder.build()
	buildLighting()
	local map = Instance.new("Folder")
	map.Name = "Map"
	map.Parent = workspace
	buildWater(map)
	buildClouds(map)
	buildStart(map)
	for index, def in ipairs(Config.Islands) do
		buildIsland(map, index, def)
	end
	local creatures = Instance.new("Folder")
	creatures.Name = "Creatures"
	creatures.Parent = workspace
	MapBuilder.creatureFolder = creatures
	return map
end

return MapBuilder
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000010"><Properties><string name="Name">MonetizationService</string><ProtectedString name="Source"><![CDATA[-- MonetizationService: Game Pass и Developer Product (покупки за Robux).
-- Пока в Config id = 0, в Studio покупка выдаётся бесплатно для теста.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local DataService = require(script.Parent.DataService)
local Net = require(script.Parent.Net)

local MonetizationService = {}

MonetizationService.onPassesChanged = nil -- функция(player), задаёт Main

local function passKeyById(id)
	for key, def in pairs(Config.GamePasses) do
		if def.id ~= 0 and def.id == id then
			return key
		end
	end
	return nil
end

local function productKeyById(id)
	for key, def in pairs(Config.Products) do
		if def.id ~= 0 and def.id == id then
			return key
		end
	end
	return nil
end

local function passesChanged(player)
	DataService.sync(player)
	if MonetizationService.onPassesChanged then
		MonetizationService.onPassesChanged(player)
	end
end

function MonetizationService.loadPasses(player)
	local profile = DataService.get(player)
	for key, def in pairs(Config.GamePasses) do
		if def.id ~= 0 then
			local ok, owns = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, def.id)
			end)
			if ok and owns then
				profile.passes[key] = true
			end
		end
	end
end

local function grantProduct(player, key)
	local def = Config.Products[key]
	if def.luck then
		local t = workspace:GetServerTimeNow()
		local untilT = math.max(workspace:GetAttribute("LuckUntil") or 0, t) + Config.LuckBoostSeconds
		workspace:SetAttribute("LuckUntil", untilT)
		Net.announce(player.DisplayName .. " включил Удачу сервера на 15 минут! 🍀", "divine")
	else
		local amount = Config.productAmount(key, DataService.income(player))
		DataService.addMoney(player, amount)
		Net.notify(player, "Получено " .. Config.formatMoney(amount) .. "! Спасибо за поддержку!", "success")
	end
	DataService.sync(player)
end

function MonetizationService.buyPass(player, key)
	local def = Config.GamePasses[key]
	if not def then
		return { ok = false, msg = "Нет такого товара" }
	end
	if DataService.hasPass(player, key) then
		return { ok = false, msg = "Уже куплено" }
	end
	if def.id == 0 then
		if RunService:IsStudio() then
			DataService.get(player).testPasses[key] = true
			passesChanged(player)
			return { ok = true, msg = "[ТЕСТ] Выдан " .. def.title .. " (только в Studio)" }
		end
		return { ok = false, msg = "Этот Game Pass ещё не настроен" }
	end
	MarketplaceService:PromptGamePassPurchase(player, def.id)
	return { ok = true, msg = "" }
end

function MonetizationService.buyProduct(player, key)
	local def = Config.Products[key]
	if not def then
		return { ok = false, msg = "Нет такого товара" }
	end
	if def.id == 0 then
		if RunService:IsStudio() then
			grantProduct(player, key)
			return { ok = true, msg = "[ТЕСТ] " .. def.title .. " выдан (только в Studio)" }
		end
		return { ok = false, msg = "Этот товар ещё не настроен" }
	end
	MarketplaceService:PromptProductPurchase(player, def.id)
	return { ok = true, msg = "" }
end

function MonetizationService.init()
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if not purchased then
			return
		end
		local key = passKeyById(passId)
		local profile = DataService.get(player)
		if key and profile then
			profile.passes[key] = true
			passesChanged(player)
			Net.notify(player, "Куплено: " .. Config.GamePasses[key].title .. "!", "success")
		end
	end)

	MarketplaceService.ProcessReceipt = function(receipt)
		local player = Players:GetPlayerByUserId(receipt.PlayerId)
		local profile = player and DataService.get(player)
		if not profile then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		local receipts = profile.data.receipts
		for _, rid in ipairs(receipts) do
			if rid == receipt.PurchaseId then
				return Enum.ProductPurchaseDecision.PurchaseGranted
			end
		end
		local key = productKeyById(receipt.ProductId)
		if not key then
			warn("[Monetization] Неизвестный ProductId " .. tostring(receipt.ProductId))
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		grantProduct(player, key)
		table.insert(receipts, receipt.PurchaseId)
		while #receipts > 50 do
			table.remove(receipts, 1)
		end
		if profile.canSave and not DataService.save(player) then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
end

return MonetizationService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000011"><Properties><string name="Name">Net</string><ProtectedString name="Source"><![CDATA[-- Net: создаёт RemoteEvent/RemoteFunction в ReplicatedStorage.Remotes.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = {}

local folder = ReplicatedStorage:FindFirstChild("Remotes")
if not folder then
	folder = Instance.new("Folder")
	folder.Name = "Remotes"
	folder.Parent = ReplicatedStorage
end

local function remote(className, name)
	local r = folder:FindFirstChild(name)
	if not r then
		r = Instance.new(className)
		r.Name = name
		r.Parent = folder
	end
	return r
end

Net.Notify = remote("RemoteEvent", "Notify") -- сервер -> клиент: всплывающее сообщение
Net.OpenPanel = remote("RemoteEvent", "OpenPanel") -- сервер -> клиент: открыть окно станции
Net.Request = remote("RemoteFunction", "Request") -- клиент -> сервер: покупки и продажа

function Net.notify(player, text, kind)
	Net.Notify:FireClient(player, text, kind or "info")
end

function Net.announce(text, kind)
	Net.Notify:FireAllClients(text, kind or "announce")
end

return Net
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000012"><Properties><string name="Name">PlotService</string><ProtectedString name="Source"><![CDATA[-- PlotService: 4 базы, выдача базы игроку, существа на подиумах,
-- накопление $ у каждого подиума и сбор наступлением на зелёную кнопку.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local MapBuilder = require(script.Parent.MapBuilder)
local CreatureFactory = require(script.Parent.CreatureFactory)
local DataService = require(script.Parent.DataService)
local Net = require(script.Parent.Net)

local PlotService = {}

local owners = {} -- owners[plotIndex] = player
local displayed = {} -- displayed[plotIndex] = { models }

local EMPTY_RIM = Color3.fromRGB(200, 200, 210)
local LOCKED = Color3.fromRGB(120, 120, 130)

local function resetPodiums(plot)
	for _, pod in pairs(plot.podiums) do
		pod.base.Color = Color3.new(1, 1, 1)
		pod.base.Transparency = 0
		pod.rim.Color = EMPTY_RIM
		pod.button.Transparency = 0.6
		pod.label.Text = ""
	end
end

function PlotService.assign(player)
	for index = 1, #MapBuilder.plots do
		if not owners[index] then
			owners[index] = player
			local profile = DataService.get(player)
			profile.plotIndex = index
			local plot = MapBuilder.plots[index]
			plot.sign.Label.Text = "База " .. player.DisplayName
			player:SetAttribute("PlotIndex", index)
			return index
		end
	end
	return nil
end

function PlotService.release(player)
	for index, owner in pairs(owners) do
		if owner == player then
			owners[index] = nil
			PlotService.clear(index)
			local plot = MapBuilder.plots[index]
			plot.sign.Label.Text = "Свободная база"
			resetPodiums(plot)
		end
	end
end

function PlotService.getPlot(player)
	local profile = DataService.get(player)
	if profile and profile.plotIndex then
		return MapBuilder.plots[profile.plotIndex]
	end
	return nil
end

function PlotService.clear(index)
	if displayed[index] then
		for _, m in ipairs(displayed[index]) do
			m:Destroy()
		end
	end
	displayed[index] = {}
end

-- Перерисовывает существ игрока на подиумах.
function PlotService.refresh(player)
	local profile = DataService.get(player)
	if not profile or not profile.plotIndex then
		return
	end
	local index = profile.plotIndex
	local plot = MapBuilder.plots[index]
	PlotService.clear(index)
	resetPodiums(plot)
	local maxSlots = DataService.maxSlots(player)
	for slot, pod in pairs(plot.podiums) do
		if slot > maxSlots then
			pod.base.Color = LOCKED
			pod.base.Transparency = 0.5
			pod.button.Transparency = 1
			pod.label.Text = "🔒"
		end
	end
	for slot, id in ipairs(profile.data.creatures) do
		local pod = plot.podiums[slot]
		if pod then
			local model = CreatureFactory.build(id, pod.top)
			model.Parent = plot.model
			table.insert(displayed[index], model)
			pod.rim.Color = Config.Rarities[Config.Creatures[id].rarity].color
			pod.button.Transparency = 0
		end
	end
	PlotService.updateLabels(player)
end

-- Обновляет надписи «$123» над кнопками.
function PlotService.updateLabels(player)
	local profile = DataService.get(player)
	local plot = PlotService.getPlot(player)
	if not profile or not plot then
		return
	end
	for slot, id in ipairs(profile.data.creatures) do
		local pod = plot.podiums[slot]
		if pod and id then
			pod.label.Text = Config.formatMoney(profile.data.pending[slot] or 0)
		end
	end
end

-- Каждую секунду: доход идёт в копилку подиума.
function PlotService.accumulate(player)
	local profile = DataService.get(player)
	if not profile then
		return
	end
	local pending = profile.data.pending
	for slot in ipairs(profile.data.creatures) do
		pending[slot] = (pending[slot] or 0) + DataService.slotIncome(player, slot)
	end
	PlotService.updateLabels(player)
end

-- Забрать деньги с одного подиума.
function PlotService.collect(player, slot)
	local profile = DataService.get(player)
	local amount = math.floor(profile.data.pending[slot] or 0)
	if amount <= 0 then
		return 0
	end
	profile.data.pending[slot] = 0
	DataService.addMoney(player, amount)
	return amount
end

-- Игрок стоит на кнопке у подиума?
function PlotService.checkCollect(player, position)
	local profile = DataService.get(player)
	local plot = PlotService.getPlot(player)
	if not profile or not plot then
		return
	end
	local total = 0
	for slot in ipairs(profile.data.creatures) do
		local pod = plot.podiums[slot]
		if pod then
			local d = pod.button.Position - position
			if math.abs(d.X) < Config.CollectRadius and math.abs(d.Z) < Config.CollectRadius and math.abs(d.Y) < 5 then
				total = total + PlotService.collect(player, slot)
			end
		end
	end
	if total > 0 then
		PlotService.updateLabels(player)
		DataService.sync(player)
		Net.notify(player, "+" .. Config.formatMoney(total), "success")
	end
end

-- Находится ли точка внутри базы игрока.
function PlotService.isInside(player, position)
	local plot = PlotService.getPlot(player)
	if not plot then
		return false
	end
	local rel = plot.cframe:PointToObjectSpace(position)
	return math.abs(rel.X) <= 31 and math.abs(rel.Z) <= 31 and rel.Y < 40 and rel.Y > -6
end

return PlotService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000013"><Properties><string name="Name">UpgradeService</string><ProtectedString name="Source"><![CDATA[-- UpgradeService: покупки за $ проверяются ТОЛЬКО на сервере.
-- Скорость, стамина, крылья, продажа существ.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local MapBuilder = require(script.Parent.MapBuilder)
local DataService = require(script.Parent.DataService)
local PlotService = require(script.Parent.PlotService)
local CharacterVisuals = require(script.Parent.CharacterVisuals)

local UpgradeService = {}

local STATION_RANGE = 25

local function nearStation(player, stationName)
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local station = MapBuilder.stations[stationName]
	if not root or not station then
		return false
	end
	return (root.Position - station.position).Magnitude <= STATION_RANGE
end

function UpgradeService.applyWalkSpeed(player)
	local profile = DataService.get(player)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if profile and hum then
		hum.WalkSpeed = Config.walkSpeed(profile.data.speedLevel)
	end
end

function UpgradeService.buyUpgrade(player, kind)
	local def = Config.Upgrades[kind]
	if not def then
		return { ok = false, msg = "Нет такой прокачки" }
	end
	if not nearStation(player, kind) then
		return { ok = false, msg = "Подойди к станции «" .. def.title .. "»" }
	end
	local profile = DataService.get(player)
	local field = kind == "Speed" and "speedLevel" or "staminaLevel"
	local level = profile.data[field]
	if level >= def.maxLevel then
		return { ok = false, msg = "Уже максимальный уровень!" }
	end
	local cost = Config.upgradeCost(kind, level)
	if profile.data.money < cost then
		return { ok = false, msg = "Не хватает " .. Config.formatMoney(cost - profile.data.money) }
	end
	profile.data.money = profile.data.money - cost
	profile.data[field] = level + 1
	if kind == "Speed" then
		UpgradeService.applyWalkSpeed(player)
	end
	DataService.sync(player)
	return { ok = true, msg = def.title .. " → уровень " .. (level + 1) }
end

-- купить столько уровней, сколько хватает денег
function UpgradeService.buyUpgradeMax(player, kind)
	local def = Config.Upgrades[kind]
	if not def then
		return { ok = false, msg = "Нет такой прокачки" }
	end
	if not nearStation(player, kind) then
		return { ok = false, msg = "Подойди к станции «" .. def.title .. "»" }
	end
	local profile = DataService.get(player)
	local field = kind == "Speed" and "speedLevel" or "staminaLevel"
	local bought, spent = 0, 0
	while profile.data[field] < def.maxLevel do
		local cost = Config.upgradeCost(kind, profile.data[field])
		if profile.data.money < cost then
			break
		end
		profile.data.money = profile.data.money - cost
		profile.data[field] = profile.data[field] + 1
		bought = bought + 1
		spent = spent + cost
	end
	if bought == 0 then
		return { ok = false, msg = "Не хватает денег" }
	end
	if kind == "Speed" then
		UpgradeService.applyWalkSpeed(player)
	end
	DataService.sync(player)
	return { ok = true, msg = def.title .. " +" .. bought .. " ур. за " .. Config.formatMoney(spent) }
end

function UpgradeService.buyWing(player, index)
	if type(index) ~= "number" then
		return { ok = false, msg = "Ошибка" }
	end
	if not nearStation(player, "Wings") then
		return { ok = false, msg = "Подойди к магазину крыльев" }
	end
	local profile = DataService.get(player)
	local current = profile.data.wing
	local def = Config.Wings[index]
	if not def then
		return { ok = false, msg = "Нет таких крыльев" }
	end
	if index <= current then
		return { ok = false, msg = "Уже куплено" }
	end
	if index ~= current + 1 then
		return { ok = false, msg = "Сначала купи " .. Config.Wings[current + 1].name }
	end
	if profile.data.money < def.cost then
		return { ok = false, msg = "Не хватает " .. Config.formatMoney(def.cost - profile.data.money) }
	end
	profile.data.money = profile.data.money - def.cost
	profile.data.wing = index
	CharacterVisuals.applyWings(player)
	DataService.sync(player)
	return { ok = true, msg = "Новые крылья: " .. def.name .. " (x" .. def.mult .. " стамина)" }
end

function UpgradeService.sell(player, slot)
	if not nearStation(player, "Market") then
		return { ok = false, msg = "Продавать можно только на рынке" }
	end
	local profile = DataService.get(player)
	local creatures = profile.data.creatures
	if type(slot) ~= "number" or not creatures[slot] then
		return { ok = false, msg = "Нет такого существа" }
	end
	local id = table.remove(creatures, slot)
	local stored = math.floor(table.remove(profile.data.pending, slot) or 0)
	local price = Config.sellPrice(id)
	DataService.addMoney(player, price + stored)
	PlotService.refresh(player)
	DataService.sync(player)
	return { ok = true, msg = "Продано " .. Config.Creatures[id].name .. " за " .. Config.formatMoney(price + stored) }
end

function UpgradeService.sellAll(player)
	if not nearStation(player, "Market") then
		return { ok = false, msg = "Продавать можно только на рынке" }
	end
	local profile = DataService.get(player)
	local count = #profile.data.creatures
	if count == 0 then
		return { ok = false, msg = "Нечего продавать" }
	end
	local total = 0
	for _, id in ipairs(profile.data.creatures) do
		total = total + Config.sellPrice(id)
	end
	for _, v in ipairs(profile.data.pending) do
		total = total + math.floor(v)
	end
	profile.data.creatures = {}
	profile.data.pending = {}
	DataService.addMoney(player, total)
	PlotService.refresh(player)
	DataService.sync(player)
	return { ok = true, msg = "Продано " .. count .. " существ за " .. Config.formatMoney(total) }
end

return UpgradeService
]]></ProtectedString></Properties></Item></Item></Item><Item class="StarterPlayer" referent="RBX00000020"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX00000019"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX00000016"><Properties><string name="Name">CreatureAnimator</string><ProtectedString name="Source"><![CDATA[-- CreatureAnimator: существа рядом с игроком подпрыгивают и покачиваются.
-- Анимация только на клиенте: сервер не нагружается.

local RunService = game:GetService("RunService")

local tracked = setmetatable({}, { __mode = "k" })
local models = {}
local rng = Random.new()

local function gather()
	local list = {}
	local creatures = workspace:FindFirstChild("Creatures")
	if creatures then
		for _, m in ipairs(creatures:GetChildren()) do
			if m:IsA("Model") then
				table.insert(list, m)
			end
		end
	end
	local map = workspace:FindFirstChild("Map")
	if map then
		for i = 1, 4 do
			local plot = map:FindFirstChild("Plot" .. i)
			if plot then
				for _, m in ipairs(plot:GetChildren()) do
					if m:IsA("Model") and m:GetAttribute("CreatureId") then
						table.insert(list, m)
					end
				end
			end
		end
	end
	models = list
end

task.spawn(function()
	while true do
		gather()
		task.wait(1)
	end
end)

local acc = 0
RunService.RenderStepped:Connect(function(dt)
	acc = acc + dt
	if acc < 1 / 30 then
		return
	end
	acc = 0
	local cam = workspace.CurrentCamera
	if not cam then
		return
	end
	local camPos = cam.CFrame.Position
	local t = os.clock()
	for _, model in ipairs(models) do
		local body = model.PrimaryPart
		if body and body.Parent and body.Anchored then
			local info = tracked[model]
			local current = model:GetPivot()
			if not info then
				info = { base = current, phase = rng:NextNumber(0, math.pi * 2) }
				tracked[model] = info
			elseif info.last and (current.Position - info.last.Position).Magnitude > 0.05 then
				-- сервер переставил модель — берём новую точку
				info.base = current
			end
			if (info.base.Position - camPos).Magnitude < 150 then
				local hop = math.abs(math.sin(t * 2.2 + info.phase)) * 0.6
				local cf = info.base * CFrame.new(0, hop, 0) * CFrame.Angles(0, math.sin(t * 0.9 + info.phase) * 0.3, 0)
				model:PivotTo(cf)
				info.last = cf
			end
		end
	end
end)
]]></ProtectedString><bool name="Disabled">false</bool></Properties></Item><Item class="LocalScript" referent="RBX00000017"><Properties><string name="Name">FlightController</string><ProtectedString name="Source"><![CDATA[-- FlightController: полёт на клиенте.
-- Прыгни и держи ПРОБЕЛ (или кнопку «Лететь») — взмах вверх, тратится стамина.
-- Отпустил — плавно снижаешься (стамина тоже тратится). Стамина 0 — падаешь.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ContextActionService = game:GetService("ContextActionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local player = Players.LocalPlayer

local character, humanoid, root
local flying = false
local holding = false
local exhausted = false
local stamina = 0
local flightTime = 0
local airTime = 0
local velocityConstraint, attachment
local wingWelds = {}

local function stats()
	local speedLevel = player:GetAttribute("SpeedLevel") or 0
	local staminaLevel = player:GetAttribute("StaminaLevel") or 0
	local wing = player:GetAttribute("Wing") or 1
	local staminaPass = player:GetAttribute("Pass_StaminaBoost") == true
	local carrying = (player:GetAttribute("Carrying") or "") ~= ""
	local maxStamina = Config.maxStamina(staminaLevel, wing, staminaPass)
	local speed = Config.flySpeed(speedLevel)
	if carrying then
		speed = speed * Config.CarrySpeedMult
	end
	return maxStamina, speed, Config.liftSpeed(wing), Config.maxFlightY(wing)
end

local function findWingWelds()
	wingWelds = {}
	local wings = character and character:FindFirstChild("Wings")
	if not wings then
		return
	end
	for _, d in ipairs(wings:GetDescendants()) do
		if d:IsA("Weld") and (d.Name == "LeftWingWeld" or d.Name == "RightWingWeld") then
			table.insert(wingWelds, { weld = d, base = d.C0, side = d.Name == "LeftWingWeld" and -1 or 1 })
		end
	end
end

local function stopFlight()
	flying = false
	if velocityConstraint then
		velocityConstraint:Destroy()
		velocityConstraint = nil
	end
	if attachment then
		attachment:Destroy()
		attachment = nil
	end
	for _, w in ipairs(wingWelds) do
		if w.weld.Parent then
			w.weld.C0 = w.base
		end
	end
end

local function startFlight()
	if flying or not root then
		return
	end
	flying = true
	flightTime = 0
	attachment = Instance.new("Attachment")
	attachment.Name = "FlyAttachment"
	attachment.Parent = root
	velocityConstraint = Instance.new("LinearVelocity")
	velocityConstraint.Name = "FlyVelocity"
	velocityConstraint.Attachment0 = attachment
	velocityConstraint.RelativeTo = Enum.ActuatorRelativeTo.World
	velocityConstraint.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
	velocityConstraint.MaxForce = math.huge
	velocityConstraint.VectorVelocity = root.AssemblyLinearVelocity
	velocityConstraint.Parent = root
	findWingWelds()
end

local function onCharacter(char)
	stopFlight()
	character = char
	humanoid = char:WaitForChild("Humanoid")
	root = char:WaitForChild("HumanoidRootPart")
	exhausted = false
	stamina = stats()
	char.ChildAdded:Connect(function(child)
		if child.Name == "Wings" then
			task.defer(findWingWelds)
		end
	end)
	humanoid.Died:Connect(stopFlight)
end

player.CharacterAdded:Connect(onCharacter)
if player.Character then
	task.spawn(onCharacter, player.Character)
end

ContextActionService:BindAction("Fly", function(_, state)
	if state == Enum.UserInputState.Begin then
		holding = true
	elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
		holding = false
	end
	return Enum.ContextActionResult.Pass -- обычный прыжок тоже работает
end, true, Enum.KeyCode.Space, Enum.KeyCode.ButtonA)
ContextActionService:SetTitle("Fly", "Лететь")
ContextActionService:SetPosition("Fly", UDim2.new(1, -170, 1, -150))

RunService.RenderStepped:Connect(function(dt)
	if not humanoid or not root or humanoid.Health <= 0 then
		return
	end
	local maxStamina, speed, lift, maxY = stats()
	local airborne = humanoid.FloorMaterial == Enum.Material.Air
	if airborne then
		airTime = airTime + dt
	else
		airTime = 0
	end

	if flying then
		flightTime = flightTime + dt
		stamina = stamina - dt
		if stamina <= 0 then
			stamina = 0
			exhausted = true
			stopFlight()
		elseif not airborne and flightTime > 0.4 then
			stopFlight()
		else
			local vy = holding and lift or -Config.SinkSpeed
			if vy > 0 and root.Position.Y >= maxY then
				vy = 0
			end
			local move = humanoid.MoveDirection
			velocityConstraint.VectorVelocity = Vector3.new(move.X * speed, vy, move.Z * speed)
			-- взмахи крыльев
			local amp = holding and 0.7 or 0.25
			local freq = holding and 14 or 5
			for _, w in ipairs(wingWelds) do
				if w.weld.Parent then
					w.weld.C0 = w.base * CFrame.Angles(0, 0, w.side * math.sin(flightTime * freq) * amp)
				end
			end
		end
	else
		if not airborne then
			exhausted = false
			stamina = math.min(maxStamina, stamina + maxStamina / Config.StaminaRegenTime * dt)
		elseif holding and not exhausted and stamina > 0.2 and airTime > 0.15 then
			startFlight()
		end
	end

	stamina = math.min(stamina, maxStamina)
	-- для UI (локальные атрибуты не уходят на сервер)
	player:SetAttribute("StaminaFrac", maxStamina > 0 and stamina / maxStamina or 0)
	player:SetAttribute("StaminaValue", stamina)
	player:SetAttribute("StaminaMax", maxStamina)
	player:SetAttribute("Flying", flying)
end)
]]></ProtectedString><bool name="Disabled">false</bool></Properties></Item><Item class="LocalScript" referent="RBX00000018"><Properties><string name="Name">UIController</string><ProtectedString name="Source"><![CDATA[-- UIController: интерфейс в стиле ярких симуляторов.
-- Деньги сверху, меню слева, таймер справа, стамина снизу,
-- окна магазинов с карточками, вкладками и анимациями.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local Request = Remotes:WaitForChild("Request")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local FONT = Enum.Font.FredokaOne
local TITLE_FONT = Enum.Font.LuckiestGuy

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local C = {
	white = rgb(255, 255, 255),
	black = rgb(0, 0, 0),
	green = rgb(60, 220, 90),
	greenDark = rgb(30, 160, 60),
	grey = rgb(150, 150, 165),
	greyDark = rgb(95, 95, 110),
	gold = rgb(255, 210, 50),
	goldDark = rgb(240, 150, 20),
	red = rgb(255, 70, 70),
	redDark = rgb(190, 30, 40),
	pink = rgb(255, 90, 200),
	pinkDark = rgb(190, 40, 160),
	blue = rgb(70, 170, 255),
	blueDark = rgb(30, 100, 220),
	panel = rgb(255, 250, 240),
	panelDark = rgb(235, 225, 210),
}

local THEMES = {
	Speed = { title = "⚡ СКОРОСТЬ", a = rgb(255, 210, 50), b = rgb(255, 140, 20) },
	Stamina = { title = "💪 СТАМИНА", a = rgb(90, 230, 120), b = rgb(30, 160, 80) },
	Wings = { title = "🕊 КРЫЛЬЯ", a = rgb(110, 190, 255), b = rgb(50, 110, 240) },
	Market = { title = "💰 РЫНОК", a = rgb(255, 160, 70), b = rgb(240, 90, 40) },
	Donate = { title = "⭐ МАГАЗИН", a = rgb(255, 110, 210), b = rgb(170, 70, 255) },
	Index = { title = "📖 ИНДЕКС", a = rgb(120, 220, 255), b = rgb(90, 120, 255) },
}

---------------------------------------------------------------------
-- помощники
---------------------------------------------------------------------
local function new(className, props, children)
	local inst = Instance.new(className)
	for k, v in pairs(props) do
		if k ~= "Parent" then
			inst[k] = v
		end
	end
	for _, child in ipairs(children or {}) do
		child.Parent = inst
	end
	inst.Parent = props.Parent
	return inst
end

local function corner(r)
	return new("UICorner", { CornerRadius = UDim.new(0, r or 12) })
end

local function stroke(t, color)
	return new("UIStroke", { Color = color or C.black, Thickness = t or 3, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end

local function gradient(a, b, rot)
	return new("UIGradient", { Color = ColorSequence.new(a, b), Rotation = rot or 90 })
end

local function label(props)
	props.BackgroundTransparency = props.BackgroundTransparency or 1
	props.Font = props.Font or FONT
	props.TextColor3 = props.TextColor3 or C.white
	if props.TextScaled == nil then
		props.TextScaled = true
	end
	local strokeT = props.StrokeT or 2
	props.StrokeT = nil
	return new("TextLabel", props, { new("UIStroke", { Thickness = strokeT, Color = C.black }) })
end

-- кнопка с градиентом, обводкой и «пружинкой» при нажатии
local function button(props, onClick)
	local a, b = props.ColorA or C.green, props.ColorB or C.greenDark
	props.ColorA, props.ColorB = nil, nil
	props.BackgroundColor3 = C.white
	props.AutoButtonColor = false
	props.Text = ""
	local text = props.Label or ""
	props.Label = nil
	local textSize = props.TextHeight or 0.75
	props.TextHeight = nil
	local btn = new("TextButton", props, { corner(10), stroke(3), gradient(a, b) })
	local scale = new("UIScale", { Parent = btn })
	label({
		Parent = btn,
		Name = "Caption",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.9, textSize),
		Text = text,
	})
	btn.MouseEnter:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.1), { Scale = 1.06 }):Play()
	end)
	btn.MouseLeave:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.1), { Scale = 1 }):Play()
	end)
	btn.MouseButton1Down:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.06), { Scale = 0.92 }):Play()
	end)
	btn.MouseButton1Up:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.12, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	end)
	btn.MouseButton1Click:Connect(onClick)
	return btn
end

local function decode(attr)
	local ok, v = pcall(function()
		return HttpService:JSONDecode(player:GetAttribute(attr) or "[]")
	end)
	return ok and v or {}
end

---------------------------------------------------------------------
-- экран
---------------------------------------------------------------------
local gui = new("ScreenGui", {
	Name = "GameUI",
	ResetOnSpawn = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	Parent = playerGui,
})
local uiScale = new("UIScale", { Parent = gui })
local function updateScale()
	local cam = workspace.CurrentCamera
	if cam then
		local v = cam.ViewportSize
		uiScale.Scale = math.clamp(math.min(v.X / 1100, v.Y / 720), 0.55, 1.15)
	end
end
updateScale()
workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)

-- деньги сверху
local moneyPill = new("Frame", {
	Parent = gui,
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 10),
	Size = UDim2.fromOffset(300, 58),
	BackgroundColor3 = C.white,
}, { corner(29), stroke(4), gradient(rgb(110, 230, 110), rgb(40, 170, 70)) })
label({ Parent = moneyPill, Position = UDim2.fromOffset(6, 4), Size = UDim2.fromOffset(50, 50), Text = "💵", StrokeT = 0 })
local moneyLabel = label({ Parent = moneyPill, Position = UDim2.fromOffset(58, 6), Size = UDim2.new(1, -70, 1, -12), Text = "$0", Font = TITLE_FONT, TextXAlignment = Enum.TextXAlignment.Left, StrokeT = 3 })

local chips = new("Frame", {
	Parent = gui,
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 72),
	Size = UDim2.fromOffset(420, 28),
	BackgroundTransparency = 1,
}, { new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 8) }) })
local function chip(a, b)
	local f = new("Frame", { Parent = chips, Size = UDim2.fromOffset(160, 28), BackgroundColor3 = C.white }, { corner(14), stroke(3), gradient(a, b) })
