headerFillGrad.Parent = headerFill
local titleLabel = label({ Parent = header, Position = UDim2.fromOffset(20, 8), Size = UDim2.new(1, -110, 1, -16), Text = "", Font = TITLE_FONT, TextXAlignment = Enum.TextXAlignment.Left, StrokeT = 3 })

