<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><Meta name="ExplicitAutoJoints">true</Meta><Item class="Workspace" referent="RBX00000020"><Properties><string name="Name">Workspace</string><bool name="StreamingEnabled">false</bool></Properties></Item><Item class="ReplicatedStorage" referent="RBX00000003"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX00000002"><Properties><string name="Name">Shared</string></Properties><Item class="ModuleScript" referent="RBX00000001"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[-- Config: весь баланс игры в одном месте.
-- Меняй цифры здесь — сервер и клиент читают этот же модуль.

local Config = {}

---------------------------------------------------------------------
-- Сервер и база
---------------------------------------------------------------------
Config.MaxPlayers = 4            -- выставь то же число в Game Settings -> Places
Config.BaseSlots = 10            -- слотов для существ на базе
Config.ExtraSlotsPass = 5        -- +слоты за Game Pass
Config.StartMoney = 0
Config.AutosaveSeconds = 60
Config.DataStoreName = "WingsAndBrainrots_v1"

Config.WaterLevel = 0            -- верх воды
Config.GroundY = 8               -- верх стартовой платформы и островов
Config.FallDeathY = -4           -- ниже этого = упал в воду

---------------------------------------------------------------------
-- Прокачка (цена = база * 1.5 ^ уровень)
---------------------------------------------------------------------
Config.CostGrowth = 1.5
Config.Upgrades = {
	Speed = { baseCost = 50, maxLevel = 40, title = "Скорость" },
	Stamina = { baseCost = 75, maxLevel = 40, title = "Стамина" },
}

function Config.upgradeCost(kind, level)
	local def = Config.Upgrades[kind]
	return math.floor(def.baseCost * Config.CostGrowth ^ level)
end

---------------------------------------------------------------------
-- Крылья: множитель стамины и силы полёта
---------------------------------------------------------------------
Config.Wings = {
	{ name = "Перьевые крылья", mult = 1.0, cost = 0, color = Color3.fromRGB(245, 245, 245) },
	{ name = "Стрекозьи крылья", mult = 1.5, cost = 500, color = Color3.fromRGB(120, 230, 200) },
	{ name = "Облачные крылья", mult = 2.0, cost = 5000, color = Color3.fromRGB(190, 220, 255) },
	{ name = "Огненные крылья", mult = 2.5, cost = 40000, color = Color3.fromRGB(255, 120, 40) },
	{ name = "Ледяные крылья", mult = 3.0, cost = 250000, color = Color3.fromRGB(110, 200, 255) },
	{ name = "Звёздные крылья", mult = 4.0, cost = 1500000, color = Color3.fromRGB(170, 110, 255) },
	{ name = "Небесные крылья", mult = 5.0, cost = 10000000, color = Color3.fromRGB(255, 220, 90) },
}

---------------------------------------------------------------------
-- Формулы полёта и бега
---------------------------------------------------------------------
Config.CarrySpeedMult = 0.85     -- с существом в руках летишь медленнее
Config.StaminaPassMult = 1.5     -- Game Pass +50% стамины

function Config.walkSpeed(speedLevel)
	return 16 + speedLevel * 0.6
end

function Config.flySpeed(speedLevel)
	return 24 + speedLevel * 1.0
end

-- стамина = секунды полёта
function Config.maxStamina(staminaLevel, wingIndex, hasStaminaPass)
	local wing = Config.Wings[wingIndex] or Config.Wings[1]
	local value = (8 + staminaLevel * 0.6) * wing.mult
	if hasStaminaPass then
		value = value * Config.StaminaPassMult
	end
	return value
end

function Config.liftSpeed(wingIndex)
	local wing = Config.Wings[wingIndex] or Config.Wings[1]
	return 18 + 4 * wing.mult
end

function Config.maxFlightY(wingIndex)
	local wing = Config.Wings[wingIndex] or Config.Wings[1]
	return Config.GroundY + 60 + 25 * wing.mult
end

Config.SinkSpeed = 10            -- скорость снижения без пробела
Config.StaminaRegenTime = 2.5    -- секунд на земле до полной стамины

---------------------------------------------------------------------
-- Редкости и существа
---------------------------------------------------------------------
Config.Rarities = {
	{ key = "Common", name = "Обычный", color = Color3.fromRGB(200, 200, 200) },
	{ key = "Uncommon", name = "Необычный", color = Color3.fromRGB(90, 220, 90) },
	{ key = "Rare", name = "Редкий", color = Color3.fromRGB(70, 150, 255) },
	{ key = "Epic", name = "Эпический", color = Color3.fromRGB(180, 80, 255) },
	{ key = "Legendary", name = "Легендарный", color = Color3.fromRGB(255, 170, 0) },
	{ key = "Mythic", name = "Мифический", color = Color3.fromRGB(255, 60, 90) },
	{ key = "Divine", name = "Божественный", color = Color3.fromRGB(255, 240, 120) },
}

-- rarity = номер редкости, income = $/сек, weight = шанс среди своей редкости
Config.Creatures = {
	frog_slipper = { name = "Лягушонок-Тапок", rarity = 1, income = 1, weight = 70 },
	dumpling = { name = "Пельмешек", rarity = 1, income = 2, weight = 30 },
	cactus_runner = { name = "Кактус-Бегун", rarity = 2, income = 8, weight = 70 },
	mushroom_hedgehog = { name = "Грибной Ёжик", rarity = 2, income = 12, weight = 30 },
	jelly_teapot = { name = "Медузий Чайник", rarity = 3, income = 40, weight = 70 },
	banana_crab = { name = "Банановый Краб", rarity = 3, income = 65, weight = 30 },
	fire_hamster = { name = "Огненный Хомяк", rarity = 4, income = 220, weight = 70 },
	cloud_sheep = { name = "Облачная Овечка", rarity = 4, income = 320, weight = 30 },
	owl_king = { name = "Совиный Король", rarity = 5, income = 1100, weight = 70 },
	rocket_penguin = { name = "Ракетный Пингвин", rarity = 5, income = 1700, weight = 30 },
	crystal_whale = { name = "Кристальный Кит", rarity = 6, income = 6500, weight = 70 },
	shadow_fox = { name = "Теневой Лис", rarity = 6, income = 9500, weight = 30 },
	sun_dragon = { name = "Солнечный Дракоша", rarity = 7, income = 75000, weight = 100 },
}

Config.SellSeconds = 60          -- цена продажи = доход * 60

function Config.sellPrice(creatureId)
	local def = Config.Creatures[creatureId]
	if not def then
		return 0
	end
	return def.income * Config.SellSeconds
end

---------------------------------------------------------------------
-- Острова: каждый следующий дальше, промежуток растёт
---------------------------------------------------------------------
Config.Islands = {
	{ distance = 220, angle = 20, radius = 32, rarity = 1, spawns = 4 },
	{ distance = 420, angle = 75, radius = 34, rarity = 2, spawns = 4 },
	{ distance = 680, angle = 130, radius = 36, rarity = 3, spawns = 4 },
	{ distance = 1000, angle = 185, radius = 38, rarity = 4, spawns = 3 },
	{ distance = 1400, angle = 240, radius = 40, rarity = 5, spawns = 3 },
	{ distance = 1900, angle = 295, radius = 42, rarity = 6, spawns = 3 },
	{ distance = 2600, angle = 350, radius = 46, rarity = 7, spawns = 1 },
}

Config.RespawnMin = 20           -- секунд до нового существа на месте
Config.RespawnMax = 45
Config.DivineInterval = 300      -- божественный раз в 5 минут
Config.LuckChance = 0.05         -- шанс, что появится существо следующей редкости
Config.LuckBoostChance = 0.15    -- то же при донатной удаче
Config.LuckBoostSeconds = 15 * 60

---------------------------------------------------------------------
-- Донат. ID создаёшь в Creator Dashboard и вставляешь сюда.
-- Пока ID = 0, в Studio покупка срабатывает как тест (бесплатно, до выхода).
-- Цены в Robux задаются на сайте Roblox; здесь они только для текста в магазине.
---------------------------------------------------------------------
Config.GamePasses = {
	GoldName = { id = 0, price = 5, title = "Золотое имя", desc = "Золотое имя над головой" },
	DoubleMoney = { id = 0, price = 12, title = "2x прибыль навсегда", desc = "Весь доход x2" },
	ExtraSlots = { id = 0, price = 25, title = "+5 слотов", desc = "Больше места для существ на базе" },
	StaminaBoost = { id = 0, price = 39, title = "+50% стамины", desc = "Летаешь в 1.5 раза дольше" },
	VIP = { id = 0, price = 59, title = "VIP", desc = "1.2x доход, золотое имя, блеск крыльев" },
}
Config.GamePassOrder = { "GoldName", "DoubleMoney", "ExtraSlots", "StaminaBoost", "VIP" }

-- Денежные пакеты: max(minAmount, доход в секунду * seconds)
Config.Products = {
	MoneySmall = { id = 0, price = 19, title = "Мешочек $", seconds = 10 * 60, minAmount = 1000 },
	MoneyMedium = { id = 0, price = 49, title = "Сумка $", seconds = 30 * 60, minAmount = 5000 },
	MoneyLarge = { id = 0, price = 99, title = "Сундук $", seconds = 2 * 3600, minAmount = 25000 },
	MoneyHuge = { id = 0, price = 199, title = "Хранилище $", seconds = 6 * 3600, minAmount = 150000 },
	ServerLuck = { id = 0, price = 19, title = "Удача сервера 15 мин", luck = true },
}
Config.ProductOrder = { "MoneySmall", "MoneyMedium", "MoneyLarge", "MoneyHuge", "ServerLuck" }

Config.DoubleMoneyMult = 2
Config.VipMult = 1.2

function Config.productAmount(productKey, incomePerSecond)
	local def = Config.Products[productKey]
	if not def or not def.seconds then
		return 0
	end
	return math.max(def.minAmount, math.floor(incomePerSecond * def.seconds))
end

---------------------------------------------------------------------
-- Форматирование денег: 1500 -> "$1.5K"
---------------------------------------------------------------------
local suffixes = { "", "K", "M", "B", "T", "Qa", "Qi" }

function Config.formatNumber(n)
	n = math.floor(n or 0)
	local i = 1
	local value = n
	while math.abs(value) >= 1000 and i < #suffixes do
		value = value / 1000
		i = i + 1
	end
	if i == 1 then
		return tostring(n)
	end
	local text = string.format("%.1f", value)
	text = string.gsub(text, "%.0$", "")
	return text .. suffixes[i]
end

function Config.formatMoney(n)
	return "$" .. Config.formatNumber(n)
end

return Config
]]></ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX00000015"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX00000004"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[-- Main: точка входа сервера Wings & Brainrots.

local Players = game:GetService("Players")

local Services = game:GetService("ServerScriptService"):WaitForChild("Services")
local Net = require(Services.Net)
local MapBuilder = require(Services.MapBuilder)
local DataService = require(Services.DataService)
local PlotService = require(Services.PlotService)
local BrainrotService = require(Services.BrainrotService)
local UpgradeService = require(Services.UpgradeService)
local MonetizationService = require(Services.MonetizationService)
local CharacterVisuals = require(Services.CharacterVisuals)

Players.CharacterAutoLoads = false

MapBuilder.build()
DataService.init()
BrainrotService.init()
MonetizationService.init()

MonetizationService.onPassesChanged = function(player)
	PlotService.refresh(player)
	CharacterVisuals.apply(player)
end

-- окна станций открываются по ProximityPrompt
for name, station in pairs(MapBuilder.stations) do
	station.prompt.Triggered:Connect(function(player)
		Net.OpenPanel:FireClient(player, name)
	end)
end

-- все запросы клиента идут сюда; сервер сам проверяет деньги и расстояние
local handlers = {
	BuyUpgrade = function(player, arg)
		return UpgradeService.buyUpgrade(player, arg)
	end,
	BuyWing = function(player, arg)
		return UpgradeService.buyWing(player, arg)
	end,
	Sell = function(player, arg)
		return UpgradeService.sell(player, arg)
	end,
	SellAll = function(player)
		return UpgradeService.sellAll(player)
	end,
	BuyPass = function(player, arg)
		return MonetizationService.buyPass(player, arg)
	end,
	BuyProduct = function(player, arg)
		return MonetizationService.buyProduct(player, arg)
	end,
}

local lastRequest = {}
Net.Request.OnServerInvoke = function(player, action, arg)
	if not DataService.get(player) then
		return { ok = false, msg = "Данные ещё загружаются" }
	end
	local t = os.clock()
	if lastRequest[player] and t - lastRequest[player] < 0.15 then
		return { ok = false, msg = "" }
	end
	lastRequest[player] = t
	local handler = handlers[action]
	if not handler then
		return { ok = false, msg = "Неизвестное действие" }
	end
	local ok, result = pcall(handler, player, arg)
	if not ok then
		warn("[Main] Ошибка в " .. tostring(action) .. ": " .. tostring(result))
		return { ok = false, msg = "Ошибка сервера" }
	end
	return result
end

local function onCharacter(player, char)
	local hum = char:WaitForChild("Humanoid")
	char:WaitForChild("HumanoidRootPart")
	UpgradeService.applyWalkSpeed(player)
	CharacterVisuals.apply(player)
	task.defer(function()
		BrainrotService.teleportHome(player)
	end)
	hum.Died:Connect(function()
		BrainrotService.drop(player)
		task.wait(3)
		if player.Parent then
			player:LoadCharacter()
		end
	end)
end

local function onPlayerAdded(player)
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	local money = Instance.new("IntValue")
	money.Name = "$"
	money.Parent = stats
	local count = Instance.new("IntValue")
	count.Name = "Существа"
	count.Parent = stats
	stats.Parent = player

	DataService.load(player)
	if not player.Parent then
		DataService.release(player)
		return
	end
	MonetizationService.loadPasses(player)
	if not PlotService.assign(player) then
		player:Kick("Сервер заполнен, попробуй другой")
		return
	end
	PlotService.refresh(player)
	DataService.sync(player)
	player:SetAttribute("Loaded", true)

	player.CharacterAdded:Connect(function(char)
		onCharacter(player, char)
	end)
	player:LoadCharacter()
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, p in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, p)
end

Players.PlayerRemoving:Connect(function(player)
	lastRequest[player] = nil
	if not DataService.get(player) then
		return
	end
	BrainrotService.drop(player)
	PlotService.release(player)
	DataService.release(player)
end)

-- доход каждую секунду
task.spawn(function()
	while true do
		task.wait(1)
		for player, profile in pairs(DataService.all()) do
			if player.Parent and profile.plotIndex then
				local income = DataService.income(player)
				if income > 0 then
					DataService.addMoney(player, income)
				end
				DataService.sync(player)
			end
		end
	end
end)
]]></ProtectedString><bool name="Disabled">false</bool></Properties></Item><Item class="Folder" referent="RBX00000014"><Properties><string name="Name">Services</string></Properties><Item class="ModuleScript" referent="RBX00000005"><Properties><string name="Name">BrainrotService</string><ProtectedString name="Source"><![CDATA[-- BrainrotService: спавн существ на островах, захват, переноска, доставка на базу.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local MapBuilder = require(script.Parent.MapBuilder)
local CreatureFactory = require(script.Parent.CreatureFactory)
local DataService = require(script.Parent.DataService)
local PlotService = require(script.Parent.PlotService)
local Net = require(script.Parent.Net)

local BrainrotService = {}

local spawnEntries = {} -- список { island, cframe, model, carriedBy, nextSpawn, divine }
local divineEntry = nil
local rng = Random.new()

local function now()
	return workspace:GetServerTimeNow()
end

local function creaturesOfRarity(rarity)
	local list = {}
	for id, def in pairs(Config.Creatures) do
		if def.rarity == rarity then
			table.insert(list, { id = id, weight = def.weight })
		end
	end
	table.sort(list, function(a, b)
		return a.id < b.id
	end)
	return list
end

function BrainrotService.luckActive()
	return (workspace:GetAttribute("LuckUntil") or 0) > now()
end

local function pickCreature(rarity)
	if rarity < 6 then
		local chance = BrainrotService.luckActive() and Config.LuckBoostChance or Config.LuckChance
		if rng:NextNumber() < chance then
			rarity = rarity + 1
		end
	end
	local list = creaturesOfRarity(rarity)
	local total = 0
	for _, c in ipairs(list) do
		total = total + c.weight
	end
	local roll = rng:NextNumber() * total
	for _, c in ipairs(list) do
		roll = roll - c.weight
		if roll <= 0 then
			return c.id
		end
	end
	return list[#list].id
end

local function getRoot(player)
	local char = player.Character
	if not char then
		return nil
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then
		return nil
	end
	return char:FindFirstChild("HumanoidRootPart")
end

local function spawnAt(entry, id)
	local model = CreatureFactory.build(id, entry.cframe)
	model.Parent = MapBuilder.creatureFolder
	entry.model = model
	entry.id = id
	entry.carriedBy = nil

	local pp = Instance.new("ProximityPrompt")
	pp.Name = "GrabPrompt"
	pp.ActionText = "Схватить"
	pp.ObjectText = Config.Creatures[id].name
	pp.HoldDuration = 0.3
	pp.MaxActivationDistance = 14
	pp.RequiresLineOfSight = false
	pp.KeyboardKeyCode = Enum.KeyCode.E
	pp.Parent = model.PrimaryPart
	pp.Triggered:Connect(function(player)
		BrainrotService.grab(player, entry)
	end)
end

function BrainrotService.grab(player, entry)
	local profile = DataService.get(player)
	if not profile or profile.carrying then
		if profile and profile.carrying then
			Net.notify(player, "Ты уже несёшь существо!", "error")
		end
		return
	end
	if not entry.model or entry.carriedBy then
		return
	end
	local root = getRoot(player)
	if not root then
		return
	end
	if (root.Position - entry.model.PrimaryPart.Position).Magnitude > 20 then
		return
	end

	entry.carriedBy = player
	local model = entry.model
	local prompt = model.PrimaryPart:FindFirstChild("GrabPrompt")
	if prompt then
		prompt.Enabled = false
	end
	CreatureFactory.setAnchored(model, false)
	local _, size = model:GetBoundingBox()
	model:PivotTo(root.CFrame * CFrame.new(0, 2.5 + size.Y / 2, 0))
	local w = Instance.new("WeldConstraint")
	w.Name = "CarryWeld"
	w.Part0 = root
	w.Part1 = model.PrimaryPart
	w.Parent = model.PrimaryPart

	profile.carrying = { id = entry.id, entry = entry }
	DataService.sync(player)

	local def = Config.Creatures[entry.id]
	if def.rarity >= 7 then
		Net.announce(player.DisplayName .. " схватил " .. def.name .. "!", "divine")
	else
		Net.notify(player, "Неси " .. def.name .. " на свою базу!", "info")
	end
end

-- Существо возвращается на своё место на острове.
function BrainrotService.drop(player)
	local profile = DataService.get(player)
	if not profile or not profile.carrying then
		return
	end
	local entry = profile.carrying.entry
	profile.carrying = nil
	if entry.model and entry.model.Parent then
		local weld = entry.model.PrimaryPart:FindFirstChild("CarryWeld")
		if weld then
			weld:Destroy()
		end
		CreatureFactory.setAnchored(entry.model, true)
		entry.model:PivotTo(entry.cframe * CFrame.new(0, (entry.model.PrimaryPart.Size.Y / 2 + 0.9 * CreatureFactory.scaleFor(entry.id)), 0))
		local prompt = entry.model.PrimaryPart:FindFirstChild("GrabPrompt")
		if prompt then
			prompt.Enabled = true
		end
		entry.carriedBy = nil
	else
		entry.model = nil
		entry.carriedBy = nil
		entry.nextSpawn = now() + Config.RespawnMin
	end
	if player.Parent then
		DataService.sync(player)
	end
end

local function deliver(player, profile)
	local entry = profile.carrying.entry
	local id = profile.carrying.id
	if #profile.data.creatures >= DataService.maxSlots(player) then
		if not profile.fullWarnAt or os.clock() - profile.fullWarnAt > 5 then
			profile.fullWarnAt = os.clock()
			Net.notify(player, "База заполнена! Продай существ на рынке.", "error")
		end
		return
	end
	profile.carrying = nil
	if entry.model then
		entry.model:Destroy()
	end
	entry.model = nil
	entry.carriedBy = nil
	if not entry.divine then
		entry.nextSpawn = now() + rng:NextNumber(Config.RespawnMin, Config.RespawnMax)
	end
	table.insert(profile.data.creatures, id)
	PlotService.refresh(player)
	DataService.sync(player)
	local def = Config.Creatures[id]
	Net.notify(player, def.name .. " теперь на базе! +" .. Config.formatMoney(def.income) .. "/сек", "success")
	if def.rarity >= 7 then
		Net.announce(player.DisplayName .. " доставил " .. def.name .. " на базу!", "divine")
	end
end

function BrainrotService.teleportHome(player)
	local plot = PlotService.getPlot(player)
	local char = player.Character
	if plot and char then
		char:PivotTo(plot.spawnCFrame)
		local root = char:FindFirstChild("HumanoidRootPart")
		if root then
			root.AssemblyLinearVelocity = Vector3.zero
		end
	end
end

local function tick()
	local t = now()
	-- обычные острова
	for _, entry in ipairs(spawnEntries) do
		if not entry.divine and not entry.model and t >= (entry.nextSpawn or 0) then
			spawnAt(entry, pickCreature(entry.rarity))
		end
	end
	-- божественный
	local nextDivine = workspace:GetAttribute("DivineNextSpawn") or 0
	if divineEntry and t >= nextDivine then
		workspace:SetAttribute("DivineNextSpawn", t + Config.DivineInterval)
		if not divineEntry.model then
			spawnAt(divineEntry, pickCreature(7))
			Net.announce("Божественный " .. Config.Creatures[divineEntry.id].name .. " появился на Острове 7!", "divine")
		end
	end
	workspace:SetAttribute("DivinePresent", divineEntry ~= nil and divineEntry.model ~= nil)
end

function BrainrotService.init()
	for islandIndex, island in ipairs(MapBuilder.islands) do
		for _, cf in ipairs(island.spawnPoints) do
			local entry = {
				island = islandIndex,
				rarity = island.def.rarity,
				cframe = cf,
				model = nil,
				nextSpawn = 0,
				divine = island.def.rarity >= 7,
			}
			table.insert(spawnEntries, entry)
			if entry.divine then
				divineEntry = entry
			end
		end
	end
	workspace:SetAttribute("DivineNextSpawn", now() + Config.DivineInterval)

	task.spawn(function()
		while true do
			tick()
			task.wait(1)
		end
	end)

	-- доставка и падение в воду
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc = acc + dt
		if acc < 0.2 then
			return
		end
		acc = 0
		for _, player in ipairs(Players:GetPlayers()) do
			local profile = DataService.get(player)
			local root = getRoot(player)
			if profile and root then
				if root.Position.Y < Config.FallDeathY then
					local had = profile.carrying ~= nil
					BrainrotService.drop(player)
					BrainrotService.teleportHome(player)
					Net.notify(player, had and "Упал в воду! Существо вернулось на остров." or "Упал в воду!", "error")
				elseif profile.carrying and PlotService.isInside(player, root.Position) then
					deliver(player, profile)
				end
			end
		end
	end)
end

return BrainrotService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000006"><Properties><string name="Name">CharacterVisuals</string><ProtectedString name="Source"><![CDATA[-- CharacterVisuals: крылья на спине и табличка с именем (золотая для доната).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local DataService = require(script.Parent.DataService)

local CharacterVisuals = {}

local function wingPart(parent, size, color, material)
	local p = Instance.new("Part")
	p.Size = size
	p.Color = color
	p.Material = material
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

function CharacterVisuals.applyWings(player)
	local char = player.Character
	local profile = DataService.get(player)
	if not char or not profile then
		return
	end
	local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
	if not torso then
		return
	end
	local old = char:FindFirstChild("Wings")
	if old then
		old:Destroy()
	end

	local index = profile.data.wing
	local def = Config.Wings[index] or Config.Wings[1]
	local s = 1 + (index - 1) * 0.12
	local material = index >= 4 and Enum.Material.Neon or Enum.Material.SmoothPlastic
	local vip = DataService.hasPass(player, "VIP")

	local model = Instance.new("Model")
	model.Name = "Wings"
	for _, side in ipairs({ -1, 1 }) do
		local inner = wingPart(model, Vector3.new(3.2, 1.8, 0.2) * s, def.color, material)
		inner.Name = side < 0 and "LeftWing" or "RightWing"
		inner.Transparency = index == 2 and 0.3 or 0
		local weld = Instance.new("Weld")
		weld.Name = side < 0 and "LeftWingWeld" or "RightWingWeld"
		weld.Part0 = torso
		weld.Part1 = inner
		weld.C0 = CFrame.new(side * 0.3, 0.4, 0.65) * CFrame.Angles(0, side * math.rad(-15), side * math.rad(20))
		weld.C1 = CFrame.new(-side * 1.6 * s, 0, 0)
		weld.Parent = inner

		local outer = wingPart(model, Vector3.new(2.2, 1.2, 0.2) * s, def.color:Lerp(Color3.new(1, 1, 1), 0.3), material)
		outer.CFrame = inner.CFrame * CFrame.new(side * 2.4 * s, -0.3 * s, 0) * CFrame.Angles(0, 0, side * math.rad(-15))
		local w2 = Instance.new("Weld")
		w2.Part0 = inner
		w2.Part1 = outer
		w2.C0 = CFrame.new(side * 2.4 * s, -0.3 * s, 0) * CFrame.Angles(0, 0, side * math.rad(-15))
		w2.Parent = outer

		if vip then
			local sparkles = Instance.new("Sparkles")
			sparkles.SparkleColor = Color3.fromRGB(255, 220, 80)
			sparkles.Parent = outer
		end
	end
	model.Parent = char
end

function CharacterVisuals.applyNameTag(player)
	local char = player.Character
	if not char then
		return
	end
	local head = char:FindFirstChild("Head")
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not head or not hum then
		return
	end
	local old = head:FindFirstChild("NameTag")
	if old then
		old:Destroy()
	end
	local gold = DataService.hasPass(player, "GoldName") or DataService.hasPass(player, "VIP")
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None

	local gui = Instance.new("BillboardGui")
	gui.Name = "NameTag"
	gui.Size = UDim2.fromOffset(200, 40)
	gui.StudsOffset = Vector3.new(0, 2.6, 0)
	gui.MaxDistance = 150
	gui.Adornee = head
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextStrokeTransparency = 0.3
	label.Text = (DataService.hasPass(player, "VIP") and "[VIP] " or "") .. player.DisplayName
	label.TextColor3 = gold and Color3.fromRGB(255, 205, 50) or Color3.new(1, 1, 1)
	label.Parent = gui
	gui.Parent = head
end

function CharacterVisuals.apply(player)
	CharacterVisuals.applyWings(player)
	CharacterVisuals.applyNameTag(player)
end

return CharacterVisuals
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000007"><Properties><string name="Name">CreatureFactory</string><ProtectedString name="Source"><![CDATA[-- CreatureFactory: собирает оригинальных существ из блоков.
