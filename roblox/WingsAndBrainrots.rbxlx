local function makePart(model, shape, size, cf, color, material, transparency)
	local p = Instance.new("Part")
	p.Shape = shape
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.Transparency = transparency or 0
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = true
	p.CanTouch = false
	p.Massless = true
	p.Parent = model
	return p
end

local function weld(a, b)
	local w = Instance.new("WeldConstraint")
	w.Part0 = a
	w.Part1 = b
	w.Parent = b
end

function CreatureFactory.scaleFor(id)
	local def = Config.Creatures[id]
	if def.rarity >= 7 then
		return 1.9
	end
	return 1 + (def.rarity - 1) * 0.15
end

-- Создаёт модель существа в позиции cframe (низ модели на уровне cframe).
function CreatureFactory.build(id, cframe)
	local spec = SPECS[id]
	local def = Config.Creatures[id]
	local rarity = Config.Rarities[def.rarity]
	local s = CreatureFactory.scaleFor(id)

	local model = Instance.new("Model")
	model.Name = def.name
	model:SetAttribute("CreatureId", id)

	local bodyDef = spec.body
	local bodySize = bodyDef[2] * s
	local origin = cframe * CFrame.new(0, bodySize.Y / 2 + 0.9 * s, 0)
	local body = makePart(model, bodyDef[1], bodySize, origin, bodyDef[3], bodyDef[4], bodyDef[5])
	body.Name = "Body"
	model.PrimaryPart = body

	local e = spec.eyes
	if e then
		local eyeColor = e[5] or WHITE
		for _, side in ipairs({ -1, 1 }) do
			local eyePos = Vector3.new(e[1] * side, e[2], e[3]) * s
			local eye = makePart(model, B, Vector3.new(e[4], e[4], e[4]) * s, origin * CFrame.new(eyePos), eyeColor, spec.glowEyes and NEON or nil)
			weld(body, eye)
			local pupil = makePart(
				model,
				B,
				Vector3.new(e[4], e[4], e[4]) * 0.5 * s,
				origin * CFrame.new(eyePos + Vector3.new(0, 0, -e[4] * 0.38 * s)),
				BLACK
			)
			weld(body, pupil)
		end
	end

	for _, pd in ipairs(spec.parts) do
		local rot = pd[6] or CFrame.new()
		local p = makePart(model, pd[1], pd[2] * s, origin * CFrame.new(pd[3] * s) * rot, pd[4], pd[5], pd[7])
		weld(body, p)
	end

	if spec.fire then
		local fire = Instance.new("Fire")
		fire.Size = 3 * s
		fire.Heat = 4
		fire.Parent = body
	end
	if spec.divine or def.rarity >= 6 then
		local light = Instance.new("PointLight")
		light.Color = rarity.color
		light.Range = 16
		light.Brightness = 2
		light.Parent = body
	end
	if def.rarity >= 5 then
		local sparkles = Instance.new("ParticleEmitter")
		sparkles.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		sparkles.Color = ColorSequence.new(rarity.color)
		sparkles.Rate = spec.divine and 25 or 8
		sparkles.Lifetime = NumberRange.new(1, 2)
		sparkles.Speed = NumberRange.new(1, 3)
		sparkles.SpreadAngle = Vector2.new(180, 180)
		sparkles.Size = NumberSequence.new(0.4)
		sparkles.LightEmission = 1
		sparkles.Parent = body
	end

	-- табличка: имя, редкость, доход
	local gui = Instance.new("BillboardGui")
	gui.Name = "Info"
	gui.Size = UDim2.fromOffset(170, 54)
	gui.StudsOffset = Vector3.new(0, bodySize.Y / 2 + 2.5, 0)
	gui.MaxDistance = 120
	gui.LightInfluence = 0
	gui.Adornee = body
	local function line(text, color, y, h)
		local l = Instance.new("TextLabel")
		l.BackgroundTransparency = 1
		l.Size = UDim2.new(1, 0, h, 0)
		l.Position = UDim2.new(0, 0, y, 0)
		l.Font = Enum.Font.FredokaOne
		l.TextScaled = true
		l.TextColor3 = color
		l.TextStrokeTransparency = 0.2
		l.Text = text
		l.Parent = gui
	end
	line(def.name, WHITE, 0, 0.4)
	line(rarity.name, rarity.color, 0.4, 0.3)
	line(Config.formatMoney(def.income) .. "/сек", rgb(120, 255, 120), 0.7, 0.3)
	gui.Parent = body

	return model
end

-- Переключает модель: закреплена на месте или свободна (для переноски).
function CreatureFactory.setAnchored(model, anchored)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = anchored
		end
	end
end

return CreatureFactory
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000008"><Properties><string name="Name">DataService</string><ProtectedString name="Source"><![CDATA[-- DataService: загрузка/сохранение в DataStore и состояние игроков на сервере.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local DataService = {}

local store = nil
local storeOk = pcall(function()
	store = DataStoreService:GetDataStore(Config.DataStoreName)
end)
if not storeOk then
	warn("[DataService] DataStore недоступен. В Studio включи Game Settings -> Security -> Enable Studio Access to API Services")
end

-- profiles[player] = { data = {...}, passes = {}, carrying = nil, plotIndex = n, loaded = bool }
local profiles = {}

local function defaultData()
	return {
		money = Config.StartMoney,
		speedLevel = 0,
		staminaLevel = 0,
		wing = 1,
		creatures = {}, -- список id существ по слотам
		receipts = {}, -- последние обработанные покупки
		totalEarned = 0,
	}
end

local function reconcile(data)
	local def = defaultData()
	for k, v in pairs(def) do
		if data[k] == nil then
			data[k] = v
		end
	end
	-- выкинуть неизвестных существ (если удалил их из конфига)
	local clean = {}
	for _, id in ipairs(data.creatures) do
		if Config.Creatures[id] then
			table.insert(clean, id)
		end
	end
	data.creatures = clean
	return data
end

local function key(player)
	return "player_" .. player.UserId
end

function DataService.load(player)
	local data = nil
	local ok = false
	if store then
		for attempt = 1, 3 do
			ok = pcall(function()
				data = store:GetAsync(key(player))
			end)
			if ok then
				break
			end
			task.wait(attempt)
		end
	end
	if not ok then
		warn("[DataService] Не удалось загрузить данные " .. player.Name .. ", прогресс НЕ будет сохранён")
	end
	local profile = {
		data = reconcile(type(data) == "table" and data or defaultData()),
		passes = {},
		testPasses = {},
		carrying = nil,
		plotIndex = nil,
		canSave = ok,
	}
	profiles[player] = profile
	return profile
end

function DataService.get(player)
	return profiles[player]
end

function DataService.save(player)
	local profile = profiles[player]
	if not profile or not profile.canSave or not store then
		return false
	end
	local ok, err = pcall(function()
		store:SetAsync(key(player), profile.data)
	end)
	if not ok then
		warn("[DataService] Ошибка сохранения " .. player.Name .. ": " .. tostring(err))
	end
	return ok
end

function DataService.release(player)
	DataService.save(player)
	profiles[player] = nil
end

function DataService.all()
	return profiles
end

-- Отправляет клиенту всё нужное через атрибуты игрока.
function DataService.sync(player)
	local profile = profiles[player]
	if not profile then
		return
	end
	local d = profile.data
	player:SetAttribute("Money", d.money)
	player:SetAttribute("SpeedLevel", d.speedLevel)
	player:SetAttribute("StaminaLevel", d.staminaLevel)
	player:SetAttribute("Wing", d.wing)
	player:SetAttribute("Creatures", HttpService:JSONEncode(d.creatures))
	player:SetAttribute("MaxSlots", DataService.maxSlots(player))
	player:SetAttribute("Income", DataService.income(player))
	player:SetAttribute("Carrying", profile.carrying and profile.carrying.id or "")
	for passKey in pairs(Config.GamePasses) do
		player:SetAttribute("Pass_" .. passKey, DataService.hasPass(player, passKey))
	end
	local stats = player:FindFirstChild("leaderstats")
	if stats then
		stats["$"].Value = d.money
		stats["Существа"].Value = #d.creatures
	end
end

function DataService.hasPass(player, passKey)
	local profile = profiles[player]
	if not profile then
		return false
	end
	return profile.passes[passKey] == true or profile.testPasses[passKey] == true
end

function DataService.maxSlots(player)
	local slots = Config.BaseSlots
	if DataService.hasPass(player, "ExtraSlots") then
		slots = slots + Config.ExtraSlotsPass
	end
	return slots
end

function DataService.incomeMultiplier(player)
	local mult = 1
	if DataService.hasPass(player, "DoubleMoney") then
		mult = mult * Config.DoubleMoneyMult
	end
	if DataService.hasPass(player, "VIP") then
		mult = mult * Config.VipMult
	end
	return mult
end

function DataService.baseIncome(player)
	local profile = profiles[player]
	if not profile then
		return 0
	end
	local total = 0
	for _, id in ipairs(profile.data.creatures) do
		total = total + Config.Creatures[id].income
	end
	return total
end

function DataService.income(player)
	return math.floor(DataService.baseIncome(player) * DataService.incomeMultiplier(player))
end

function DataService.addMoney(player, amount)
	local profile = profiles[player]
	if not profile then
		return
	end
	profile.data.money = profile.data.money + amount
	if amount > 0 then
		profile.data.totalEarned = profile.data.totalEarned + amount
	end
end

function DataService.init()
	-- автосохранение
	task.spawn(function()
		while true do
			task.wait(Config.AutosaveSeconds)
			for player in pairs(profiles) do
				task.spawn(DataService.save, player)
			end
		end
	end)

	game:BindToClose(function()
		if RunService:IsStudio() then
			-- в Studio сохраняем быстро и не ждём долго
			for player in pairs(profiles) do
				DataService.save(player)
			end
			return
		end
		local pending = 0
		for player in pairs(profiles) do
			pending = pending + 1
			task.spawn(function()
				DataService.save(player)
				pending = pending - 1
			end)
		end
		local start = os.clock()
		while pending > 0 and os.clock() - start < 25 do
			task.wait(0.2)
		end
	end)
end

return DataService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000009"><Properties><string name="Name">MapBuilder</string><ProtectedString name="Source"><![CDATA[-- MapBuilder: строит всю карту из блоков при старте сервера.
-- База в центре, 4 участка, станции прокачки, 7 островов, вода, освещение.

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local MapBuilder = {
	plots = {},
	stations = {},
	islands = {},
}

local PLATFORM_HALF = 110
local PLOT_HALF = 28
local PLOT_COLORS = {
	Color3.fromRGB(230, 80, 80),
	Color3.fromRGB(80, 140, 240),
	Color3.fromRGB(90, 200, 100),
	Color3.fromRGB(240, 200, 70),
}

local function part(props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for k, v in pairs(props) do
		if k ~= "Parent" then
			p[k] = v
		end
	end
	p.Parent = props.Parent
	return p
end

local function billboard(adornee, text, color, offsetY, sizeX, sizeY, alwaysOnTop)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(sizeX or 220, sizeY or 60)
	gui.StudsOffset = Vector3.new(0, offsetY or 4, 0)
	gui.AlwaysOnTop = alwaysOnTop == true
	gui.MaxDistance = alwaysOnTop and 6000 or 200
	gui.LightInfluence = 0
	gui.Adornee = adornee
	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = color or Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.2
	label.Text = text
	label.Parent = gui
	gui.Parent = adornee
	return gui
end

local function prompt(parentPart, actionText, objectText, name)
	local pp = Instance.new("ProximityPrompt")
	pp.Name = name or "Prompt"
	pp.ActionText = actionText
	pp.ObjectText = objectText or ""
	pp.HoldDuration = 0
	pp.MaxActivationDistance = 12
	pp.RequiresLineOfSight = false
	pp.KeyboardKeyCode = Enum.KeyCode.E
	pp.Parent = parentPart
	return pp
end

local function cylinder(parent, center, radius, height, color, material)
	return part({
		Parent = parent,
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(height, radius * 2, radius * 2),
		CFrame = CFrame.new(center) * CFrame.Angles(0, 0, math.rad(90)),
		Color = color,
		Material = material or Enum.Material.SmoothPlastic,
	})
end

local function tree(parent, pos, scale)
	scale = scale or 1
	part({
		Parent = parent,
		Size = Vector3.new(1.6, 9, 1.6) * scale,
		CFrame = CFrame.new(pos + Vector3.new(0, 4.5 * scale, 0)),
		Color = Color3.fromRGB(120, 80, 50),
		Material = Enum.Material.Wood,
	})
	part({
		Parent = parent,
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(8, 8, 8) * scale,
		CFrame = CFrame.new(pos + Vector3.new(0, 10 * scale, 0)),
		Color = Color3.fromRGB(70, 170, 70),
		Material = Enum.Material.Grass,
	})
end

local function buildLighting()
	Lighting.ClockTime = 14
	Lighting.Brightness = 2.5
	Lighting.Ambient = Color3.fromRGB(110, 110, 120)
	Lighting.OutdoorAmbient = Color3.fromRGB(150, 150, 160)
	Lighting.GlobalShadows = true
	Lighting.FogEnd = 100000
	local atmo = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	atmo.Density = 0.12
	atmo.Haze = 0.5
	atmo.Color = Color3.fromRGB(200, 225, 255)
	atmo.Decay = Color3.fromRGB(120, 170, 230)
	atmo.Parent = Lighting
	if not Lighting:FindFirstChildOfClass("Sky") then
		Instance.new("Sky").Parent = Lighting
	end
end

local function buildWater(map)
	local tile = 2000
	for ix = -2, 1 do
		for iz = -2, 1 do
			part({
				Parent = map,
				Name = "Water",
				Size = Vector3.new(tile, 4, tile),
				CFrame = CFrame.new(ix * tile + tile / 2, Config.WaterLevel - 2, iz * tile + tile / 2),
				Color = Color3.fromRGB(40, 125, 210),
				Material = Enum.Material.Glass,
				Transparency = 0.25,
				CanCollide = false,
				CanQuery = false,
				CanTouch = false,
				CastShadow = false,
			})
		end
	end
end

local function buildStation(map, name, title, color, pos)
	local folder = Instance.new("Model")
	folder.Name = name
	folder.Parent = map
	part({
		Parent = folder,
		Size = Vector3.new(16, 1, 16),
		CFrame = CFrame.new(pos + Vector3.new(0, 0.5, 0)),
		Color = color,
		Material = Enum.Material.SmoothPlastic,
	})
	local kiosk = part({
		Parent = folder,
		Name = "Kiosk",
		Size = Vector3.new(5, 5, 5),
		CFrame = CFrame.new(pos + Vector3.new(0, 3.5, 0)),
		Color = Color3.fromRGB(60, 60, 70),
	})
	part({
		Parent = folder,
		Size = Vector3.new(5.4, 1, 5.4),
		CFrame = CFrame.new(pos + Vector3.new(0, 6.5, 0)),
		Color = color,
		Material = Enum.Material.Neon,
	})
	billboard(kiosk, title, color, 7, 260, 60)
	local pp = prompt(kiosk, "Открыть", title, "OpenPrompt")
	MapBuilder.stations[name] = { model = folder, kiosk = kiosk, prompt = pp, position = pos }
end

local function buildPlot(map, index, center)
	local model = Instance.new("Model")
	model.Name = "Plot" .. index
	model.Parent = map
	local cf = CFrame.lookAt(center, Vector3.new(0, center.Y, 0))
	part({
		Parent = model,
		Name = "Floor",
		Size = Vector3.new(PLOT_HALF * 2, 1, PLOT_HALF * 2),
		CFrame = cf * CFrame.new(0, 0.5, 0),
		Color = PLOT_COLORS[index],
		Material = Enum.Material.SmoothPlastic,
		Transparency = 0.1,
	})
	-- бортики
	for _, side in ipairs({ -1, 1 }) do
		part({
			Parent = model,
			Size = Vector3.new(1, 2, PLOT_HALF * 2),
			CFrame = cf * CFrame.new(side * PLOT_HALF, 1.5, 0),
			Color = PLOT_COLORS[index]:Lerp(Color3.new(0, 0, 0), 0.3),
		})
	end
	part({
		Parent = model,
		Size = Vector3.new(PLOT_HALF * 2, 2, 1),
		CFrame = cf * CFrame.new(0, 1.5, PLOT_HALF),
		Color = PLOT_COLORS[index]:Lerp(Color3.new(0, 0, 0), 0.3),
	})

	local pads = {}
	local maxPads = Config.BaseSlots + Config.ExtraSlotsPass
	local i = 0
	for _, z in ipairs({ -4, 7, 18 }) do
		for _, x in ipairs({ -20, -10, 0, 10, 20 }) do
			i = i + 1
			if i <= maxPads then
				local pad = part({
					Parent = model,
					Name = "Pad" .. i,
					Size = Vector3.new(7, 0.4, 7),
					CFrame = cf * CFrame.new(x, 1.2, z),
					Color = Color3.fromRGB(245, 245, 245),
					Material = Enum.Material.SmoothPlastic,
				})
				pads[i] = pad
			end
		end
	end

	local post = part({
		Parent = model,
		Name = "SignPost",
		Size = Vector3.new(1, 10, 1),
		CFrame = cf * CFrame.new(0, 6, -PLOT_HALF + 2),
		Color = Color3.fromRGB(90, 70, 50),
		Material = Enum.Material.Wood,
	})
	local sign = billboard(post, "Свободная база", Color3.new(1, 1, 1), 6, 260, 50)

	MapBuilder.plots[index] = {
		model = model,
		cframe = cf * CFrame.new(0, 1, 0),
		spawnCFrame = cf * CFrame.new(0, 4, -PLOT_HALF + 6) * CFrame.Angles(0, math.pi, 0),
		pads = pads,
		sign = sign,
		color = PLOT_COLORS[index],
	}
end

local function buildStart(map)
	local y = Config.GroundY
	part({
		Parent = map,
		Name = "StartPlatform",
		Size = Vector3.new(PLATFORM_HALF * 2, 12, PLATFORM_HALF * 2),
		CFrame = CFrame.new(0, y - 6, 0),
		Color = Color3.fromRGB(110, 190, 90),
		Material = Enum.Material.Grass,
	})
	part({
		Parent = map,
		Size = Vector3.new(PLATFORM_HALF * 2 + 6, 14, PLATFORM_HALF * 2 + 6),
		CFrame = CFrame.new(0, y - 9, 0),
		Color = Color3.fromRGB(220, 200, 150),
		Material = Enum.Material.Sand,
	})
	-- дорожки к станциям
	part({
		Parent = map,
		Size = Vector3.new(90, 0.2, 10),
		CFrame = CFrame.new(0, y + 0.1, 0),
		Color = Color3.fromRGB(200, 190, 170),
		Material = Enum.Material.Cobblestone,
	})
	part({
		Parent = map,
		Size = Vector3.new(10, 0.2, 90),
		CFrame = CFrame.new(0, y + 0.1, 0),
		Color = Color3.fromRGB(200, 190, 170),
		Material = Enum.Material.Cobblestone,
	})

	local d = 70
	local corners = {
		Vector3.new(-d, y, -d),
		Vector3.new(d, y, -d),
		Vector3.new(d, y, d),
		Vector3.new(-d, y, d),
	}
	for index, c in ipairs(corners) do
		buildPlot(map, index, c)
	end

	buildStation(map, "Speed", "⚡ Скорость", Color3.fromRGB(255, 200, 40), Vector3.new(-34, y, 0))
	buildStation(map, "Stamina", "💪 Стамина", Color3.fromRGB(60, 220, 120), Vector3.new(34, y, 0))
	buildStation(map, "Wings", "🕊 Крылья", Color3.fromRGB(120, 180, 255), Vector3.new(0, y, -34))
	buildStation(map, "Market", "💰 Рынок (продажа)", Color3.fromRGB(240, 120, 60), Vector3.new(0, y, 34))
	buildStation(map, "Donate", "⭐ Донат-магазин", Color3.fromRGB(255, 90, 200), Vector3.new(0, y, 0))

	for _, pos in ipairs({
		Vector3.new(-100, y, -30),
		Vector3.new(-100, y, 30),
		Vector3.new(100, y, -30),
		Vector3.new(100, y, 30),
		Vector3.new(-30, y, -100),
		Vector3.new(30, y, -100),
		Vector3.new(-30, y, 100),
		Vector3.new(30, y, 100),
	}) do
		tree(map, pos, 1.2)
	end
end

local function buildIsland(map, index, def)
	local model = Instance.new("Model")
	model.Name = "Island" .. index
	model.Parent = map
	local a = math.rad(def.angle)
	local center = Vector3.new(math.cos(a) * def.distance, Config.GroundY, math.sin(a) * def.distance)
	local rarity = Config.Rarities[def.rarity]

	cylinder(model, center - Vector3.new(0, 1, 0), def.radius, 2, Color3.fromRGB(100, 185, 85), Enum.Material.Grass)
	cylinder(model, center - Vector3.new(0, 8, 0), def.radius - 2, 12, Color3.fromRGB(130, 115, 100), Enum.Material.Slate)
	cylinder(model, center - Vector3.new(0, 15, 0), def.radius * 0.6, 6, Color3.fromRGB(110, 95, 85), Enum.Material.Slate)
	-- светящийся край цвета редкости
	cylinder(model, center - Vector3.new(0, 0.9, 0), def.radius + 0.6, 1.6, rarity.color, Enum.Material.Neon)

	for t = 1, 3 do
		local ta = a + t * 2.1
		tree(model, center + Vector3.new(math.cos(ta), 0, math.sin(ta)) * (def.radius * 0.78), 1)
	end

	local signPart = part({
		Parent = model,
		Name = "SignAnchor",
		Size = Vector3.new(1, 1, 1),
		CFrame = CFrame.new(center + Vector3.new(0, 30, 0)),
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
	})
	billboard(signPart, "Остров " .. index .. "\n" .. rarity.name, rarity.color, 0, 180, 60, true)

	local spawnPoints = {}
	for k = 1, def.spawns do
		local pos
		if def.spawns == 1 then
			pos = center
		else
			local sa = k / def.spawns * math.pi * 2 + a
			pos = center + Vector3.new(math.cos(sa), 0, math.sin(sa)) * (def.radius * 0.45)
		end
		spawnPoints[k] = CFrame.lookAt(pos, Vector3.new(0, pos.Y, 0))
	end

	MapBuilder.islands[index] = {
		model = model,
		center = center,
		def = def,
		spawnPoints = spawnPoints,
	}
end

function MapBuilder.build()
	buildLighting()
	local map = Instance.new("Folder")
	map.Name = "Map"
	map.Parent = workspace
	buildWater(map)
	buildStart(map)
	for index, def in ipairs(Config.Islands) do
		buildIsland(map, index, def)
	end
	local creatures = Instance.new("Folder")
	creatures.Name = "Creatures"
	creatures.Parent = workspace
	MapBuilder.creatureFolder = creatures
	return map
end

return MapBuilder
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000010"><Properties><string name="Name">MonetizationService</string><ProtectedString name="Source"><![CDATA[-- MonetizationService: Game Pass и Developer Product (покупки за Robux).
-- Пока в Config id = 0, в Studio покупка выдаётся бесплатно для теста.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local DataService = require(script.Parent.DataService)
local Net = require(script.Parent.Net)

local MonetizationService = {}

MonetizationService.onPassesChanged = nil -- функция(player), задаёт Main

local function passKeyById(id)
	for key, def in pairs(Config.GamePasses) do
		if def.id ~= 0 and def.id == id then
			return key
		end
	end
	return nil
end

local function productKeyById(id)
	for key, def in pairs(Config.Products) do
		if def.id ~= 0 and def.id == id then
			return key
		end
	end
	return nil
end

local function passesChanged(player)
	DataService.sync(player)
	if MonetizationService.onPassesChanged then
		MonetizationService.onPassesChanged(player)
	end
end

function MonetizationService.loadPasses(player)
	local profile = DataService.get(player)
	for key, def in pairs(Config.GamePasses) do
		if def.id ~= 0 then
			local ok, owns = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, def.id)
			end)
			if ok and owns then
				profile.passes[key] = true
			end
		end
	end
end

local function grantProduct(player, key)
	local def = Config.Products[key]
	if def.luck then
		local t = workspace:GetServerTimeNow()
		local untilT = math.max(workspace:GetAttribute("LuckUntil") or 0, t) + Config.LuckBoostSeconds
		workspace:SetAttribute("LuckUntil", untilT)
		Net.announce(player.DisplayName .. " включил Удачу сервера на 15 минут! 🍀", "divine")
	else
		local amount = Config.productAmount(key, DataService.income(player))
		DataService.addMoney(player, amount)
		Net.notify(player, "Получено " .. Config.formatMoney(amount) .. "! Спасибо за поддержку!", "success")
	end
	DataService.sync(player)
end

function MonetizationService.buyPass(player, key)
	local def = Config.GamePasses[key]
	if not def then
		return { ok = false, msg = "Нет такого товара" }
	end
	if DataService.hasPass(player, key) then
		return { ok = false, msg = "Уже куплено" }
	end
	if def.id == 0 then
		if RunService:IsStudio() then
			DataService.get(player).testPasses[key] = true
			passesChanged(player)
			return { ok = true, msg = "[ТЕСТ] Выдан " .. def.title .. " (только в Studio)" }
		end
		return { ok = false, msg = "Этот Game Pass ещё не настроен" }
	end
	MarketplaceService:PromptGamePassPurchase(player, def.id)
	return { ok = true, msg = "" }
end

function MonetizationService.buyProduct(player, key)
	local def = Config.Products[key]
	if not def then
		return { ok = false, msg = "Нет такого товара" }
	end
	if def.id == 0 then
		if RunService:IsStudio() then
			grantProduct(player, key)
			return { ok = true, msg = "[ТЕСТ] " .. def.title .. " выдан (только в Studio)" }
		end
		return { ok = false, msg = "Этот товар ещё не настроен" }
	end
	MarketplaceService:PromptProductPurchase(player, def.id)
	return { ok = true, msg = "" }
end

function MonetizationService.init()
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if not purchased then
			return
		end
		local key = passKeyById(passId)
		local profile = DataService.get(player)
		if key and profile then
			profile.passes[key] = true
			passesChanged(player)
			Net.notify(player, "Куплено: " .. Config.GamePasses[key].title .. "!", "success")
		end
	end)

	MarketplaceService.ProcessReceipt = function(receipt)
		local player = Players:GetPlayerByUserId(receipt.PlayerId)
		local profile = player and DataService.get(player)
		if not profile then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		local receipts = profile.data.receipts
		for _, rid in ipairs(receipts) do
			if rid == receipt.PurchaseId then
				return Enum.ProductPurchaseDecision.PurchaseGranted
			end
		end
		local key = productKeyById(receipt.ProductId)
		if not key then
			warn("[Monetization] Неизвестный ProductId " .. tostring(receipt.ProductId))
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		grantProduct(player, key)
		table.insert(receipts, receipt.PurchaseId)
		while #receipts > 50 do
			table.remove(receipts, 1)
		end
		if profile.canSave and not DataService.save(player) then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
end

return MonetizationService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000011"><Properties><string name="Name">Net</string><ProtectedString name="Source"><![CDATA[-- Net: создаёт RemoteEvent/RemoteFunction в ReplicatedStorage.Remotes.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = {}

local folder = ReplicatedStorage:FindFirstChild("Remotes")
if not folder then
	folder = Instance.new("Folder")
	folder.Name = "Remotes"
	folder.Parent = ReplicatedStorage
end

local function remote(className, name)
	local r = folder:FindFirstChild(name)
	if not r then
		r = Instance.new(className)
		r.Name = name
		r.Parent = folder
	end
	return r
end

Net.Notify = remote("RemoteEvent", "Notify") -- сервер -> клиент: всплывающее сообщение
Net.OpenPanel = remote("RemoteEvent", "OpenPanel") -- сервер -> клиент: открыть окно станции
Net.Request = remote("RemoteFunction", "Request") -- клиент -> сервер: покупки и продажа

function Net.notify(player, text, kind)
	Net.Notify:FireClient(player, text, kind or "info")
end

function Net.announce(text, kind)
	Net.Notify:FireAllClients(text, kind or "announce")
end

return Net
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000012"><Properties><string name="Name">PlotService</string><ProtectedString name="Source"><![CDATA[-- PlotService: 4 базы, выдача базы игроку, отображение существ на слотах.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local MapBuilder = require(script.Parent.MapBuilder)
local CreatureFactory = require(script.Parent.CreatureFactory)
local DataService = require(script.Parent.DataService)

local PlotService = {}

local owners = {} -- owners[plotIndex] = player
local displayed = {} -- displayed[plotIndex] = { models }

function PlotService.assign(player)
	for index = 1, #MapBuilder.plots do
		if not owners[index] then
			owners[index] = player
			local profile = DataService.get(player)
			profile.plotIndex = index
			local plot = MapBuilder.plots[index]
			plot.sign.Label.Text = "База: " .. player.DisplayName
			player:SetAttribute("PlotIndex", index)
			return index
		end
	end
	return nil
end

function PlotService.release(player)
	for index, owner in pairs(owners) do
		if owner == player then
			owners[index] = nil
			PlotService.clear(index)
			local plot = MapBuilder.plots[index]
			plot.sign.Label.Text = "Свободная база"
			for _, pad in pairs(plot.pads) do
				pad.Color = Color3.fromRGB(245, 245, 245)
				pad.Transparency = 0
			end
		end
	end
end

function PlotService.getPlot(player)
	local profile = DataService.get(player)
	if profile and profile.plotIndex then
		return MapBuilder.plots[profile.plotIndex]
	end
	return nil
end

function PlotService.clear(index)
	if displayed[index] then
		for _, m in ipairs(displayed[index]) do
			m:Destroy()
		end
	end
	displayed[index] = {}
end

-- Перерисовывает существ игрока на его базе.
function PlotService.refresh(player)
	local profile = DataService.get(player)
	if not profile or not profile.plotIndex then
		return
	end
	local index = profile.plotIndex
	local plot = MapBuilder.plots[index]
	PlotService.clear(index)
	local maxSlots = DataService.maxSlots(player)
	for slot, pad in pairs(plot.pads) do
		if slot <= maxSlots then
			pad.Transparency = 0
			pad.Color = Color3.fromRGB(245, 245, 245)
		else
			pad.Transparency = 0.6
			pad.Color = Color3.fromRGB(120, 120, 120)
		end
	end
	for slot, id in ipairs(profile.data.creatures) do
		local pad = plot.pads[slot]
		if pad then
			local model = CreatureFactory.build(id, pad.CFrame * CFrame.new(0, 0.2, 0))
			model.Parent = plot.model
			table.insert(displayed[index], model)
			local rarity = Config.Rarities[Config.Creatures[id].rarity]
			pad.Color = rarity.color
		end
	end
end

-- Находится ли точка внутри базы игрока.
function PlotService.isInside(player, position)
	local plot = PlotService.getPlot(player)
	if not plot then
		return false
	end
	local rel = plot.cframe:PointToObjectSpace(position)
	return math.abs(rel.X) <= 29 and math.abs(rel.Z) <= 29 and rel.Y < 40 and rel.Y > -6
end

return PlotService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000013"><Properties><string name="Name">UpgradeService</string><ProtectedString name="Source"><![CDATA[-- UpgradeService: покупки за $ проверяются ТОЛЬКО на сервере.
-- Скорость, стамина, крылья, продажа существ.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local MapBuilder = require(script.Parent.MapBuilder)
local DataService = require(script.Parent.DataService)
local PlotService = require(script.Parent.PlotService)
local CharacterVisuals = require(script.Parent.CharacterVisuals)

local UpgradeService = {}

local STATION_RANGE = 25

local function nearStation(player, stationName)
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local station = MapBuilder.stations[stationName]
	if not root or not station then
		return false
	end
	return (root.Position - station.position).Magnitude <= STATION_RANGE
end

function UpgradeService.applyWalkSpeed(player)
	local profile = DataService.get(player)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if profile and hum then
		hum.WalkSpeed = Config.walkSpeed(profile.data.speedLevel)
	end
end

function UpgradeService.buyUpgrade(player, kind)
	local def = Config.Upgrades[kind]
	if not def then
		return { ok = false, msg = "Нет такой прокачки" }
	end
	if not nearStation(player, kind) then
		return { ok = false, msg = "Подойди к станции «" .. def.title .. "»" }
	end
	local profile = DataService.get(player)
	local field = kind == "Speed" and "speedLevel" or "staminaLevel"
	local level = profile.data[field]
	if level >= def.maxLevel then
		return { ok = false, msg = "Уже максимальный уровень!" }
	end
	local cost = Config.upgradeCost(kind, level)
	if profile.data.money < cost then
		return { ok = false, msg = "Не хватает " .. Config.formatMoney(cost - profile.data.money) }
	end
	profile.data.money = profile.data.money - cost
	profile.data[field] = level + 1
	if kind == "Speed" then
		UpgradeService.applyWalkSpeed(player)
	end
	DataService.sync(player)
	return { ok = true, msg = def.title .. " → уровень " .. (level + 1) }
end

function UpgradeService.buyWing(player, index)
	if type(index) ~= "number" then
		return { ok = false, msg = "Ошибка" }
	end
	if not nearStation(player, "Wings") then
		return { ok = false, msg = "Подойди к магазину крыльев" }
	end
	local profile = DataService.get(player)
	local current = profile.data.wing
	local def = Config.Wings[index]
	if not def then
		return { ok = false, msg = "Нет таких крыльев" }
	end
	if index <= current then
		return { ok = false, msg = "Уже куплено" }
	end
	if index ~= current + 1 then
		return { ok = false, msg = "Сначала купи " .. Config.Wings[current + 1].name }
	end
	if profile.data.money < def.cost then
		return { ok = false, msg = "Не хватает " .. Config.formatMoney(def.cost - profile.data.money) }
	end
	profile.data.money = profile.data.money - def.cost
	profile.data.wing = index
	CharacterVisuals.applyWings(player)
	DataService.sync(player)
	return { ok = true, msg = "Новые крылья: " .. def.name .. " (x" .. def.mult .. " стамина)" }
end

function UpgradeService.sell(player, slot)
	if not nearStation(player, "Market") then
		return { ok = false, msg = "Продавать можно только на рынке" }
	end
	local profile = DataService.get(player)
	local creatures = profile.data.creatures
	if type(slot) ~= "number" or not creatures[slot] then
		return { ok = false, msg = "Нет такого существа" }
	end
	local id = table.remove(creatures, slot)
	local price = Config.sellPrice(id)
	DataService.addMoney(player, price)
	PlotService.refresh(player)
	DataService.sync(player)
	return { ok = true, msg = "Продано " .. Config.Creatures[id].name .. " за " .. Config.formatMoney(price) }
end

function UpgradeService.sellAll(player)
	if not nearStation(player, "Market") then
		return { ok = false, msg = "Продавать можно только на рынке" }
	end
	local profile = DataService.get(player)
	local count = #profile.data.creatures
	if count == 0 then
		return { ok = false, msg = "Нечего продавать" }
	end
	local total = 0
	for _, id in ipairs(profile.data.creatures) do
		total = total + Config.sellPrice(id)
	end
	profile.data.creatures = {}
	DataService.addMoney(player, total)
	PlotService.refresh(player)
	DataService.sync(player)
	return { ok = true, msg = "Продано " .. count .. " существ за " .. Config.formatMoney(total) }
end

return UpgradeService
]]></ProtectedString></Properties></Item></Item></Item><Item class="StarterPlayer" referent="RBX00000019"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX00000018"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX00000016"><Properties><string name="Name">FlightController</string><ProtectedString name="Source"><![CDATA[-- FlightController: полёт на клиенте.
-- Прыгни и держи ПРОБЕЛ (или кнопку «Лететь») — взмах вверх, тратится стамина.
-- Отпустил — плавно снижаешься (стамина тоже тратится). Стамина 0 — падаешь.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ContextActionService = game:GetService("ContextActionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local player = Players.LocalPlayer

local character, humanoid, root
local flying = false
local holding = false
local exhausted = false
local stamina = 0
local flightTime = 0
local airTime = 0
local velocityConstraint, attachment
local wingWelds = {}

local function stats()
	local speedLevel = player:GetAttribute("SpeedLevel") or 0
	local staminaLevel = player:GetAttribute("StaminaLevel") or 0
	local wing = player:GetAttribute("Wing") or 1
	local staminaPass = player:GetAttribute("Pass_StaminaBoost") == true
	local carrying = (player:GetAttribute("Carrying") or "") ~= ""
	local maxStamina = Config.maxStamina(staminaLevel, wing, staminaPass)
	local speed = Config.flySpeed(speedLevel)
	if carrying then
		speed = speed * Config.CarrySpeedMult
	end
	return maxStamina, speed, Config.liftSpeed(wing), Config.maxFlightY(wing)
end

local function findWingWelds()
	wingWelds = {}
	local wings = character and character:FindFirstChild("Wings")
	if not wings then
		return
	end
	for _, d in ipairs(wings:GetDescendants()) do
		if d:IsA("Weld") and (d.Name == "LeftWingWeld" or d.Name == "RightWingWeld") then
			table.insert(wingWelds, { weld = d, base = d.C0, side = d.Name == "LeftWingWeld" and -1 or 1 })
		end
	end
end

local function stopFlight()
	flying = false
	if velocityConstraint then
		velocityConstraint:Destroy()
		velocityConstraint = nil
	end
	if attachment then
		attachment:Destroy()
		attachment = nil
	end
	for _, w in ipairs(wingWelds) do
		if w.weld.Parent then
			w.weld.C0 = w.base
		end
	end
end

local function startFlight()
	if flying or not root then
		return
	end
	flying = true
	flightTime = 0
	attachment = Instance.new("Attachment")
	attachment.Name = "FlyAttachment"
	attachment.Parent = root
	velocityConstraint = Instance.new("LinearVelocity")
	velocityConstraint.Name = "FlyVelocity"
	velocityConstraint.Attachment0 = attachment
	velocityConstraint.RelativeTo = Enum.ActuatorRelativeTo.World
	velocityConstraint.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
	velocityConstraint.MaxForce = math.huge
	velocityConstraint.VectorVelocity = root.AssemblyLinearVelocity
	velocityConstraint.Parent = root
	findWingWelds()
end

local function onCharacter(char)
	stopFlight()
	character = char
	humanoid = char:WaitForChild("Humanoid")
	root = char:WaitForChild("HumanoidRootPart")
	exhausted = false
	stamina = stats()
	char.ChildAdded:Connect(function(child)
		if child.Name == "Wings" then
			task.defer(findWingWelds)
		end
	end)
	humanoid.Died:Connect(stopFlight)
end

player.CharacterAdded:Connect(onCharacter)
if player.Character then
	task.spawn(onCharacter, player.Character)
end

ContextActionService:BindAction("Fly", function(_, state)
	if state == Enum.UserInputState.Begin then
		holding = true
	elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
		holding = false
	end
	return Enum.ContextActionResult.Pass -- обычный прыжок тоже работает
end, true, Enum.KeyCode.Space, Enum.KeyCode.ButtonA)
ContextActionService:SetTitle("Fly", "Лететь")
ContextActionService:SetPosition("Fly", UDim2.new(1, -170, 1, -150))

RunService.RenderStepped:Connect(function(dt)
	if not humanoid or not root or humanoid.Health <= 0 then
		return
	end
	local maxStamina, speed, lift, maxY = stats()
	local airborne = humanoid.FloorMaterial == Enum.Material.Air
	if airborne then
		airTime = airTime + dt
	else
		airTime = 0
	end

	if flying then
		flightTime = flightTime + dt
		stamina = stamina - dt
		if stamina <= 0 then
			stamina = 0
			exhausted = true
			stopFlight()
		elseif not airborne and flightTime > 0.4 then
			stopFlight()
		else
			local vy = holding and lift or -Config.SinkSpeed
			if vy > 0 and root.Position.Y >= maxY then
				vy = 0
			end
			local move = humanoid.MoveDirection
			velocityConstraint.VectorVelocity = Vector3.new(move.X * speed, vy, move.Z * speed)
			-- взмахи крыльев
			local amp = holding and 0.7 or 0.25
			local freq = holding and 14 or 5
			for _, w in ipairs(wingWelds) do
				if w.weld.Parent then
					w.weld.C0 = w.base * CFrame.Angles(0, 0, w.side * math.sin(flightTime * freq) * amp)
				end
			end
		end
	else
		if not airborne then
			exhausted = false
			stamina = math.min(maxStamina, stamina + maxStamina / Config.StaminaRegenTime * dt)
		elseif holding and not exhausted and stamina > 0.2 and airTime > 0.15 then
			startFlight()
		end
	end

	stamina = math.min(stamina, maxStamina)
	-- для UI (локальные атрибуты не уходят на сервер)
	player:SetAttribute("StaminaFrac", maxStamina > 0 and stamina / maxStamina or 0)
	player:SetAttribute("StaminaValue", stamina)
	player:SetAttribute("StaminaMax", maxStamina)
	player:SetAttribute("Flying", flying)
end)
]]></ProtectedString><bool name="Disabled">false</bool></Properties></Item><Item class="LocalScript" referent="RBX00000017"><Properties><string name="Name">UIController</string><ProtectedString name="Source"><![CDATA[-- UIController: деньги, стамина, таймер божественного, окна станций и донат-магазин.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local Request = Remotes:WaitForChild("Request")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local FONT = Enum.Font.FredokaOne
local C = {
	bg = Color3.fromRGB(30, 32, 48),
	panel = Color3.fromRGB(44, 47, 70),
	row = Color3.fromRGB(58, 62, 90),
	green = Color3.fromRGB(70, 200, 100),
	grey = Color3.fromRGB(110, 110, 125),
	gold = Color3.fromRGB(255, 205, 50),
	pink = Color3.fromRGB(255, 90, 200),
	red = Color3.fromRGB(230, 70, 70),
	white = Color3.new(1, 1, 1),
}

---------------------------------------------------------------------
-- помощники
---------------------------------------------------------------------
local function new(className, props, children)
	local inst = Instance.new(className)
	for k, v in pairs(props) do
		if k ~= "Parent" then
			inst[k] = v
		end
	end
	for _, child in ipairs(children or {}) do
		child.Parent = inst
	end
	inst.Parent = props.Parent
	return inst
end

local function corner(r)
	return new("UICorner", { CornerRadius = UDim.new(0, r or 10) })
end

local function stroke(color, t)
	return new("UIStroke", { Color = color or Color3.new(0, 0, 0), Thickness = t or 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end

local function label(props)
	props.BackgroundTransparency = props.BackgroundTransparency or 1
	props.Font = props.Font or FONT
	props.TextColor3 = props.TextColor3 or C.white
	props.TextScaled = props.TextScaled ~= false
	return new("TextLabel", props, { new("UIStroke", { Thickness = 1.5, Transparency = 0.3 }) })
end

local function button(props, onClick)
	props.Font = FONT
	props.TextScaled = true
	props.TextColor3 = props.TextColor3 or C.white
	props.AutoButtonColor = true
	local b = new("TextButton", props, { corner(8), new("UIPadding", {
		PaddingLeft = UDim.new(0, 6),
		PaddingRight = UDim.new(0, 6),
		PaddingTop = UDim.new(0, 4),
		PaddingBottom = UDim.new(0, 4),
	}) })
	b.MouseButton1Click:Connect(onClick)
	return b
end

---------------------------------------------------------------------
-- экран
---------------------------------------------------------------------
local gui = new("ScreenGui", {
	Name = "GameUI",
	ResetOnSpawn = false,
	IgnoreGuiInset = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	Parent = playerGui,
})

-- деньги сверху
local moneyFrame = new("Frame", {
	Parent = gui,
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 8),
	Size = UDim2.fromOffset(260, 64),
	BackgroundColor3 = C.bg,
	BackgroundTransparency = 0.15,
}, { corner(14), stroke(C.gold, 2) })
local moneyLabel = label({ Parent = moneyFrame, Size = UDim2.new(1, -16, 0.62, 0), Position = UDim2.fromOffset(8, 2), TextColor3 = C.gold, Text = "$0" })
local incomeLabel = label({ Parent = moneyFrame, Size = UDim2.new(1, -16, 0.36, 0), Position = UDim2.new(0, 8, 0.62, -2), TextColor3 = Color3.fromRGB(140, 255, 140), Text = "+$0/сек" })

-- стамина снизу
local staminaFrame = new("Frame", {
	Parent = gui,
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -18),
	Size = UDim2.fromOffset(320, 26),
	BackgroundColor3 = C.bg,
	BackgroundTransparency = 0.1,
}, { corner(13), stroke(Color3.new(0, 0, 0), 2) })
local staminaFill = new("Frame", {
	Parent = staminaFrame,
	Size = UDim2.fromScale(1, 1),
	BackgroundColor3 = Color3.fromRGB(90, 200, 255),
}, { corner(13) })
local staminaText = label({ Parent = staminaFrame, Size = UDim2.fromScale(1, 1), Text = "Стамина", ZIndex = 2 })

-- что несу
local carryLabel = label({
	Parent = gui,
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -50),
	Size = UDim2.fromOffset(420, 30),
	Text = "",
	TextColor3 = C.gold,
})

-- таймер божественного справа сверху
local divineLabel = label({
	Parent = gui,
	AnchorPoint = Vector2.new(1, 0),
	Position = UDim2.new(1, -12, 0, 8),
	Size = UDim2.fromOffset(260, 28),
	TextColor3 = Color3.fromRGB(255, 240, 120),
	TextXAlignment = Enum.TextXAlignment.Right,
	Text = "",
})
local luckLabel = label({
	Parent = gui,
	AnchorPoint = Vector2.new(1, 0),
	Position = UDim2.new(1, -12, 0, 38),
	Size = UDim2.fromOffset(260, 24),
	TextColor3 = Color3.fromRGB(120, 255, 120),
	TextXAlignment = Enum.TextXAlignment.Right,
	Text = "",
})

-- уведомления
local toastHolder = new("Frame", {
	Parent = gui,
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 80),
	Size = UDim2.fromOffset(460, 200),
	BackgroundTransparency = 1,
}, { new("UIListLayout", { Padding = UDim.new(0, 6), HorizontalAlignment = Enum.HorizontalAlignment.Center }) })

local TOAST_COLORS = {
	info = Color3.fromRGB(60, 120, 220),
	success = Color3.fromRGB(50, 170, 80),
	error = Color3.fromRGB(200, 60, 60),
	announce = Color3.fromRGB(150, 90, 220),
	divine = Color3.fromRGB(220, 160, 20),
}

local function toast(text, kind)
	if not text or text == "" then
		return
	end
	local f = new("Frame", {
		Parent = toastHolder,
		Size = UDim2.fromOffset(440, 36),
		BackgroundColor3 = TOAST_COLORS[kind] or TOAST_COLORS.info,
		BackgroundTransparency = 0.1,
	}, { corner(10) })
	label({ Parent = f, Size = UDim2.new(1, -16, 1, -6), Position = UDim2.fromOffset(8, 3), Text = text })
	task.delay(kind == "divine" and 6 or 3, function()
		TweenService:Create(f, TweenInfo.new(0.3), { BackgroundTransparency = 1 }):Play()
		task.wait(0.3)
		f:Destroy()
	end)
end

Remotes:WaitForChild("Notify").OnClientEvent:Connect(toast)

---------------------------------------------------------------------
-- окна
---------------------------------------------------------------------
local panel = new("Frame", {
	Parent = gui,
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.52),
	Size = UDim2.new(0.92, 0, 0.7, 0),
	BackgroundColor3 = C.panel,
	Visible = false,
}, {
	corner(16),
	stroke(Color3.new(0, 0, 0), 3),
	new("UISizeConstraint", { MaxSize = Vector2.new(460, 440) }),
})
local panelTitle = label({ Parent = panel, Size = UDim2.new(1, -70, 0, 40), Position = UDim2.fromOffset(14, 8), Text = "", TextXAlignment = Enum.TextXAlignment.Left })
button({
	Parent = panel,
	AnchorPoint = Vector2.new(1, 0),
	Position = UDim2.new(1, -10, 0, 10),
	Size = UDim2.fromOffset(36, 36),
	BackgroundColor3 = C.red,
	Text = "X",
}, function()
	panel.Visible = false
end)
local list = new("ScrollingFrame", {
	Parent = panel,
	Position = UDim2.fromOffset(10, 56),
	Size = UDim2.new(1, -20, 1, -66),
	BackgroundTransparency = 1,
	BorderSizePixel = 0,
	ScrollBarThickness = 6,
	CanvasSize = UDim2.new(),
	AutomaticCanvasSize = Enum.AutomaticSize.Y,
}, { new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }) })

local currentPanel = nil

local function clearList()
	for _, child in ipairs(list:GetChildren()) do
		if not child:IsA("UIListLayout") then
			child:Destroy()
		end
	end
end

local order = 0
local function row(height, color)
	order = order + 1
	return new("Frame", {
		Parent = list,
		Size = UDim2.new(1, -8, 0, height or 64),
		BackgroundColor3 = color or C.row,
		LayoutOrder = order,
	}, { corner(10) })
end

local function header(text)
	local r = row(30, C.panel)
	label({ Parent = r, Size = UDim2.fromScale(1, 1), Text = text, TextColor3 = C.gold })
end

local function sendRequest(action, arg)
	local ok, result = pcall(function()
		return Request:InvokeServer(action, arg)
	end)
	if ok and type(result) == "table" then
		toast(result.msg, result.ok and "success" or "error")
	end
end

-- строка «текст слева + кнопка справа»
local function itemRow(title, subtitle, buttonText, buttonColor, onClick, titleColor)
	local r = row(64)
	label({ Parent = r, Position = UDim2.fromOffset(10, 4), Size = UDim2.new(0.62, -10, 0, 30), Text = title, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = titleColor or C.white })
	label({ Parent = r, Position = UDim2.fromOffset(10, 34), Size = UDim2.new(0.62, -10, 0, 24), Text = subtitle, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Color3.fromRGB(200, 200, 215) })
	if buttonText then
		button({
			Parent = r,
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -8, 0.5, 0),
			Size = UDim2.new(0.36, -8, 0, 44),
			BackgroundColor3 = buttonColor or C.green,
			Text = buttonText,
		}, onClick or function() end)
	end
	return r
end

local builders = {}

local function upgradePanel(kind)
	local def = Config.Upgrades[kind]
	local level = player:GetAttribute(kind == "Speed" and "SpeedLevel" or "StaminaLevel") or 0
	local wing = player:GetAttribute("Wing") or 1
	local pass = player:GetAttribute("Pass_StaminaBoost") == true
	local function describe(l)
		if kind == "Speed" then
			return "Бег " .. math.floor(Config.walkSpeed(l)) .. " · Полёт " .. math.floor(Config.flySpeed(l))
		end
		return string.format("%.1f сек полёта", Config.maxStamina(l, wing, pass))
	end
	header(def.title .. ": уровень " .. level .. " / " .. def.maxLevel)
	itemRow("Сейчас", describe(level), nil)
	if level >= def.maxLevel then
		itemRow("Максимум!", "Сильнее уже некуда", nil)
	else
		local cost = Config.upgradeCost(kind, level)
		local money = player:GetAttribute("Money") or 0
		itemRow("Уровень " .. (level + 1), describe(level + 1), Config.formatMoney(cost), money >= cost and C.green or C.grey, function()
			sendRequest("BuyUpgrade", kind)
		end)
	end
end

builders.Speed = function()
	panelTitle.Text = "⚡ Скорость"
	upgradePanel("Speed")
end

builders.Stamina = function()
	panelTitle.Text = "💪 Стамина"
	upgradePanel("Stamina")
end

builders.Wings = function()
	panelTitle.Text = "🕊 Крылья"
	local current = player:GetAttribute("Wing") or 1
	local money = player:GetAttribute("Money") or 0
	for i, w in ipairs(Config.Wings) do
		local text, color
		if i == current then
			text, color = "Надеты", C.grey
		elseif i < current then
			text, color = "Куплены", C.grey
		elseif i == current + 1 then
			text, color = Config.formatMoney(w.cost), money >= w.cost and C.green or C.grey
		else
			text, color = "🔒 " .. Config.formatMoney(w.cost), C.grey
		end
		itemRow(w.name, "x" .. w.mult .. " стамина и сила полёта", text, color, function()
			sendRequest("BuyWing", i)
		end, w.color)
	end
end

builders.Market = function()
	panelTitle.Text = "💰 Рынок"
	local ok, creatures = pcall(function()
		return HttpService:JSONDecode(player:GetAttribute("Creatures") or "[]")
	end)
	if not ok then
		creatures = {}
	end
	if #creatures == 0 then
		header("На базе нет существ")
		return
	end
	local total = 0
	for _, id in ipairs(creatures) do
		total = total + Config.sellPrice(id)
	end
	local r = row(50, C.panel)
	button({ Parent = r, Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.red, Text = "Продать всех за " .. Config.formatMoney(total) }, function()
		sendRequest("SellAll")
	end)
	for slot, id in ipairs(creatures) do
		local def = Config.Creatures[id]
		if def then
			local rarity = Config.Rarities[def.rarity]
			itemRow(def.name, rarity.name .. " · " .. Config.formatMoney(def.income) .. "/сек", "Продать " .. Config.formatMoney(Config.sellPrice(id)), C.gold, function()
				sendRequest("Sell", slot)
			end, rarity.color)
		end
	end
end

builders.Donate = function()
	panelTitle.Text = "⭐ Донат-магазин"
	local income = player:GetAttribute("Income") or 0
	header("Деньги")
	for _, key in ipairs(Config.ProductOrder) do
		local def = Config.Products[key]
		if not def.luck then
			itemRow(def.title, "+" .. Config.formatMoney(Config.productAmount(key, income)), "R$ " .. def.price, C.green, function()
				sendRequest("BuyProduct", key)
			end, C.gold)
		end
	end
	header("Бусты")
	for _, key in ipairs(Config.ProductOrder) do
		local def = Config.Products[key]
		if def.luck then
			itemRow(def.title, "Больше редких существ для всех на сервере", "R$ " .. def.price, C.green, function()
				sendRequest("BuyProduct", key)
			end, Color3.fromRGB(120, 255, 120))
		end
	end
	header("Game Pass (навсегда)")
	for _, key in ipairs(Config.GamePassOrder) do
		local def = Config.GamePasses[key]
		local owned = player:GetAttribute("Pass_" .. key) == true
		itemRow(def.title, def.desc, owned and "Куплено" or ("R$ " .. def.price), owned and C.grey or C.pink, function()
			if not owned then
				sendRequest("BuyPass", key)
			end
		end)
	end
end

local function rebuild()
	if not currentPanel or not panel.Visible then
		return
	end
	local y = list.CanvasPosition
	clearList()
	order = 0
	builders[currentPanel]()
	list.CanvasPosition = y
end

local function openPanel(name)
	if not builders[name] then
		return
	end
	currentPanel = name
	panel.Visible = true
	list.CanvasPosition = Vector2.zero
	rebuild()
end

Remotes:WaitForChild("OpenPanel").OnClientEvent:Connect(openPanel)

-- кнопка доната слева
button({
	Parent = gui,
	AnchorPoint = Vector2.new(0, 0.5),
	Position = UDim2.new(0, 10, 0.5, 0),
	Size = UDim2.fromOffset(110, 46),
	BackgroundColor3 = C.pink,
	Text = "⭐ Магазин",
}, function()
	if panel.Visible and currentPanel == "Donate" then
		panel.Visible = false
	else
		openPanel("Donate")
	end
end)

-- обновлять окно при изменении данных
for _, attr in ipairs({ "Money", "SpeedLevel", "StaminaLevel", "Wing", "Creatures", "Income" }) do
	player:GetAttributeChangedSignal(attr):Connect(function()
		if attr == "Money" and currentPanel == "Donate" then
			return
		end
		rebuild()
	end)
end
for key in pairs(Config.GamePasses) do
	player:GetAttributeChangedSignal("Pass_" .. key):Connect(rebuild)
end

---------------------------------------------------------------------
-- обновление HUD
---------------------------------------------------------------------
local function formatTime(sec)
	sec = math.max(0, math.floor(sec))
	return string.format("%d:%02d", math.floor(sec / 60), sec % 60)
end

local acc = 0
RunService.RenderStepped:Connect(function(dt)
	moneyLabel.Text = Config.formatMoney(player:GetAttribute("Money") or 0)
	incomeLabel.Text = "+" .. Config.formatMoney(player:GetAttribute("Income") or 0) .. "/сек"

	local frac = player:GetAttribute("StaminaFrac") or 1
	staminaFill.Size = UDim2.fromScale(math.clamp(frac, 0, 1), 1)
	staminaFill.BackgroundColor3 = frac > 0.3 and Color3.fromRGB(90, 200, 255) or Color3.fromRGB(255, 90, 90)
	staminaText.Text = string.format("Стамина %.1f / %.1f", player:GetAttribute("StaminaValue") or 0, player:GetAttribute("StaminaMax") or 0)

	local carrying = player:GetAttribute("Carrying") or ""
	if carrying ~= "" and Config.Creatures[carrying] then
		carryLabel.Text = "Несёшь: " .. Config.Creatures[carrying].name .. " → лети на базу!"
	else
		carryLabel.Text = ""
	end

	acc = acc + dt
	if acc < 0.25 then
		return
	end
	acc = 0
	local t = workspace:GetServerTimeNow()
	if workspace:GetAttribute("DivinePresent") then
		divineLabel.Text = "✨ Божественный на Острове 7!"
	else
		local nextT = workspace:GetAttribute("DivineNextSpawn") or t
		divineLabel.Text = "✨ Божественный через " .. formatTime(nextT - t)
	end
	local luck = (workspace:GetAttribute("LuckUntil") or 0) - t
	luckLabel.Text = luck > 0 and ("🍀 Удача сервера " .. formatTime(luck)) or ""

	-- закрыть окно станции, если отошёл
	if panel.Visible and currentPanel and currentPanel ~= "Donate" then
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local map = workspace:FindFirstChild("Map")
		local station = map and map:FindFirstChild(currentPanel)
		local kiosk = station and station:FindFirstChild("Kiosk")
		if root and kiosk and (root.Position - kiosk.Position).Magnitude > 28 then
			panel.Visible = false
		end
	end
end)

-- подсказка при входе
task.delay(3, function()
	toast("Держи ПРОБЕЛ в прыжке, чтобы лететь!", "info")
	task.wait(1)
	toast("Хватай существ на островах и неси на базу", "info")
end)
]]></ProtectedString><bool name="Disabled">false</bool></Properties></Item></Item></Item></roblox>